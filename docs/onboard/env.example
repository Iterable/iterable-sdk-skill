# Copy to .env. .env is gitignored and must be mode 0600. Never commit real keys.
#
# You do NOT normally fill this in. bin/iterable-keys walks you through creating
# the keys at https://app.iterable.com/settings/apiKeys and writes them here with
# echo off (gate G10 then proves they work).
#
# Fill them in only if you already have keys and would rather the tool reuse them
# than have you mint new ones. A pre-filled value is always preferred.
#
# These names are what bin/config.sh reads. A key under any other name is a key
# the tool cannot see, and G10 will report "no key" while your file looks full.

# Server-side key: reads user profiles, sends the proof push, reads events.
ITBL_SERVER_KEY=

# Mobile key: registers the device token. Not interchangeable with the above —
# each endpoint accepts exactly one type, and the wrong one answers 401.
ITBL_MOBILE_KEY=

# The test identity the proof push is sent to, and the profile G15 looks up. It
# must be the same identity the app calls setEmail() with, or G15 reads "no user
# yet" about a user who was never meant to exist.
ITBL_EMAIL=

# EDC projects answer on https://api.eu.iterable.com. A key from one data centre
# returns 401 against the other, which reads exactly like a bad key.
ITBL_BASE=https://api.iterable.com

# Optional. Set it to send the proof through a campaign, which is the only way
# G17 can corroborate the arrival server-side: a plain proof send raises no
# pushSend event at all.
ITBL_CAMPAIGN_ID=

# Not supported yet: a JWT-enabled mobile key. The tool recognises one — it names
# the failure instead of guessing — but cannot sign for it. Use a non-JWT key to
# get push working, then switch.

{
  "name": "iterable-sdk-skill-pipeline",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "refresh:docs": "tsx src/refresh.ts",
    "set:source-ref": "tsx src/set-source-ref.ts",
    "detect:corpus-changes": "tsx src/detect-corpus-changes.ts",
    "validate:reference": "tsx src/validate-reference.ts",
    "validate:plugins": "tsx src/validate-plugins.ts",
    "enrich:summary": "tsx src/enrich-summary.ts",
    "eval:prompts": "tsx src/eval-run.ts prompts",
    "eval:run": "tsx src/eval-run.ts run",
    "eval:report": "tsx src/eval-report.ts",
    "typecheck": "tsc --noEmit",
    "check:all": "pnpm typecheck && pnpm validate:reference && pnpm validate:plugins"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "yaml": "^2.5.0"
  }
}

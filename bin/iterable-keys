#!/usr/bin/env bash
# Walks the Iterable dashboard steps that have no API, and captures what they
# produce. The three creation steps genuinely cannot be automated: Iterable's
# public API has no endpoint for creating an API key, creating a mobile app, or
# configuring a push integration (checked against all 131 paths in
# https://api.iterable.com/api-docs).
#
# So you click, and this proves the result. Keys are read with the terminal echo
# off, written only to the workspace .env, mode 0600, and never printed back.

source "$(dirname "${BASH_SOURCE[0]}")/config.sh"

# The four steps, written once. Both front ends print exactly these — a second copy
# of dashboard navigation is a second thing to get out of date, and the wrong FCM
# type is the most expensive mistake in the whole flow.
step_keys() {
  cat <<EOF

  $(bold "Step 1 of 4 — create two API keys")

    Open  $(bold "https://app.iterable.com/settings/apiKeys")
    Click $(bold "New API Key") twice:

      · one $(bold "Server-side") key   — this tool uses it only to read back what you set up
      · one $(bold "Mobile") key        — the key your app ships with

    Leave $(bold "Require JWT authentication") OFF on the mobile key for now.
    Iterable's own integration checklist recommends starting without JWT so an
    SDK problem and a JWT problem can't be mistaken for each other. Switch to a
    JWT-enabled key once push is working.

    A key is shown once. If you lose it, make another — they are cheap.

EOF
}

step_mobile_app() {
  cat <<EOF

  $(bold "Step 2 of 4 — create the mobile app")

    Open  $(bold "https://app.iterable.com/integrations/mobileApps/create")

    (or navigate: $(bold "Settings > Apps and Websites") → $(bold "Add a new app or website"))

      · Platform      $(bold "Android")
      · Package name  $(bold "${PACKAGE:-<your package name>}")

    The package name must match exactly — Iterable matches your device tokens
    against it, and a mismatch fails silently much later.

EOF
}

# The one path here that stays absolute: it goes into a browser file-upload dialog,
# where a workspace-relative path is no use — the Finder sheet wants the whole thing.
step_push_integration() {
  cat <<EOF

  $(bold "Step 3 of 4 — configure the Firebase push integration")

    Same page: open the app you just made, find the $(bold "Push") section, and click
    $(bold "Configure") on the Firebase row.

      · FCM type   $(bold "Data notifications")   ← not "Notification messages"
      · Upload     $(bold "$SA_KEY")

    $(bold "Data notifications") is the one that matters. With "Notification messages"
    the Firebase SDK swallows the push and Iterable's SDK never sees it, so
    everything looks configured and no push ever arrives. This is the single
    most common way this integration fails.

EOF
}

step_identity() {
  cat <<EOF

  $(bold "Step 4 of 4 — the test identity")

    Not any address: this has to be the one your app signs in with — the value
    it passes to $(bold "IterableApi.getInstance().setEmail()"). It is the join key
    between the app and Iterable, and if the two disagree, the token is filed
    under one identity while the proof push is sent to the other. That reads
    exactly like a broken integration and is not one.

    If the app doesn't sign anyone in yet, pick something disposable here and
    make the app use the same value — it becomes a real user profile in this
    Iterable project, so not a customer's address.

EOF
}

# Where the values go, printed with the step that produces them. A destination
# named in a block at the end is a destination nobody reads until after they have
# already pasted the key somewhere else — and on the agent path there is no end to
# put it at, because the steps are handed over one at a time.
where_keys() {
  cat <<EOF
  $(bold "Where the two keys go") — not into a chat window, a log, or an argument list:

      $(wsd "$TEMPLATE")      (mode 0600, ignored by git)

    Put the server-side key on $(bold ITBL_SERVER_KEY) and the mobile one on
    $(bold ITBL_MOBILE_KEY), then rename the file to $(bold "$(basename "$ITBL_ENV")").
    Nothing reads it until then, which is the point: a half-filled .env looks
    exactly like a wrong key.

EOF
}

where_identity() {
  cat <<EOF
  Put that address on $(bold ITBL_EMAIL) in the same file:

      $(wsd "$TEMPLATE")

EOF
}

# The identity the app registered, if the device can tell us — scoped to the chosen
# package, because another app's identity offered as this one's is worse than no
# suggestion at all.
offer_identity() {
  local seen; seen="$(app_identity | head -3)"
  [[ -n "$seen" ]] || return 0
  echo "    ${PACKAGE:-The app} has already registered as:"
  printf '      %s\n' $seen
  echo
}

# Creates the 0600 template, and never writes over one that already holds a value:
# re-reading the steps is normal, and a key is shown once. Returns 1 if it left an
# existing file alone, so the caller can say so in its own words.
ensure_template() {
  ws_init
  if grep -qE '^ITBL_[A-Z_]+=.+' "$TEMPLATE" 2>/dev/null; then
    return 1
  fi
  ( umask 077 && cat > "$TEMPLATE" <<'EOF'
# Fill in the values, then rename this file to .env — or export the same names in
# your shell, which wins over the file. Mode 0600; never committed, never logged.
ITBL_SERVER_KEY=
ITBL_MOBILE_KEY=
ITBL_EMAIL=
# EU (EDC) projects only:
# ITBL_BASE=https://api.eu.iterable.com
EOF
  )
  chmod 600 "$TEMPLATE"
}

TEMPLATE="$WS/.env.template"

# ITBL_INTRO_SHOWN is set by a caller that has already said all this and asked whether to
# go on — the wizard has to explain part 2 *before* offering the choice, and hearing it
# again immediately afterwards reads as two different pieces of work.
banner() {
  [[ "${ITBL_INTRO_SHOWN:-0}" == 1 ]] && return 0
  part 2 "Iterable"
  echo
  echo "  Four things here have to be done by hand — Iterable has no API for any of"
  echo "  them, so there is nothing to automate. Everything they produce gets proved"
  echo "  by a real API call afterwards, so a wrong one surfaces in seconds, not days."
  echo
}

# One step at a time, because that is how somebody clicking through a dashboard
# experiences it. Four screens of instructions handed over at once is a document;
# a developer who is on step 2 wants step 2.
if [[ "${1:-}" == "--step" ]]; then
  ensure_template || true
  STEP_N="${2:-}"
  case "$STEP_N" in
    1) banner ;;
    2|3|4) ;;
    *) echo "usage: $(cmd_path iterable-keys) --step 1|2|3|4" >&2; exit 30 ;;
  esac
  # Every step says where it is, not just the first: somebody who arrives at step 3 by
  # following the one before it has no other way of knowing how much is left. In the
  # heading rather than on a line of its own, so the inline walk gets it too.
  case "$STEP_N" in
    1) step_keys; where_keys ;;
    2) step_mobile_app ;;
    3) step_push_integration ;;
    4) step_identity; offer_identity; where_identity ;;
  esac
  # A walk has to name its own next step. Only the fourth knew it had a successor, so a
  # developer handed step 1 — which is exactly what the pending ending hands them — did
  # that one step and hit a dead end, with nothing on screen saying three more existed.
  # It reads as a one-step job that silently failed.
  if ((STEP_N < 4)); then
    echo "  When that is done:"
    echo
    run_line iterable-keys --step $((STEP_N + 1))
    echo
  else
    cat <<EOF
    Then re-run the ladder: both keys get spent on a real call, and the test user
    is looked up by name, so nothing here is taken on trust.

EOF
    run_line onboard
    echo
  fi
  exit 0
fi

# Without a terminal this cannot prompt for a secret, and it must not try: the
# scripted path is the one an agent drives, and an agent must never be the thing
# that handles the key. So it prints the same four steps, leaves a 0600 file with
# the names and no values, and stops. The developer fills it in; the gates then
# prove the keys by spending them, which is the only part that needs to read them.
if ! interactive || [[ "${1:-}" == "--steps" ]]; then
  if ! ensure_template; then
    echo
    echo "  $(wsd "$TEMPLATE") already has values — left untouched."
    echo "  Rename it to $(basename "$ITBL_ENV"), then:"
    echo
    run_line gates
    exit 10
  fi
  banner
  step_keys
  where_keys
  step_mobile_app
  step_push_integration
  step_identity
  offer_identity
  where_identity
  exit 10
fi

ask_yn()  { local a; read -r -p "  $1 [y/N] " a; [[ "$a" == [yY]* ]]; }
# Echo off, and the value never goes to stdout, a log, or the shell history.
ask_secret() {
  local v; read -r -s -p "  $1: " v < /dev/tty; echo >&2
  printf '%s' "$v"
}
pause_enter() { read -r -p "  Press enter when that's done. " _ < /dev/tty; }

banner

# ------------------------------------------------------------------ data centre
if ask_yn "Is this an EU (EDC-based) Iterable project?"; then
  ITBL_BASE=https://api.eu.iterable.com
  save_env ITBL_BASE "$ITBL_BASE"
else
  save_env ITBL_BASE ""    # fall back to the default rather than pinning it
  ITBL_BASE=https://api.iterable.com
fi
echo "  $(green ✓) API base: $ITBL_BASE"

# -------------------------------------------------------------- 1 & 2: the keys
step_keys
pause_enter

SERVER="$(ask_secret "Paste the Server-side key")"
[[ -n "$SERVER" ]] || { echo "  Nothing pasted."; exit 10; }
MOBILE="$(ask_secret "Paste the Mobile key")"
[[ -n "$MOBILE" ]] || { echo "  Nothing pasted."; exit 10; }

save_env ITBL_SERVER_KEY "$SERVER"
save_env ITBL_MOBILE_KEY "$MOBILE"
echo "  $(green ✓) both keys stored in $(wsp .env) (mode 0600), not printed anywhere"

# --------------------------------------------------------- 3: the mobile app
step_mobile_app
pause_enter

# ------------------------------------------------- 4: the push integration
step_push_integration
pause_enter

# ----------------------------------------------------------- the test user
step_identity
# The device already knows, if the app has run: the SDK logs the identity in the
# body of its own registerDeviceToken call. Offered as a default rather than used
# silently — it is still the developer's choice which user the proof goes to.
SEEN="$(app_identity | head -3)"
if [[ -n "$SEEN" ]]; then
  echo "  The app on the device registered:"
  printf '    %s\n' $SEEN
  echo
  DEFAULT="$(printf '%s\n' "$SEEN" | head -1)"
  read -r -p "  Email the app signs in as [$DEFAULT]: " EMAIL < /dev/tty
  EMAIL="${EMAIL:-$DEFAULT}"
else
  read -r -p "  Email the app signs in as: " EMAIL < /dev/tty
fi
[[ -n "$EMAIL" ]] || { echo "  No email given."; exit 10; }
save_env ITBL_EMAIL "$EMAIL"
echo "  $(green ✓) test user: $EMAIL"

echo
echo "  $(bold "Now proving it.")"
echo
exec "$(dirname "${BASH_SOURCE[0]}")/gates"

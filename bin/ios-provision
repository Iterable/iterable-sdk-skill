#!/usr/bin/env bash

set -uo pipefail

BIN="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
TOOL_ROOT="$(cd "$BIN/.." && pwd)"
source "$BIN/ios-simulator.sh"
FASTLANE_VERSION="2.240.1"
PRIVATE_APNS_ACTOR="$TOOL_ROOT/tools/ios-apns-private.rb"

usage() {
  cat <<'EOF'
Usage:
  ios-provision status [--offline] [--bundle-id ID] [--workspace PATH]
  ios-provision question --kind KIND [--workspace PATH]
  ios-provision answer [--field FIELD --value VALUE [--add] | --clear] [--workspace PATH]
  ios-provision record-scope [--from-answers | --features LIST --identity-mode MODE --region US|EU --jwt-enabled true|false] --confirm [--workspace PATH]
  ios-provision record-iterable-setup --driver guided|developer --confirm [--workspace PATH]
  ios-provision record-target --bundle-id ID --name NAME --confirm [--workspace PATH]
  ios-provision record-apple-setup --strategy existing-ready|guided-manual|team-key --confirm [--workspace PATH]
  ios-provision record-asc-key [--file AuthKey_KEYID.p8 [--key-id ID]] [--issuer-id UUID] [--clear] --confirm [--workspace PATH]
  ios-provision asc-read [--workspace PATH]
  ios-provision asc-apply --confirm [--workspace PATH]
  ios-provision clear-apple-setup --confirm [--workspace PATH]
  ios-provision record-apple-readiness --strategy existing-ready|guided-manual --confirm [--workspace PATH]
  ios-provision record-apple-step --step start|app-id|push|apns-key --confirm [--workspace PATH]
  ios-provision record-iterable-app --bundle-id ID --source created|existing --confirm [--workspace PATH]
  ios-provision record-iterable-push --bundle-id ID --confirm [--workspace PATH]
  ios-provision import-apns --file AuthKey_KEYID.p8 [--key-id ID] [--team-id ID] [--replace] --confirm [--workspace PATH]
  ios-provision validate-apns [--workspace PATH]
  ios-provision capture-mobile --region US|EU --jwt-enabled true|false [--replace] --confirm [--workspace PATH]
  ios-provision validate-mobile [--workspace PATH]
  ios-provision capture-server [--replace] --confirm [--workspace PATH]
  ios-provision validate-server [--workspace PATH]
  ios-provision proof-status [--workspace PATH]
  ios-provision proof-answer [--field FIELD --value VALUE | --clear] [--workspace PATH]
  ios-provision record-proof --proof-mode behavioral|instrumented
    --bundle-id ID --identity-type email|user-id --identity VALUE
    [--switch-identity VALUE] [--device ID] [--app-path App.app]
    [--environment development|production]
    [--tap-expect TEXT] [--logout-expect TEXT]
    [--profile-field NAME ...] [--event NAME ...] --confirm [--workspace PATH]
  ios-provision record-proof --from-answers --confirm [--workspace PATH]
  ios-provision restart-proof --confirm [--workspace PATH]
  ios-provision experimental-apns-install --experimental --confirm [--workspace PATH]
  ios-provision experimental-apns-auth --experimental --apple-id EMAIL --team-id ID [--workspace PATH]
  ios-provision experimental-apns-plan --experimental --confirm-read --apple-id EMAIL --team-id ID --name NAME [--workspace PATH]
  ios-provision experimental-apns-create --experimental --confirm --apple-id EMAIL --team-id ID --name NAME --output-dir PATH [--workspace PATH]

status and question are read-only and make no Apple or Iterable request.
question --kind help_* renders a guide for a step the developer is stuck on;
its options record the answer or return to status.
answer persists proposed selector answers;
record-scope confirms the developer's selected features, identity mode, region,
and JWT policy before application code changes.
record-iterable-setup records whether the coding agent will guide the
developer through the Iterable dashboard step or the developer will finish it
in their own terminal. Neither path operates the browser.
record-target stores the exact application target used by every Apple,
Iterable, install, and verification step. record-iterable-app records whether
the matching dashboard app was created or already existed. record-iterable-push
records its APNs credential step. Neither dashboard record has public
read-back or counts as delivery proof.
record-apple-setup selects whether this app reuses an existing Apple setup,
uses an Account Holder or Admin guided manual handoff, or uses an App Store
Connect Team API key. record-apple-step walks the guided handoff one Apple
Developer step at a time: App ID, Push Notifications, APNs key; those answers
are developer-confirmed. With a Team key, record-asc-key records the key path
and Issuer ID, asc-read reads the App ID and its capabilities, and
asc-apply --confirm makes only the shown changes and reads them back.
import-apns validates the EC P-256 private-key shape and
records the path to developer-identified APNs material; it does not copy,
create, or revoke Apple credentials. validate-apns signs a provider token with
it and sends one probe to a random device token in the APNs sandbox:
BadDeviceToken proves the key, Key ID, and Team ID, not the App ID.
capture-mobile moves a copied Iterable Mobile API key from the clipboard into
the ignored iOS workspace without printing it. It also writes an ignored
IterableSecrets.xcconfig that the app can include directly.
validate-mobile proves the captured value authenticates as a Mobile key in the
recorded region, using an empty request and a deliberately invalid control.
capture-server and validate-server prepare a separate Iterable verification
credential for independent reads and announced proof sends. The Server-side
key is never linked into the app. Standard record-proof reuses the existing app
identity and installed bundle, records the device and environment, and
generates one non-secret targeted marker. Instrumented proof additionally
requires fresh User A/User B identities, an exact evaluation artifact, remote
expectations, and a second marker. Neither mode asserts that an outcome
happened. restart-proof preserves standard identity/device choices while
rotating run-scoped state; instrumented restart also creates fresh identities
and baselines.

experimental-apns-* is an explicit opt-in path that pins Fastlane Spaceship and
uses unsupported Apple web-session endpoints. It never revokes existing keys,
and create performs one non-retried creation followed by the one-time download.
EOF
}

die() {
  printf 'error: %s\n' "$*" >&2
  exit 2
}

jstr() {
  local value="$1"
  # Bash pattern substitution is quadratic; long strings are cheaper in node.
  if ((${#value} > 1024)); then
    node -e 'process.stdout.write(JSON.stringify(process.argv[1]))' -- "$1"
    return
  fi
  value="${value//\\/\\\\}"
  value="${value//\"/\\\"}"
  value="${value//$'\n'/\\n}"
  value="${value//$'\t'/\\t}"
  value="${value//$'\r'/\\r}"
  if jstr_needs_node "$value" "$1"; then
    node -e 'process.stdout.write(JSON.stringify(process.argv[1]))' -- "$1"
    return
  fi
  printf '"%s"' "$value"
}

# Byte-level checks need the C locale; local scopes it to this function.
jstr_needs_node() {
  local LC_ALL=C
  [[ "$1" =~ [[:cntrl:]] ]] && return 0
  [[ "$2" == *[$'\x80'-$'\xff']* ]] || return 1
  ! printf '%s' "$2" | iconv -f UTF-8 -t UTF-8 >/dev/null 2>&1
}

valid_bundle_id() {
  [[ "$1" =~ ^[A-Za-z0-9-]+(\.[A-Za-z0-9-]+)+$ ]] &&
    [[ "$1" != *..* ]] &&
    [[ "$1" != *\** ]]
}

valid_apple_id() {
  [[ "$1" =~ ^[A-Z0-9]{10}$ ]]
}

file_mode() {
  stat -f '%Lp' "$1" 2>/dev/null || stat -c '%a' "$1" 2>/dev/null
}

looks_like_ios_project() {
  local candidate="$1"
  [[ -f "$candidate/project.yml" ]] ||
    compgen -G "$candidate/*.xcodeproj/project.pbxproj" >/dev/null ||
    compgen -G "$candidate/*.xcworkspace" >/dev/null
}

verification_project_root() {
  local root workspace_root=""
  if [[ -n "${IOS_WORKSPACE:-}" ]]; then
    workspace_root="$(cd "$IOS_WORKSPACE/../.." 2>/dev/null && pwd || true)"
    if [[ -n "$workspace_root" ]] && looks_like_ios_project "$workspace_root"; then
      printf '%s' "$workspace_root"
      return
    fi
  fi
  root="$(git rev-parse --show-toplevel 2>/dev/null)" || root="$PWD"
  if [[ "$root" == "$TOOL_ROOT" && "$PWD" != "$TOOL_ROOT" ]] &&
      looks_like_ios_project "$PWD"; then
    root="$PWD"
  fi
  printf '%s' "$root"
}

verification_source_files() {
  local root="$1"
  find "$root" \
    \( -path '*/.git' -o -path '*/.iterable' -o -path '*/.derived-data' \
       -o -path '*/DerivedData' -o -path '*/Pods' -o -path '*/.build' \
       -o -path '*/*Tests' -o -path '*/*Tests/*' \
       -o -path '*/*UITests' -o -path '*/*UITests/*' \) \
    -prune -o \
    \( -name '*.swift' -o -name 'project.yml' -o -name 'project.pbxproj' \
       -o -name '*.xcconfig' -o -name '*.entitlements' -o -name 'Info.plist' \) \
    -type f -print 2>/dev/null
}

verification_detect_bundle() {
  local root="$1" values="" project value=""
  if [[ -f "$root/project.yml" ]]; then
    values="$(
      sed -nE 's/^[[:space:]]*PRODUCT_BUNDLE_IDENTIFIER:[[:space:]]*"?([^"#[:space:]]+)"?.*/\1/p' \
        "$root/project.yml"
    )"
  fi
  if [[ -z "$values" ]]; then
    project="$(find "$root" -path '*/.git' -prune -o \
      -name project.pbxproj -type f -print 2>/dev/null | head -1)"
    if [[ -n "$project" ]]; then
      values="$(
        sed -nE 's/.*PRODUCT_BUNDLE_IDENTIFIER = "?([^";[:space:]]+)"?;.*/\1/p' \
          "$project"
      )"
    fi
  fi
  value="$(printf '%s\n' "$values" |
    sed '/^[[:space:]]*$/d' |
    grep -Eiv '([.]tests?|[.]uitests?)$' |
    sort -u |
    awk 'NR==1{value=$0} NR>1{multiple=1} END{if(!multiple) print value}')"
  valid_bundle_id "$value" && printf '%s' "$value"
}

app_project_root() {
  local candidate workspace_root=""
  if [[ -n "${WORKSPACE:-}" ]]; then
    workspace_root="$(cd "$WORKSPACE/../.." 2>/dev/null && pwd || true)"
    if [[ -n "$workspace_root" ]] && looks_like_ios_project "$workspace_root"; then
      printf '%s' "$workspace_root"
      return
    fi
  fi
  if [[ "$PWD" != "$TOOL_ROOT" ]] && looks_like_ios_project "$PWD"; then
    printf '%s' "$PWD"
    return
  fi
  candidate="$(git rev-parse --show-toplevel 2>/dev/null)" || return 1
  [[ "$candidate" != "$TOOL_ROOT" ]] && looks_like_ios_project "$candidate" ||
    return 1
  printf '%s' "$candidate"
}

DETECTED_TARGET=""

# Sets DETECTED_TARGET once per run; xcodebuild is too slow to call per field.
load_detected_target() {
  [[ -z "$DETECTED_TARGET" ]] || return 0
  local root settings="" static_bundle="" static_name="" static_team="" teams
  local -a projects=()
  root="$(app_project_root)" || root=""
  if [[ -n "$root" ]]; then
    shopt -s nullglob
    projects=("$root"/*.xcodeproj)
    shopt -u nullglob
    if ((${#projects[@]} == 1)) && command -v xcodebuild >/dev/null 2>&1; then
      settings="$(cd "$root" && perl -e 'alarm shift; exec @ARGV' 90 \
        xcodebuild -project "${projects[0]}" -alltargets -showBuildSettings \
          -json -disableAutomaticPackageResolution 2>/dev/null)" || settings=""
    fi
    static_bundle="$(verification_detect_bundle "$root")"
    if [[ -f "$root/project.yml" ]]; then
      static_name="$(sed -nE 's/^name:[[:space:]]*"?([^"#]*[^"#[:space:]])"?.*/\1/p' \
        "$root/project.yml" | head -1)"
      teams="$(sed -nE 's/^[[:space:]]*DEVELOPMENT_TEAM:[[:space:]]*"?([A-Z0-9]{10})"?.*/\1/p' \
        "$root/project.yml" | sort -u)"
    elif ((${#projects[@]} == 1)); then
      static_name="$(basename "${projects[0]}" .xcodeproj)"
      teams="$(sed -nE 's/.*DEVELOPMENT_TEAM = "?([A-Z0-9]{10})"?;.*/\1/p' \
        "${projects[0]}/project.pbxproj" 2>/dev/null | sort -u)"
    fi
    [[ -n "${teams:-}" && "$teams" != *$'\n'* ]] && static_team="$teams"
  fi
  DETECTED_TARGET="$(node -e '
    const [raw, staticBundle, staticName, staticTeam] = process.argv.slice(1);
    const bundleOk = id => /^[A-Za-z0-9-]+(\.[A-Za-z0-9-]+)+$/.test(id) && !id.includes("..");
    const nameOk = name => typeof name === "string" && name.trim() !== "" && !name.includes("$(");
    const teamOk = team => /^[A-Z0-9]{10}$/.test(team || "");
    const candidates = [];
    let source = "";
    try {
      const seen = new Set();
      for (const entry of JSON.parse(raw)) {
        const b = entry.buildSettings || {};
        if (b.PRODUCT_TYPE !== "com.apple.product-type.application") continue;
        const platform = String(b.PLATFORM_NAME || "").toLowerCase();
        if (platform && !platform.includes("iphone")) continue;
        const key = String(entry.target || b.TARGET_NAME || "");
        if (seen.has(key)) continue;
        seen.add(key);
        candidates.push({
          target: key,
          bundle_id: String(b.PRODUCT_BUNDLE_IDENTIFIER || ""),
          name: nameOk(b.PRODUCT_NAME) ? String(b.PRODUCT_NAME) : "",
          team_id: teamOk(b.DEVELOPMENT_TEAM) ? b.DEVELOPMENT_TEAM : ""
        });
      }
      if (candidates.length) source = "xcodebuild";
    } catch {}
    if (!candidates.length && bundleOk(staticBundle)) {
      source = "project";
      candidates.push({
        target: "",
        bundle_id: staticBundle,
        name: nameOk(staticName) ? staticName : "",
        team_id: teamOk(staticTeam) ? staticTeam : ""
      });
    }
    const only = candidates.length === 1 && bundleOk(candidates[0].bundle_id)
      ? candidates[0] : null;
    process.stdout.write(JSON.stringify({
      source,
      bundle_id: only ? only.bundle_id : "",
      name: only ? only.name : "",
      team_id: only ? only.team_id : "",
      target: only ? only.target : "",
      candidates
    }));
  ' "$settings" "$static_bundle" "$static_name" "$static_team")"
  [[ -n "$DETECTED_TARGET" ]] || DETECTED_TARGET='{"source":"","bundle_id":"","name":"","team_id":"","target":"","candidates":[]}'
}

detected_field() {
  node -e '
    const value = JSON.parse(process.argv[1]);
    const bundle = process.argv[3];
    const match = bundle
      ? (value.candidates || []).find(item => item.bundle_id === bundle) || {}
      : value;
    process.stdout.write(String(match[process.argv[2]] || ""));
  ' "$DETECTED_TARGET" "$1" "${2:-}"
}

verification_detect_identity() {
  local root="$1" files email=false user_id=false file
  files="$(verification_source_files "$root")"
  while IFS= read -r file; do
    [[ -f "$file" ]] || continue
    grep -Eq '^[[:space:]]*(IterableAPI[.]email[[:space:]]*=|IterableAPI[.]setEmail|setEmail[[:space:]]*[(])' \
      "$file" 2>/dev/null && email=true
    grep -Eq '^[[:space:]]*(IterableAPI[.]userId[[:space:]]*=|IterableAPI[.]setUserId|setUserId[[:space:]]*[(])' \
      "$file" 2>/dev/null && user_id=true
  done <<< "$files"
  if [[ "$email" == true && "$user_id" != true ]]; then
    printf email
  elif [[ "$user_id" == true && "$email" != true ]]; then
    printf user-id
  fi
}

verification_detect_features() {
  local root="$1" files file push=false profiles=false events=false
  files="$(verification_source_files "$root")"
  while IFS= read -r file; do
    [[ -f "$file" ]] || continue
    grep -Eq '^[[:space:]]*([^/].*)?(registerForRemoteNotifications|didRegisterForRemoteNotifications|IterableAPI[.]register)' \
      "$file" 2>/dev/null && push=true
    grep -Eq 'aps-environment|com[.]apple[.]Push|Push Notifications' \
      "$file" 2>/dev/null && push=true
    grep -Eq 'updateUser|updateEmail|updateSubscriptions' "$file" 2>/dev/null &&
      profiles=true
    grep -Eq 'IterableAPI[.]track|track[[:space:]]*[(][[:space:]]*event:' \
      "$file" 2>/dev/null && events=true
  done <<< "$files"
  node -e '
    const out=["sdk-initialization"];
    if (process.argv[1]==="true") out.push("push-notifications");
    if (process.argv[2]==="true") out.push("user-profiles");
    if (process.argv[3]==="true") out.push("event-tracking");
    process.stdout.write(JSON.stringify(out.sort()));
  ' "$push" "$profiles" "$events"
}

verification_detect_jwt() {
  local root="$1" files file
  files="$(verification_source_files "$root")"
  while IFS= read -r file; do
    [[ -f "$file" ]] || continue
    if grep -Eq 'authDelegate|IterableAuthDelegate|onAuthSuccess|onAuthFailure' \
        "$file" 2>/dev/null; then
      printf true
      return
    fi
  done <<< "$files"
  printf false
}

resolve_workspace() {
  if [[ -n "${IOS_WORKSPACE:-}" ]]; then
    printf '%s' "$IOS_WORKSPACE"
    return
  fi
  local project_root
  project_root="$(git rev-parse --show-toplevel 2>/dev/null)" || project_root="$PWD"
  if [[ "$project_root" == "$TOOL_ROOT" && -z "${IOS_ALLOW_TOOL_ROOT:-}" ]]; then
    if [[ "$PWD" != "$TOOL_ROOT" ]] && looks_like_ios_project "$PWD"; then
      project_root="$PWD"
    else
      cat >&2 <<EOF
Run this from the iOS app being integrated, not from the skill repository.

  cd /path/to/your-ios-app
  $BIN/ios-provision status --bundle-id com.example.app

The local credential workspace belongs in that app as .iterable/ios/.
Tests may set IOS_WORKSPACE or IOS_ALLOW_TOOL_ROOT deliberately.
EOF
      return 30
    fi
  fi
  printf '%s/.iterable/ios' "$project_root"
}

init_workspace() {
  mkdir -p "$WORKSPACE/artifacts"
  [[ -f "$WORKSPACE/.gitignore" ]] || printf '*\n' > "$WORKSPACE/.gitignore"
}

read_args() {
  COMMAND="${1:-status}"
  shift || true

  BUNDLE_ID="${IOS_BUNDLE_ID:-}"
  APP_NAME="${IOS_APP_NAME:-}"
  APP_NAME_EXPLICIT=false
  [[ -n "${IOS_APP_NAME:-}" ]] && APP_NAME_EXPLICIT=true
  WORKSPACE_OVERRIDE=""
  CONFIRM=false
  REPLACE=false
  OFFLINE=false
  APNS_SOURCE=""
  APNS_KEY_ID=""
  APPLE_TEAM_ID=""
  DATA_REGION=""
  JWT_ENABLED=""
  FEATURES=""
  IDENTITY_MODE=""
  ITERABLE_DRIVER=""
  ITERABLE_APP_SOURCE=""
  APPLE_STRATEGY=""
  APPLE_STEP=""
  ASC_ISSUER_ID=""
  QUESTION_KIND=""
  ANSWER_FIELD=""
  ANSWER_VALUE=""
  ANSWER_ADD=false
  ANSWER_CLEAR=false
  FROM_ANSWERS=false
  PROOF_IDENTITY_TYPE=""
  PROOF_MODE=""
  PROOF_IDENTITY=""
  PROOF_SWITCH_IDENTITY=""
  PROOF_DEVICE=""
  PROOF_APP_PATH=""
  PROOF_ENVIRONMENT="development"
  PROOF_TAP_EXPECT=""
  PROOF_LOGOUT_EXPECT=""
  PROOF_PROFILE_FIELDS=()
  PROOF_EVENTS=()
  APPLE_ID=""
  OUTPUT_DIR=""
  EXPERIMENTAL=false
  CONFIRM_READ=false
  RESTART_PROOF=false

  while (($#)); do
    case "$1" in
      --bundle-id)
        (($# >= 2)) || die "--bundle-id needs a value"
        BUNDLE_ID="$2"
        shift 2
        ;;
      --bundle-id=*)
        BUNDLE_ID="${1#*=}"
        shift
        ;;
      --name)
        (($# >= 2)) || die "--name needs a value"
        APP_NAME="$2"
        APP_NAME_EXPLICIT=true
        shift 2
        ;;
      --name=*)
        APP_NAME="${1#*=}"
        APP_NAME_EXPLICIT=true
        shift
        ;;
      --workspace)
        (($# >= 2)) || die "--workspace needs a value"
        WORKSPACE_OVERRIDE="$2"
        shift 2
        ;;
      --workspace=*)
        WORKSPACE_OVERRIDE="${1#*=}"
        shift
        ;;
      --file)
        (($# >= 2)) || die "--file needs a value"
        APNS_SOURCE="$2"
        shift 2
        ;;
      --file=*)
        APNS_SOURCE="${1#*=}"
        shift
        ;;
      --key-id)
        (($# >= 2)) || die "--key-id needs a value"
        APNS_KEY_ID="$2"
        shift 2
        ;;
      --key-id=*)
        APNS_KEY_ID="${1#*=}"
        shift
        ;;
      --team-id)
        (($# >= 2)) || die "--team-id needs a value"
        APPLE_TEAM_ID="$2"
        shift 2
        ;;
      --team-id=*)
        APPLE_TEAM_ID="${1#*=}"
        shift
        ;;
      --region)
        (($# >= 2)) || die "--region needs a value"
        DATA_REGION="$2"
        shift 2
        ;;
      --region=*)
        DATA_REGION="${1#*=}"
        shift
        ;;
      --jwt-enabled)
        (($# >= 2)) || die "--jwt-enabled needs a value"
        JWT_ENABLED="$2"
        shift 2
        ;;
      --jwt-enabled=*)
        JWT_ENABLED="${1#*=}"
        shift
        ;;
      --features)
        (($# >= 2)) || die "--features needs a comma-separated value"
        FEATURES="$2"
        shift 2
        ;;
      --features=*)
        FEATURES="${1#*=}"
        shift
        ;;
      --identity-mode)
        (($# >= 2)) || die "--identity-mode needs a value"
        IDENTITY_MODE="$2"
        shift 2
        ;;
      --identity-mode=*)
        IDENTITY_MODE="${1#*=}"
        shift
        ;;
      --driver)
        (($# >= 2)) || die "--driver needs a value"
        ITERABLE_DRIVER="$2"
        shift 2
        ;;
      --driver=*)
        ITERABLE_DRIVER="${1#*=}"
        shift
        ;;
      --source)
        (($# >= 2)) || die "--source needs a value"
        ITERABLE_APP_SOURCE="$2"
        shift 2
        ;;
      --source=*)
        ITERABLE_APP_SOURCE="${1#*=}"
        shift
        ;;
      --issuer-id)
        (($# >= 2)) || die "--issuer-id needs a value"
        ASC_ISSUER_ID="$2"
        shift 2
        ;;
      --issuer-id=*)
        ASC_ISSUER_ID="${1#*=}"
        shift
        ;;
      --step)
        (($# >= 2)) || die "--step needs a value"
        APPLE_STEP="$2"
        shift 2
        ;;
      --step=*)
        APPLE_STEP="${1#*=}"
        shift
        ;;
      --strategy)
        (($# >= 2)) || die "--strategy needs a value"
        APPLE_STRATEGY="$2"
        shift 2
        ;;
      --strategy=*)
        APPLE_STRATEGY="${1#*=}"
        shift
        ;;
      --kind)
        (($# >= 2)) || die "--kind needs a value"
        QUESTION_KIND="$2"
        shift 2
        ;;
      --kind=*)
        QUESTION_KIND="${1#*=}"
        shift
        ;;
      --field)
        (($# >= 2)) || die "--field needs a value"
        ANSWER_FIELD="$2"
        shift 2
        ;;
      --field=*)
        ANSWER_FIELD="${1#*=}"
        shift
        ;;
      --value)
        (($# >= 2)) || die "--value needs a value"
        ANSWER_VALUE="$2"
        shift 2
        ;;
      --value=*)
        ANSWER_VALUE="${1#*=}"
        shift
        ;;
      --add)
        ANSWER_ADD=true
        shift
        ;;
      --clear)
        ANSWER_CLEAR=true
        shift
        ;;
      --from-answers)
        FROM_ANSWERS=true
        shift
        ;;
      --identity-type)
        (($# >= 2)) || die "--identity-type needs a value"
        PROOF_IDENTITY_TYPE="$2"
        shift 2
        ;;
      --identity-type=*)
        PROOF_IDENTITY_TYPE="${1#*=}"
        shift
        ;;
      --proof-mode)
        (($# >= 2)) || die "--proof-mode needs a value"
        PROOF_MODE="$2"
        shift 2
        ;;
      --proof-mode=*)
        PROOF_MODE="${1#*=}"
        shift
        ;;
      --identity)
        (($# >= 2)) || die "--identity needs a value"
        PROOF_IDENTITY="$2"
        shift 2
        ;;
      --identity=*)
        PROOF_IDENTITY="${1#*=}"
        shift
        ;;
      --switch-identity)
        (($# >= 2)) || die "--switch-identity needs a value"
        PROOF_SWITCH_IDENTITY="$2"
        shift 2
        ;;
      --switch-identity=*)
        PROOF_SWITCH_IDENTITY="${1#*=}"
        shift
        ;;
      --device)
        (($# >= 2)) || die "--device needs a value"
        PROOF_DEVICE="$2"
        shift 2
        ;;
      --device=*)
        PROOF_DEVICE="${1#*=}"
        shift
        ;;
      --app-path)
        (($# >= 2)) || die "--app-path needs a value"
        PROOF_APP_PATH="$2"
        shift 2
        ;;
      --app-path=*)
        PROOF_APP_PATH="${1#*=}"
        shift
        ;;
      --environment)
        (($# >= 2)) || die "--environment needs a value"
        PROOF_ENVIRONMENT="$2"
        shift 2
        ;;
      --environment=*)
        PROOF_ENVIRONMENT="${1#*=}"
        shift
        ;;
      --tap-expect)
        (($# >= 2)) || die "--tap-expect needs a value"
        PROOF_TAP_EXPECT="$2"
        shift 2
        ;;
      --tap-expect=*)
        PROOF_TAP_EXPECT="${1#*=}"
        shift
        ;;
      --logout-expect)
        (($# >= 2)) || die "--logout-expect needs a value"
        PROOF_LOGOUT_EXPECT="$2"
        shift 2
        ;;
      --logout-expect=*)
        PROOF_LOGOUT_EXPECT="${1#*=}"
        shift
        ;;
      --profile-field)
        (($# >= 2)) || die "--profile-field needs a value"
        PROOF_PROFILE_FIELDS+=("$2")
        shift 2
        ;;
      --profile-field=*)
        PROOF_PROFILE_FIELDS+=("${1#*=}")
        shift
        ;;
      --event)
        (($# >= 2)) || die "--event needs a value"
        PROOF_EVENTS+=("$2")
        shift 2
        ;;
      --event=*)
        PROOF_EVENTS+=("${1#*=}")
        shift
        ;;
      --apple-id)
        (($# >= 2)) || die "--apple-id needs a value"
        APPLE_ID="$2"
        shift 2
        ;;
      --apple-id=*)
        APPLE_ID="${1#*=}"
        shift
        ;;
      --output-dir)
        (($# >= 2)) || die "--output-dir needs a value"
        OUTPUT_DIR="$2"
        shift 2
        ;;
      --output-dir=*)
        OUTPUT_DIR="${1#*=}"
        shift
        ;;
      --experimental)
        EXPERIMENTAL=true
        shift
        ;;
      --confirm-read)
        CONFIRM_READ=true
        shift
        ;;
      --confirm)
        CONFIRM=true
        shift
        ;;
      --replace)
        REPLACE=true
        shift
        ;;
      --offline)
        OFFLINE=true
        shift
        ;;
      -h|--help)
        usage
        exit 0
        ;;
      *)
        die "unknown option: $1"
        ;;
    esac
  done

  if [[ -n "$WORKSPACE_OVERRIDE" ]]; then
    IOS_WORKSPACE="$WORKSPACE_OVERRIDE"
  fi
  WORKSPACE="$(resolve_workspace)" || exit $?
  APNS_META="$WORKSPACE/apns.json"
  TARGET_META="$WORKSPACE/target.json"
  MOBILE_ENV="$WORKSPACE/.env"
  MOBILE_XCCONFIG="$WORKSPACE/IterableSecrets.xcconfig"
  MOBILE_VALIDATION="$WORKSPACE/mobile-validation.json"
  SERVER_VALIDATION="$WORKSPACE/server-validation.json"
  PROOF_TARGET="$WORKSPACE/proof-target.json"
  PROOF_DISCOVERY_META="$WORKSPACE/proof-discovery.json"
  ITERABLE_APP_META="$WORKSPACE/iterable-app.json"
  ITERABLE_PUSH_META="$WORKSPACE/iterable-push.json"
  SCOPE_META="$WORKSPACE/scope.json"
  DISCOVERY_META="$WORKSPACE/discovery.json"
  ITERABLE_SETUP_META="$WORKSPACE/iterable-setup.json"
  APPLE_SETUP_META="$WORKSPACE/apple-setup.json"
  APPLE_READINESS_META="$WORKSPACE/apple-readiness.json"
  APPLE_GUIDE_META="$WORKSPACE/apple-guide.json"
  APNS_VALIDATION="$WORKSPACE/apns-validation.json"
  ASC_KEY_META="$WORKSPACE/asc-key.json"
  ASC_READ_META="$WORKSPACE/asc-read.json"
  APPLE_WEB_META="$WORKSPACE/apple-web.json"
  APNS_KEY=""

  if [[ -z "$BUNDLE_ID" && -f "$TARGET_META" ]]; then
    BUNDLE_ID="$(node -e '
      const target = JSON.parse(require("fs").readFileSync(process.argv[1], "utf8"));
      process.stdout.write(String(target.bundle_id || ""));
    ' "$TARGET_META" 2>/dev/null)"
    if [[ "$APP_NAME_EXPLICIT" != true ]]; then
      APP_NAME="$(node -e '
        const target = JSON.parse(require("fs").readFileSync(process.argv[1], "utf8"));
        process.stdout.write(String(target.name || ""));
      ' "$TARGET_META" 2>/dev/null)"
    fi
  fi

  if [[ -f "$APNS_META" && -x "$(command -v node 2>/dev/null)" ]]; then
    APNS_KEY="$(node -e '
      const metadata = JSON.parse(require("fs").readFileSync(process.argv[1], "utf8"));
      process.stdout.write(String(metadata.key_path || ""));
    ' "$APNS_META" 2>/dev/null)"
  fi

  if [[ -f "$APPLE_WEB_META" && -x "$(command -v node 2>/dev/null)" ]]; then
    if [[ -z "$APPLE_ID" ]]; then
      APPLE_ID="$(node -e '
        const metadata = JSON.parse(require("fs").readFileSync(process.argv[1], "utf8"));
        process.stdout.write(String(metadata.apple_id || ""));
      ' "$APPLE_WEB_META" 2>/dev/null)"
    fi
    if [[ -z "$APPLE_TEAM_ID" ]]; then
      APPLE_TEAM_ID="$(node -e '
        const metadata = JSON.parse(require("fs").readFileSync(process.argv[1], "utf8"));
        process.stdout.write(String(metadata.team_id || ""));
      ' "$APPLE_WEB_META" 2>/dev/null)"
    fi
  fi

  if [[ -n "$BUNDLE_ID" ]] && ! valid_bundle_id "$BUNDLE_ID"; then
    die "not an explicit iOS bundle ID: $BUNDLE_ID"
  fi
}

source "$BIN/ios-questions.sh"

normalize_features() {
  node -e '
    const aliases = new Map([
      ["initialization only", "sdk-initialization"],
      ["initialization-only", "sdk-initialization"],
      ["identity only", "sdk-initialization"],
      ["identity-only", "sdk-initialization"]
    ]);
    const allowed = new Set([
      "sdk-initialization",
      "user-profiles",
      "event-tracking",
      "push-notifications",
      "in-app-messages",
      "mobile-inbox",
      "embedded-messaging",
      "deep-linking",
      "unknown-user-activation"
    ]);
    const values = process.argv[1].split(",").map(value => {
      const normalized = value.trim().toLowerCase();
      return aliases.get(normalized) || normalized;
    }).filter(Boolean);
    const features = [...new Set(["sdk-initialization", ...values])].sort();
    if (features.some(feature => !allowed.has(feature))) process.exit(2);
    process.stdout.write(JSON.stringify(features));
  ' "$1"
}

answer_scope() {
  command -v node >/dev/null 2>&1 || die "node is not installed"
  if [[ "$ANSWER_CLEAR" == true && -z "$ANSWER_FIELD" ]]; then
    if [[ -e "$DISCOVERY_META" ]]; then
      rm -f "$DISCOVERY_META"
    fi
    status_json
    return
  fi

  [[ -n "$ANSWER_FIELD" ]] || die "answer requires --field or --clear"
  if [[ "$ANSWER_CLEAR" != true ]]; then
    [[ -n "$ANSWER_VALUE" ]] || die "answer requires --value"
  fi

  local normalized=""
  case "$ANSWER_FIELD" in
    features)
      if [[ "$ANSWER_CLEAR" != true ]]; then
        normalized="$(normalize_features "$ANSWER_VALUE")" ||
          die "unknown feature; use initialization only, push-notifications, event-tracking, user-profiles, in-app-messages, mobile-inbox, embedded-messaging, or deep-linking"
      fi
      ;;
    feature-push|feature-events|feature-profiles|feature-more|feature-in-app|feature-inbox|feature-embedded|feature-deep-links)
      [[ "$ANSWER_CLEAR" == true || "$ANSWER_VALUE" == true ||
         "$ANSWER_VALUE" == false ]] ||
        die "$ANSWER_FIELD must be true or false"
      ;;
    identity-mode)
      [[ "$ANSWER_CLEAR" == true || "$ANSWER_VALUE" == email ||
         "$ANSWER_VALUE" == user-id || "$ANSWER_VALUE" == unknown-user ]] ||
        die "identity-mode must be email, user-id, or unknown-user"
      ;;
    region)
      [[ "$ANSWER_CLEAR" == true || "$ANSWER_VALUE" == US ||
         "$ANSWER_VALUE" == EU ]] ||
        die "region must be US or EU"
      ;;
    jwt-enabled|jwt-check)
      [[ "$ANSWER_CLEAR" == true || "$ANSWER_VALUE" == true ||
         "$ANSWER_VALUE" == false ]] ||
        die "$ANSWER_FIELD must be true or false"
      ;;
    *)
      die "unknown answer field: $ANSWER_FIELD"
      ;;
  esac

  init_workspace
  local current='{}' candidate
  [[ ! -f "$DISCOVERY_META" ]] ||
    current="$(cat "$DISCOVERY_META" 2>/dev/null)" ||
    die "could not read $DISCOVERY_META"
  candidate="$(node -e '
    const current = JSON.parse(process.argv[1]);
    const field = process.argv[2];
    const value = process.argv[3];
    const add = process.argv[4] === "true";
    const clear = process.argv[5] === "true";
    const key = {
      "features": "features",
      "identity-mode": "identity_mode",
      "region": "data_region",
      "jwt-enabled": "jwt_enabled",
      "jwt-check": "jwt_check"
    }[field];
    const featureKey=field.startsWith("feature-") ? field.slice(8) : "";
    if (clear) {
      if (featureKey) {
        if (current.feature_choices) delete current.feature_choices[featureKey];
      } else {
        delete current[key];
      }
    } else if (field === "features") {
      const incoming = JSON.parse(value);
      delete current.feature_choices;
      current.features = add
        ? [...new Set([...(current.features || []), ...incoming])].sort()
        : incoming;
    } else if (featureKey) {
      delete current.features;
      current.feature_choices ||= {};
      current.feature_choices[featureKey] = value === "true";
    } else if (field === "jwt-enabled" || field === "jwt-check") {
      current[key] = value === "true";
      if (field === "jwt-enabled") delete current.jwt_check;
    } else {
      current[key] = value;
    }
    process.stdout.write(JSON.stringify(current, null, 2) + "\n");
  ' "$current" "$ANSWER_FIELD" \
    "$([[ "$ANSWER_FIELD" == features && "$ANSWER_CLEAR" != true ]] && printf '%s' "$normalized" || printf '%s' "$ANSWER_VALUE")" \
    "$ANSWER_ADD" "$ANSWER_CLEAR")" ||
    die "could not update the proposed iOS integration scope"
  (
    umask 077
    printf '%s' "$candidate" > "$DISCOVERY_META"
  )
  chmod 600 "$DISCOVERY_META"
  status_json
}

proof_answer() {
  command -v node >/dev/null 2>&1 || die "node is not installed"
  if [[ "$ANSWER_CLEAR" == true && -z "$ANSWER_FIELD" ]]; then
    rm -f "$PROOF_DISCOVERY_META"
    proof_status_json
    return
  fi
  [[ -n "$ANSWER_FIELD" ]] || die "proof-answer requires --field or --clear"
  [[ "$ANSWER_CLEAR" == true || -n "$ANSWER_VALUE" ]] ||
    die "proof-answer requires --value"
  [[ "$ANSWER_VALUE" != *$'\n'* && "$ANSWER_VALUE" != *$'\t'* ]] ||
    die "proof answers must each be one line"

  case "$ANSWER_FIELD" in
    proof-mode)
      [[ "$ANSWER_CLEAR" == true || "$ANSWER_VALUE" == behavioral ||
         "$ANSWER_VALUE" == instrumented ]] ||
        die "proof-mode must be behavioral or instrumented"
      ;;
    bundle-id)
      [[ "$ANSWER_CLEAR" == true ]] || valid_bundle_id "$ANSWER_VALUE" ||
        die "proof bundle-id must be an explicit iOS Bundle ID"
      ;;
    identity-type)
      [[ "$ANSWER_CLEAR" == true || "$ANSWER_VALUE" == email ||
         "$ANSWER_VALUE" == user-id ]] ||
        die "proof identity-type must be email or user-id"
      ;;
    region)
      [[ "$ANSWER_CLEAR" == true || "$ANSWER_VALUE" == US ||
         "$ANSWER_VALUE" == EU ]] ||
        die "proof region must be US or EU"
      ;;
    environment)
      [[ "$ANSWER_CLEAR" == true || "$ANSWER_VALUE" == development ||
         "$ANSWER_VALUE" == production ]] ||
        die "proof environment must be development or production"
      ;;
    identity|switch-identity|device|app-path|profile-field|event|tap-expect|logout-expect)
      ((${#ANSWER_VALUE} <= 500)) || die "proof answer is too long"
      ;;
    *)
      die "unknown proof-answer field: $ANSWER_FIELD"
      ;;
  esac

  init_workspace
  local current='{}' candidate
  [[ ! -f "$PROOF_DISCOVERY_META" ]] ||
    current="$(cat "$PROOF_DISCOVERY_META")" ||
    die "could not read $PROOF_DISCOVERY_META"
  candidate="$(node -e '
    const current=JSON.parse(process.argv[1]);
    const field=process.argv[2], value=process.argv[3], clear=process.argv[4]==="true";
    const key={
      "proof-mode":"proof_mode",
      "bundle-id":"bundle_id",
      "region":"data_region",
      "identity-type":"identity_type",
      "environment":"environment",
      "identity":"identity",
      "switch-identity":"switch_identity",
      "device":"device",
      "app-path":"app_path",
      "profile-field":"profile_field",
      "event":"event",
      "tap-expect":"tap_expect",
      "logout-expect":"logout_expect"
    }[field];
    if (clear) delete current[key];
    else current[key]=value;
    process.stdout.write(JSON.stringify(current,null,2)+"\n");
  ' "$current" "$ANSWER_FIELD" "$ANSWER_VALUE" "$ANSWER_CLEAR")" ||
    die "could not update proposed proof inputs"
  (
    umask 077
    printf '%s' "$candidate" > "$PROOF_DISCOVERY_META"
  )
  chmod 600 "$PROOF_DISCOVERY_META"
  proof_status_json
}

is_booted_simulator() {
  local wanted="$1" simulators
  command -v xcrun >/dev/null 2>&1 || return 1
  simulators="$(xcrun simctl list devices --json 2>/dev/null || printf '{}')"
  printf '%s' "$simulators" | node -e '
    let input="";
    process.stdin.on("data",chunk=>input+=chunk).on("end",()=>{
      let root; try { root=JSON.parse(input) } catch { process.exit(1) }
      const wanted=process.argv[1];
      const devices=Object.values(root.devices||{}).flat();
      process.exit(devices.some(
        device=>device.udid===wanted && device.state==="Booted"
      ) ? 0 : 1);
    });
  ' "$wanted"
}

is_connected_physical_device() {
  local wanted="$1" devices
  command -v xcrun >/dev/null 2>&1 || return 1
  devices="$(xcrun devicectl --timeout 10 --quiet --json-output - list devices \
    2>/dev/null || printf '{}')"
  printf '%s' "$devices" | node -e '
    let input="";
    process.stdin.on("data",chunk=>input+=chunk).on("end",()=>{
      let root; try { root=JSON.parse(input) } catch { process.exit(1) }
      const wanted=process.argv[1];
      let found=false;
      const scalar=(object,pattern)=>Object.entries(object)
        .filter(([key,value])=>pattern.test(key) &&
          ["string","number","boolean"].includes(typeof value))
        .map(([,value])=>String(value));
      const deepScalar=(object,pattern)=>{
        const out=[];
        const visit=value=>{
          if (!value || typeof value!=="object") return;
          for (const [key,child] of Object.entries(value)) {
            if (pattern.test(key) &&
                ["string","number","boolean"].includes(typeof child)) {
              out.push(String(child));
            } else {
              visit(child);
            }
          }
        };
        visit(object);
        return out;
      };
      const isPhysicalIPhone=object=>{
        if (!object || typeof object!=="object" || Array.isArray(object)) return false;
        const identifiers=scalar(
          object,
          /^(identifier|udid|deviceId|deviceIdentifier)$/i
        );
        if (!identifiers.includes(wanted)) return false;
        const descriptive=deepScalar(
          object,
          /(name|platform|productType|deviceClass|deviceFamily|hardwareModel|reality)/i
        ).join(" ").toLowerCase();
        if (/\bsimulat(?:ed|or)\b|\bvirtual\b/.test(descriptive)) return false;
        if (!/\biphone\b|\bios\b/.test(descriptive)) return false;
        const connection=deepScalar(
          object,
          /(connectionState|connectionStatus|state|visibility|pairingState)/i
        ).join(" ").toLowerCase();
        return !/\b(disconnected|unavailable|offline|unpaired)\b/.test(connection);
      };
      const visit=value=>{
        if (found || !value || typeof value!=="object") return;
        if (isPhysicalIPhone(value)) found=true;
        for (const child of Object.values(value)) visit(child);
      };
      visit(root);
      process.exit(found ? 0 : 1);
    });
  ' "$wanted"
}

# The lowest iOS the app runs on: the recorded .app, else an installed copy on a
# booted Simulator, else the highest deployment target the project declares.
proof_min_os() {
  local bundle="$1" app_path="${2:-}" value="" udid container root
  if [[ -n "$app_path" && -f "$app_path/Info.plist" ]]; then
    value="$(plutil -extract MinimumOSVersion raw -o - "$app_path/Info.plist" 2>/dev/null)"
  fi
  if [[ ! "$value" =~ ^[0-9]+(\.[0-9]+)*$ && -n "$bundle" ]] && command -v xcrun >/dev/null 2>&1; then
    value=""
    while IFS= read -r udid; do
      container="$(xcrun simctl get_app_container "$udid" "$bundle" app 2>/dev/null)" || continue
      [[ -f "$container/Info.plist" ]] || continue
      value="$(plutil -extract MinimumOSVersion raw -o - "$container/Info.plist" 2>/dev/null)"
      [[ "$value" =~ ^[0-9]+(\.[0-9]+)*$ ]] && break
      value=""
    done < <(xcrun simctl list devices --json 2>/dev/null | node -e '
      let i=""; process.stdin.on("data",c=>i+=c).on("end",()=>{
        try { for (const list of Object.values(JSON.parse(i).devices||{}))
          for (const d of list||[]) if (d.state==="Booted") console.log(d.udid); } catch {}
      });')
  fi
  if [[ ! "$value" =~ ^[0-9]+(\.[0-9]+)*$ ]]; then
    root="$(verification_project_root 2>/dev/null)" || root=""
    if [[ -n "$root" && -d "$root" ]]; then
      value="$(find "$root" -maxdepth 3 \( -name project.pbxproj -o -name project.yml -o -name '*.xcconfig' \) \
          -not -path '*/DerivedData/*' -not -path '*/Pods/*' -type f -print0 2>/dev/null |
        xargs -0 grep -h -E -o '(IPHONEOS_DEPLOYMENT_TARGET[ =:"]+|iOS:[ "]+)[0-9]+(\.[0-9]+)?' 2>/dev/null |
        grep -E -o '[0-9]+(\.[0-9]+)?$' | sort -t. -k1,1n -k2,2n | tail -1)"
    fi
  fi
  [[ "$value" =~ ^[0-9]+(\.[0-9]+)*$ ]] && printf '%s' "$value"
}

proof_devices_json() {
  local environment="${1:-}" push_required="${2:-false}" min_os="${3:-}"
  local simulators='{}' physical='{}' host_apns=false
  if command -v xcrun >/dev/null 2>&1; then
    simulators="$(xcrun simctl list devices --json 2>/dev/null || printf '{}')"
    physical="$(xcrun devicectl --timeout 10 --quiet --json-output - list devices 2>/dev/null || printf '{}')"
  fi
  ios_simulator_host_supports_apns && host_apns=true
  node -e '
    const [simRaw,physicalRaw,environment,pushRequired,hostAPNs,minOS]=process.argv.slice(1);
    const out=[], seen=new Set();
    const version=text=>String(text||"").split(".").map(Number);
    const atLeast=(have,want)=>{
      for (let i=0;i<Math.max(have.length,want.length);i++) {
        const a=have[i]||0, b=want[i]||0;
        if (a!==b) return a>b;
      }
      return true;
    };
    try {
      const sim=JSON.parse(simRaw);
      for (const [runtime,devices] of Object.entries(sim.devices||{})) {
        for (const device of devices||[]) {
          if (device.state!=="Booted" || device.isAvailable===false ||
              !device.udid || seen.has(device.udid)) continue;
          const identifier=String(device.runtimeIdentifier||runtime);
          const match=identifier.match(/(?:^|[.-])iOS[-.]?(\d+)/i);
          const apnsEligible=hostAPNs==="true" && match && Number(match[1])>=16;
          if (pushRequired==="true" &&
              ((environment && environment!=="development") || !apnsEligible)) continue;
          const runtimeVersion=identifier.match(/iOS[-.]?(\d+)(?:[-.](\d+))?/i);
          if (minOS && runtimeVersion &&
              !atLeast([Number(runtimeVersion[1]),Number(runtimeVersion[2]||0)],version(minOS))) continue;
          seen.add(device.udid);
          out.push({
            id:String(device.udid),
            label:`${device.name||"Simulator"} (Simulator)`,
            description:pushRequired==="true"
              ? "Booted iOS 16+ Simulator eligible for real APNs sandbox delivery."
              : "Booted Simulator; supports runtime proof without push delivery."
          });
        }
      }
    } catch {}
    try {
      const root=JSON.parse(physicalRaw);
      const scalar=(object,pattern)=>Object.entries(object)
        .filter(([key,value])=>pattern.test(key) &&
          ["string","number","boolean"].includes(typeof value))
        .map(([,value])=>String(value));
      const deepScalar=(object,pattern)=>{
        const out=[];
        const walk=value=>{
          if (!value || typeof value!=="object") return;
          for (const [key,child] of Object.entries(value)) {
            if (pattern.test(key) &&
                ["string","number","boolean"].includes(typeof child)) {
              out.push(String(child));
            } else {
              walk(child);
            }
          }
        };
        walk(object);
        return out;
      };
      const visit=value=>{
        if (!value || typeof value!=="object") return;
        if (!Array.isArray(value)) {
          const entries=Object.entries(value);
          const idEntry=entries.find(([key,val])=>
            /^(identifier|udid|deviceId|deviceIdentifier)$/i.test(key) &&
            typeof val==="string" && val.length>=8
          );
          const nameEntry=entries.find(([key,val])=>
            /name/i.test(key) && typeof val==="string"
          );
          const nestedName=deepScalar(value,/name/i)[0];
          const descriptive=deepScalar(
            value,
            /(name|platform|productType|deviceClass|deviceFamily|hardwareModel|reality)/i
          ).join(" ").toLowerCase();
          const connection=deepScalar(
            value,
            /(connectionState|connectionStatus|state|visibility|pairingState)/i
          ).join(" ").toLowerCase();
          const physicalIPhone=
            !/\bsimulat(?:ed|or)\b|\bvirtual\b/.test(descriptive) &&
            /\biphone\b|\bios\b/.test(descriptive) &&
            !/\b(disconnected|unavailable|offline|unpaired)\b/.test(connection);
          if (idEntry && physicalIPhone && !seen.has(idEntry[1])) {
            seen.add(idEntry[1]);
            out.push({
              id:idEntry[1],
              label:`${nameEntry?.[1]||nestedName||"iPhone"} (physical)`,
              description:"Connected physical device; supports development or production APNs proof."
            });
          }
        }
        for (const child of Object.values(value)) visit(child);
      };
      visit(root);
    } catch {}
    process.stdout.write(JSON.stringify(out));
  ' "$simulators" "$physical" "$environment" "$push_required" "$host_apns" "$min_os"
}

proof_question_identity_and_confirm() {
  local summary="$1" identity_type="$2" device="$3" noun="email address"
  [[ "$identity_type" == email ]] || noun="user ID"
  printf '{"header":"Proof run","prompt":%s,"selection":"single",' \
    "$(jstr "Which $noun is the app signed in with? Entering it starts the proof run.")"
  printf '"context":%s,' "$(printf '%s\n' "$summary" | ios_q_arr)"
  printf '"requires":[],"recommended":null,"before_commands":[],"options":['
  ios_q_opt "I don't have a test user yet — help me" \
    "Shows how to sign in to the app with a test identity you control, then you answer with it." \
    "opens the test-user guide; nothing is recorded yet" \
    "$BIN/ios-provision question --kind help_proof_identity_start"
  printf ','
  ios_q_opt "Use a different device" \
    "Clears the prefilled device so you can pick another booted Simulator or iPhone." \
    "returns to device selection" \
    "$BIN/ios-prepare-proof answer --field device --clear"
  printf ','
  ios_q_opt "Stop here" \
    "No proof run is created and nothing is sent." \
    "the integration remains unproved"
  printf '],"free_text":%s}' "$(ios_q_free_text \
    "Enter the exact $noun used in the app" \
    "records the identity and starts the run; ios-prove later sends one marked push to it on $device" \
    "$BIN/ios-prepare-proof start --confirm --identity '{{answer}}'")"
}

proof_status_json() {
  local proposed='{}' scope_identity="" scope_features="" scope_region=""
  local target_bundle="" project_root verification_only=false detected_features='[]'
  local proof_mode bundle identity_type environment identity switch_identity device app_path
  local profile_field event tap_expect logout_expect push_required=false data_region=""
  local next_kind summary question devices summary_text
  [[ ! -f "$PROOF_DISCOVERY_META" ]] ||
    proposed="$(cat "$PROOF_DISCOVERY_META")" ||
    die "could not read $PROOF_DISCOVERY_META"
  project_root="$(verification_project_root)"
  if [[ -f "$SCOPE_META" ]]; then
    scope_identity="$(node -e 'const v=JSON.parse(require("fs").readFileSync(process.argv[1],"utf8"));process.stdout.write(String(v.identity_mode||""))' "$SCOPE_META")"
    scope_features="$(node -e 'const v=JSON.parse(require("fs").readFileSync(process.argv[1],"utf8"));process.stdout.write((v.features||[]).join(","))' "$SCOPE_META")"
    scope_region="$(node -e 'const v=JSON.parse(require("fs").readFileSync(process.argv[1],"utf8"));process.stdout.write(String(v.data_region||""))' "$SCOPE_META")"
    verification_only="$(node -e 'const v=JSON.parse(require("fs").readFileSync(process.argv[1],"utf8"));process.stdout.write(String(v.verification_only===true))' "$SCOPE_META")"
  else
    verification_only=true
    scope_identity="$(verification_detect_identity "$project_root")"
    detected_features="$(verification_detect_features "$project_root")"
    scope_features="$(node -e 'process.stdout.write(JSON.parse(process.argv[1]).join(","))' "$detected_features")"
  fi
  [[ ",$scope_features," == *,push-notifications,* ]] && push_required=true
  [[ ! -f "$TARGET_META" ]] ||
    target_bundle="$(node -e 'const v=JSON.parse(require("fs").readFileSync(process.argv[1],"utf8"));process.stdout.write(String(v.bundle_id||""))' "$TARGET_META")"

  read_proposed() {
    node -e '
      const v=JSON.parse(process.argv[1]);
      process.stdout.write(String(v[process.argv[2]]||""));
    ' "$proposed" "$1"
  }
  proof_mode="$(read_proposed proof_mode)"
  [[ -n "$proof_mode" ]] || proof_mode=behavioral
  bundle="$(read_proposed bundle_id)"
  [[ -n "$bundle" ]] || bundle="$target_bundle"
  [[ -n "$bundle" ]] || bundle="$(verification_detect_bundle "$project_root")"
  data_region="$(read_proposed data_region)"
  [[ -n "$data_region" ]] || data_region="$scope_region"
  if [[ -z "$data_region" && -f "$SERVER_VALIDATION" ]]; then
    data_region="$(node -e '
      const v=JSON.parse(require("fs").readFileSync(process.argv[1],"utf8"));
      process.stdout.write(v.valid===true ? String(v.data_region||"") : "");
    ' "$SERVER_VALIDATION" 2>/dev/null)"
  fi
  identity_type="$(read_proposed identity_type)"
  if [[ -n "$scope_identity" && "$scope_identity" != unknown-user ]]; then
    identity_type="$scope_identity"
  fi
  environment="$(read_proposed environment)"
  identity="$(read_proposed identity)"
  switch_identity="$(read_proposed switch_identity)"
  device="$(read_proposed device)"
  app_path="$(read_proposed app_path)"
  profile_field="$(read_proposed profile_field)"
  event="$(read_proposed event)"
  tap_expect="$(read_proposed tap_expect)"
  logout_expect="$(read_proposed logout_expect)"

  local min_os
  min_os="$(proof_min_os "$bundle" "$app_path")"
  if [[ -z "$device" && "$proof_mode" == behavioral ]]; then
    local candidates
    candidates="$(proof_devices_json "$environment" "$push_required" "$min_os")"
    device="$(node -e '
      const list=JSON.parse(process.argv[1]);
      process.stdout.write(list.length===1 ? String(list[0].id) : "");
    ' "$candidates")"
  fi
  if [[ -z "$environment" && -n "$device" ]] && is_booted_simulator "$device"; then
    environment=development
  fi

  if [[ -z "$bundle" ]]; then next_kind=proof_bundle
  elif [[ -z "$data_region" ]]; then next_kind=proof_region
  elif [[ -z "$identity_type" ]]; then next_kind=proof_identity_type
  elif [[ -z "$device" ]]; then next_kind=proof_device
  elif [[ -z "$environment" ]]; then next_kind=proof_environment
  elif [[ -z "$identity" && "$proof_mode" == behavioral ]]; then next_kind=confirm_proof
  elif [[ -z "$identity" ]]; then next_kind=proof_identity
  elif [[ "$proof_mode" == instrumented && -z "$switch_identity" ]]; then next_kind=proof_switch_identity
  elif [[ "$proof_mode" == instrumented && -z "$app_path" ]]; then next_kind=proof_app
  elif [[ "$proof_mode" == instrumented &&
          ",$scope_features," == *,user-profiles,* && -z "$profile_field" ]]; then next_kind=proof_profile
  elif [[ "$proof_mode" == instrumented &&
          ",$scope_features," == *,event-tracking,* && -z "$event" ]]; then next_kind=proof_event
  elif [[ "$proof_mode" == instrumented &&
          "$push_required" == true && -z "$tap_expect" ]]; then next_kind=proof_tap
  elif [[ "$proof_mode" == instrumented && -z "$logout_expect" ]]; then next_kind=proof_logout
  else next_kind=confirm_proof
  fi

  if [[ -f "$PROOF_TARGET" && "$proposed" == '{}' ]]; then
    next_kind=existing_proof
  fi

  case "$next_kind" in
    existing_proof)
      summary_text="$(node -e '
        const v=JSON.parse(require("fs").readFileSync(process.argv[1],"utf8"));
        const age=Math.round((Date.now()-Date.parse(v.started_at))/60000);
        process.stdout.write([
          `Run: ${v.run_id}`,
          `Started: ${v.started_at} (${age} minutes ago)`,
          `Identity: ${v.identity}`,
          `Device: ${v.device} (${v.device_kind})`
        ].join("\n"));
      ' "$PROOF_TARGET")"
      question="$(
        printf '{"header":"Proof run","prompt":%s,"selection":"single",' \
          "$(jstr "A proof run already exists. Keep it or start a fresh one?")"
        printf '"context":%s,' "$(printf '%s\n' "$summary_text" | ios_q_arr)"
        printf '"requires":[],"recommended":%s,"before_commands":[],"options":[' "$(jstr "Keep this run")"
        ios_q_opt "Keep this run" \
          "Reads this run's current state; nothing is sent or reset." \
          "the verifier reports where this run stands" \
          "$BIN/ios-verify status"
        printf ','
        ios_q_opt "Start a fresh run" \
          "Archives this run's evidence and records a new run ID and marker for the same identity and device." \
          "a new proof run replaces this one" \
          "$BIN/ios-prepare-proof restart --confirm"
        printf ']}'
      )"
      summary="A proof run already exists; keep it or start a fresh one with the same identity and device."
      ;;
    proof_device)
      devices="$(proof_devices_json "$environment" "$push_required" "$min_os")"
      question="$(ios_question proof_device "$devices")"
      summary="Choose the exact device that will run and display this proof."
      [[ -z "$min_os" ]] ||
        summary="$summary Only Simulators on iOS $min_os or later are listed: that is the app's deployment target."
      ;;
    confirm_proof)
      if [[ "$proof_mode" == behavioral ]]; then
        summary_text="Verification: standard integration proof
Bundle: $bundle
Iterable region: $data_region
Environment: $environment
Identity type: $identity_type
Identity: ${identity:-the exact $identity_type the app is signed in with (type it to start)}
Device: $device
App artifact: ${app_path:-use the app already installed for this bundle}
Checks: installed app, Iterable identity, device registration, then one marked push sent through Iterable and read back from the device's own records"
      else
        summary_text="Verification: instrumented evaluation
Bundle: $bundle
Iterable region: $data_region
Environment: $environment
Identity type: $identity_type
User A: $identity
User B: $switch_identity
Device: $device
App: $app_path
Profile expectation: ${profile_field:-none selected}
Event expectation: ${event:-none selected}
Tap expectation: ${tap_expect:-not applicable}
Logout expectation: $logout_expect"
      fi
      if [[ "$proof_mode" == behavioral && -z "$identity" ]]; then
        question="$(proof_question_identity_and_confirm "$summary_text" "$identity_type" "$device")"
        summary="Type the identity the app is signed in with; that starts the run on the device shown."
      else
        question="$(ios_question confirm_proof "$summary_text")"
        summary="Review the exact proof target before the live freshness checks create the run."
      fi
      ;;
    proof_app)
      question="$(ios_question proof_app "$proof_mode")"
      summary="Select the exact app artifact for the chosen proof mode."
      ;;
    *)
      question="$(ios_question "$next_kind")"
      summary="Answer the next tool-authored proof question."
      ;;
  esac
  printf '{"tool":"iterable-ios-proof-setup","contract":2,"workspace":%s,' \
    "$(jstr "$WORKSPACE")"
  printf '"verification_only":%s,"proposed":{"proof_mode":%s,"bundle_id":%s,"data_region":%s,"identity_type":%s,"environment":%s,"identity":%s,"switch_identity":%s,"device":%s,"app_path":%s,"profile_field":%s,"event":%s,"tap_expect":%s,"logout_expect":%s},' \
    "$verification_only" "$(jstr "$proof_mode")" "$(jstr "$bundle")" "$(jstr "$data_region")" "$(jstr "$identity_type")" "$(jstr "$environment")" \
    "$(jstr "$identity")" "$(jstr "$switch_identity")" "$(jstr "$device")" \
    "$(jstr "$app_path")" "$(jstr "$profile_field")" "$(jstr "$event")" \
    "$(jstr "$tap_expect")" "$(jstr "$logout_expect")"
  printf '"next":{"owner":"human","kind":%s,"command":%s,"summary":%s,"question":%s}}\n' \
    "$(jstr "$next_kind")" "$(jstr "$BIN/ios-prepare-proof status")" \
    "$(jstr "$summary")" "$question"
}

record_scope() {
  [[ "$CONFIRM" == true ]] ||
    die "record-scope requires --confirm after the developer answers the integration questions"
  if [[ "$FROM_ANSWERS" == true ]]; then
    [[ -f "$DISCOVERY_META" ]] ||
      die "record-scope --from-answers requires completed selector answers"
    FEATURES="$(node -e '
      const value = JSON.parse(require("fs").readFileSync(process.argv[1], "utf8"));
      const map={
        push:"push-notifications",
        events:"event-tracking",
        profiles:"user-profiles",
        "in-app":"in-app-messages",
        inbox:"mobile-inbox",
        embedded:"embedded-messaging",
        "deep-links":"deep-linking"
      };
      const selected=value.features || Object.entries(value.feature_choices || {})
        .filter(([,enabled])=>enabled===true)
        .map(([key])=>map[key])
        .filter(Boolean);
      process.stdout.write([...new Set(["sdk-initialization",...selected])].sort().join(","));
    ' "$DISCOVERY_META")"
    IDENTITY_MODE="$(node -e '
      const value = JSON.parse(require("fs").readFileSync(process.argv[1], "utf8"));
      process.stdout.write(String(value.identity_mode || ""));
    ' "$DISCOVERY_META")"
    DATA_REGION="$(node -e '
      const value = JSON.parse(require("fs").readFileSync(process.argv[1], "utf8"));
      process.stdout.write(String(value.data_region || ""));
    ' "$DISCOVERY_META")"
    JWT_ENABLED="$(node -e '
      const value = JSON.parse(require("fs").readFileSync(process.argv[1], "utf8"));
      process.stdout.write(
        typeof value.jwt_enabled === "boolean" ? String(value.jwt_enabled) : ""
      );
    ' "$DISCOVERY_META")"
  fi
  [[ -n "$FEATURES" ]] || die "record-scope requires --features or --from-answers"
  [[ "$IDENTITY_MODE" == email || "$IDENTITY_MODE" == user-id ||
     "$IDENTITY_MODE" == unknown-user ]] ||
    die "record-scope requires --identity-mode email, user-id, or unknown-user"
  [[ "$DATA_REGION" == US || "$DATA_REGION" == EU ]] ||
    die "record-scope requires --region US or --region EU"
  [[ "$JWT_ENABLED" == true || "$JWT_ENABLED" == false ]] ||
    die "record-scope requires an explicit --jwt-enabled true or false"
  command -v node >/dev/null 2>&1 || die "node is not installed"

  local normalized candidate
  normalized="$(normalize_features "$FEATURES")" ||
    die "record-scope contains an unknown feature; use user-profiles, event-tracking, push-notifications, in-app-messages, mobile-inbox, embedded-messaging, deep-linking, or unknown-user-activation"
  if [[ "$IDENTITY_MODE" == unknown-user ]]; then
    normalized="$(node -e '
      const features = JSON.parse(process.argv[1]);
      process.stdout.write(JSON.stringify(
        [...new Set([...features, "unknown-user-activation"])].sort()
      ));
    ' "$normalized")"
  fi

  candidate="$(node -e '
    process.stdout.write(JSON.stringify({
      features: JSON.parse(process.argv[1]),
      identity_mode: process.argv[2],
      data_region: process.argv[3],
      jwt_enabled: process.argv[4] === "true"
    }, null, 2) + "\n");
  ' "$normalized" "$IDENTITY_MODE" "$DATA_REGION" "$JWT_ENABLED")"

  if [[ -f "$SCOPE_META" ]]; then
    if node -e '
      const fs = require("fs");
      const current = JSON.parse(fs.readFileSync(process.argv[1], "utf8"));
      const candidate = JSON.parse(process.argv[2]);
      process.exit(JSON.stringify(current) === JSON.stringify(candidate) ? 0 : 1);
    ' "$SCOPE_META" "$candidate"; then
      status_json
      return
    fi
    die "$SCOPE_META already records different integration decisions; review and remove it deliberately before changing scope"
  fi

  init_workspace
  (
    umask 077
    printf '%s' "$candidate" > "$SCOPE_META"
  )
  chmod 600 "$SCOPE_META"
  rm -f "$DISCOVERY_META"
  printf 'Recorded the agreed iOS integration scope at %s (mode 0600).\n' \
    "$SCOPE_META" >&2
  status_json
}

record_iterable_setup() {
  [[ "$CONFIRM" == true ]] ||
    die "record-iterable-setup requires --confirm after the developer chooses who will drive the Iterable step"
  [[ "$ITERABLE_DRIVER" == guided || "$ITERABLE_DRIVER" == developer ]] ||
    die "record-iterable-setup requires --driver guided or --driver developer"
  [[ -f "$SCOPE_META" ]] ||
    die "record the integration scope before choosing who drives Iterable setup"
  command -v node >/dev/null 2>&1 || die "node is not installed"
  require_ios_next "record-iterable-setup" configure_iterable capture_iterable

  local candidate
  candidate="$(node -e '
    const scope=JSON.parse(require("fs").readFileSync(process.argv[1],"utf8"));
    process.stdout.write(JSON.stringify({
      driver: process.argv[2],
      data_region: scope.data_region,
      jwt_enabled: scope.jwt_enabled
    }, null, 2) + "\n");
  ' "$SCOPE_META" "$ITERABLE_DRIVER")" ||
    die "could not read the recorded Iterable scope"

  if [[ -f "$ITERABLE_SETUP_META" ]]; then
    if node -e '
      const fs=require("fs");
      const current=JSON.parse(fs.readFileSync(process.argv[1],"utf8"));
      process.exit(JSON.stringify(current)===JSON.stringify(JSON.parse(process.argv[2])) ? 0 : 1);
    ' "$ITERABLE_SETUP_META" "$candidate"; then
      status_json
      return
    fi
  fi

  init_workspace
  (
    umask 077
    printf '%s' "$candidate" > "$ITERABLE_SETUP_META"
  )
  chmod 600 "$ITERABLE_SETUP_META"
  status_json
}

status_json() {
  local has_xcode=false has_node=false has_npx=false has_curl=false
  local apns_present=false apns_secure=false apns_metadata_valid=false
  local apns_private_key_valid=false
  local apns_key_id="" apple_team_id=""
  local apns_tool_verified=false apns_rejected=false apns_rejection_reason=""
  local apns_classification="-" apns_credentials_valid=false
  local mobile_key_present=false mobile_env_secure=false
  local mobile_xcconfig_present=false mobile_xcconfig_secure=false
  local mobile_region="" mobile_jwt="" mobile_key_value=""
  local mobile_key_hash="" mobile_validated=false
  local mobile_validation_present=false mobile_validation_secure=false
  local mobile_validation_region="" mobile_validation_jwt=""
  local mobile_validation_hash="" mobile_validation_classification=""
  local server_key_present=false server_key_value="" server_key_hash=""
  local server_validated=false server_validation_present=false
  local server_validation_secure=false server_validation_hash=""
  local server_validation_region="" server_validation_classification=""
  local mobile_validation_rejected=false mobile_rejection_reason=""
  local server_validation_rejected=false server_rejection_reason=""
  local keys_identical=false
  local proof_target_present=false proof_target_secure=false
  local proof_target_valid=false proof_mode="" proof_identity_type="" proof_identity=""
  local proof_switch_identity="" proof_device="" proof_device_kind=""
  local proof_simulator_runtime="" proof_app_path=""
  local proof_environment="" proof_apns_environment=""
  local proof_production_follow_up=false proof_profile_fields="" proof_events=""
  local proof_started_at="" proof_run_id="" proof_tap_expect=""
  local proof_logout_expect="" proof_direct_marker=""
  local proof_targeted_marker="" proof_switch_marker=""
  local iterable_app_present=false iterable_app_secure=false
  local iterable_app_valid=false iterable_app_source=""
  local iterable_push_present=false iterable_push_secure=false
  local iterable_push_valid=false
  local scope_present=false scope_secure=false scope_valid=false
  local scope_features="" scope_identity="" scope_region="" scope_jwt=""
  local scope_verification_only=false
  local discovery_present=false discovery_secure=false discovery_valid=false
  local discovery_features="" discovery_identity="" discovery_region=""
  local discovery_jwt="" discovery_jwt_present=false discovery_jwt_check=false
  local discovery_push="" discovery_events="" discovery_profiles=""
  local discovery_more="" discovery_in_app="" discovery_inbox="" discovery_embedded=""
  local discovery_deep_links=""
  local iterable_setup_present=false iterable_setup_secure=false
  local iterable_setup_valid=false iterable_setup_driver=""
  local apple_setup_present=false apple_setup_secure=false
  local apple_setup_valid=false apple_setup_strategy=""
  local apple_readiness_present=false apple_readiness_secure=false
  local apple_readiness_valid=false apple_readiness_evidence=""
  local apple_guide_steps="" apple_guide_next=""
  local apple_evidence_level="blocked"
  local push_required=false target_recorded=false
  local detected_bundle="" detected_name="" detected_source=""
  local has_modern_ruby=false experimental_fastlane=false experimental_ruby=""
  local next_kind next_owner next_summary

  command -v xcodebuild >/dev/null 2>&1 && has_xcode=true
  command -v node >/dev/null 2>&1 && has_node=true
  command -v npx >/dev/null 2>&1 && has_npx=true
  command -v curl >/dev/null 2>&1 && has_curl=true
  if experimental_ruby="$(modern_ruby 2>/dev/null)"; then
    has_modern_ruby=true
  fi
  experimental_fastlane_ready && experimental_fastlane=true

  if [[ -f "$SCOPE_META" ]]; then
    scope_present=true
    [[ "$(file_mode "$SCOPE_META")" == 600 ]] && scope_secure=true
    if node -e '
      const fs = require("fs");
      const allowed = new Set([
        "sdk-initialization", "user-profiles", "event-tracking", "push-notifications",
        "in-app-messages", "mobile-inbox", "embedded-messaging",
        "deep-linking", "unknown-user-activation"
      ]);
      const scope = JSON.parse(fs.readFileSync(process.argv[1], "utf8"));
      const valid = Array.isArray(scope.features) &&
        scope.features.length > 0 &&
        scope.features.every(feature => allowed.has(feature)) &&
        ["email", "user-id", "unknown-user"].includes(scope.identity_mode) &&
        ["US", "EU"].includes(scope.data_region) &&
        typeof scope.jwt_enabled === "boolean";
      process.exit(valid ? 0 : 1);
    ' "$SCOPE_META" 2>/dev/null; then
      scope_valid=true
      scope_features="$(node -e '
        const scope = JSON.parse(require("fs").readFileSync(process.argv[1], "utf8"));
        process.stdout.write(scope.features.join(","));
      ' "$SCOPE_META")"
      scope_identity="$(node -e '
        const scope = JSON.parse(require("fs").readFileSync(process.argv[1], "utf8"));
        process.stdout.write(scope.identity_mode);
      ' "$SCOPE_META")"
      scope_region="$(node -e '
        const scope = JSON.parse(require("fs").readFileSync(process.argv[1], "utf8"));
        process.stdout.write(scope.data_region);
      ' "$SCOPE_META")"
      scope_jwt="$(node -e '
        const scope = JSON.parse(require("fs").readFileSync(process.argv[1], "utf8"));
        process.stdout.write(String(scope.jwt_enabled));
      ' "$SCOPE_META")"
      scope_verification_only="$(node -e '
        const scope = JSON.parse(require("fs").readFileSync(process.argv[1], "utf8"));
        process.stdout.write(String(scope.verification_only===true));
      ' "$SCOPE_META")"
      if [[ ",$scope_features," == *,push-notifications,* ]]; then
        push_required=true
      fi
    fi
  fi

  if [[ -f "$DISCOVERY_META" ]]; then
    discovery_present=true
    [[ "$(file_mode "$DISCOVERY_META")" == 600 ]] && discovery_secure=true
    if node -e '
      const value = JSON.parse(require("fs").readFileSync(process.argv[1], "utf8"));
      const choices=value.feature_choices || {};
      const valid = (!value.features || Array.isArray(value.features)) &&
        Object.values(choices).every(v=>typeof v==="boolean") &&
        (!value.identity_mode || ["email", "user-id", "unknown-user"].includes(value.identity_mode)) &&
        (!value.data_region || ["US", "EU"].includes(value.data_region)) &&
        (typeof value.jwt_enabled === "undefined" || typeof value.jwt_enabled === "boolean");
      process.exit(valid ? 0 : 1);
    ' "$DISCOVERY_META" 2>/dev/null; then
      discovery_valid=true
      discovery_features="$(node -e '
        const value = JSON.parse(require("fs").readFileSync(process.argv[1], "utf8"));
        const map={
          push:"push-notifications",
          events:"event-tracking",
          profiles:"user-profiles",
          "in-app":"in-app-messages",
          inbox:"mobile-inbox",
          embedded:"embedded-messaging",
          "deep-links":"deep-linking"
        };
        const selected=value.features || Object.entries(value.feature_choices || {})
          .filter(([,enabled])=>enabled===true)
          .map(([key])=>map[key])
          .filter(Boolean);
        process.stdout.write([...new Set(["sdk-initialization",...selected])].sort().join(","));
      ' "$DISCOVERY_META")"
      read -r discovery_push discovery_events discovery_profiles discovery_more \
        discovery_in_app discovery_inbox discovery_embedded discovery_deep_links < <(
          node -e '
            const v=JSON.parse(require("fs").readFileSync(process.argv[1],"utf8"));
            let c=v.feature_choices || {};
            if (Array.isArray(v.features)) {
              const has=f=>v.features.includes(f);
              c={
                push:has("push-notifications"),
                events:has("event-tracking"),
                profiles:has("user-profiles"),
                more:false,
                "in-app":has("in-app-messages"),
                inbox:has("mobile-inbox"),
                embedded:has("embedded-messaging"),
                "deep-links":has("deep-linking")
              };
            }
            const show=k=>typeof c[k]==="boolean" ? String(c[k]) : "unset";
            process.stdout.write([
              show("push"),show("events"),show("profiles"),show("more"),show("in-app"),
              show("inbox"),show("embedded"),show("deep-links")
            ].join("\t"));
          ' "$DISCOVERY_META"
        )
      discovery_identity="$(node -e '
        const value = JSON.parse(require("fs").readFileSync(process.argv[1], "utf8"));
        process.stdout.write(String(value.identity_mode || ""));
      ' "$DISCOVERY_META")"
      discovery_region="$(node -e '
        const value = JSON.parse(require("fs").readFileSync(process.argv[1], "utf8"));
        process.stdout.write(String(value.data_region || ""));
      ' "$DISCOVERY_META")"
      discovery_jwt="$(node -e '
        const value = JSON.parse(require("fs").readFileSync(process.argv[1], "utf8"));
        if (typeof value.jwt_enabled === "boolean") process.stdout.write(String(value.jwt_enabled));
      ' "$DISCOVERY_META")"
      [[ -n "$discovery_jwt" ]] && discovery_jwt_present=true
      discovery_jwt_check="$(node -e '
        const value = JSON.parse(require("fs").readFileSync(process.argv[1], "utf8"));
        process.stdout.write(String(value.jwt_check === true));
      ' "$DISCOVERY_META")"
    fi
  fi

  if [[ -f "$ITERABLE_SETUP_META" ]]; then
    iterable_setup_present=true
    [[ "$(file_mode "$ITERABLE_SETUP_META")" == 600 ]] &&
      iterable_setup_secure=true
    if node -e '
      const fs=require("fs");
      const setup=JSON.parse(fs.readFileSync(process.argv[1],"utf8"));
      const scope=JSON.parse(fs.readFileSync(process.argv[2],"utf8"));
      process.exit(
        ["guided","developer","agent"].includes(setup.driver) &&
        setup.data_region===scope.data_region &&
        setup.jwt_enabled===scope.jwt_enabled ? 0 : 1
      );
    ' "$ITERABLE_SETUP_META" "$SCOPE_META" 2>/dev/null; then
      iterable_setup_valid=true
      iterable_setup_driver="$(node -e '
        const value=JSON.parse(require("fs").readFileSync(process.argv[1],"utf8"));
        process.stdout.write(value.driver==="agent" ? "guided" : value.driver);
      ' "$ITERABLE_SETUP_META")"
    fi
  fi

  if [[ -f "$TARGET_META" && -n "$BUNDLE_ID" ]] && node -e '
      const value=JSON.parse(require("fs").readFileSync(process.argv[1],"utf8"));
      process.exit(
        value.bundle_id===process.argv[2] &&
        typeof value.name==="string" && value.name.trim()!=="" ? 0 : 1
      );
    ' "$TARGET_META" "$BUNDLE_ID" 2>/dev/null; then
    target_recorded=true
  fi

  if [[ -f "$APPLE_SETUP_META" ]]; then
    apple_setup_present=true
    [[ "$(file_mode "$APPLE_SETUP_META")" == 600 ]] &&
      apple_setup_secure=true
    if node -e '
      const value=JSON.parse(require("fs").readFileSync(process.argv[1],"utf8"));
      process.exit(
        value.schema_version===1 &&
        value.bundle_id===process.argv[2] &&
        ["existing-ready","guided-manual","team-key"].includes(value.strategy) &&
        typeof value.selected_at==="string" ? 0 : 1
      );
    ' "$APPLE_SETUP_META" "$BUNDLE_ID" 2>/dev/null; then
      apple_setup_valid=true
      apple_setup_strategy="$(node -e '
        const value=JSON.parse(require("fs").readFileSync(process.argv[1],"utf8"));
        process.stdout.write(value.strategy);
      ' "$APPLE_SETUP_META")"
    fi
  fi

  if [[ ( "$apple_setup_strategy" == guided-manual || "$apple_setup_strategy" == team-key ) &&
        -f "$APPLE_GUIDE_META" ]]; then
    apple_guide_steps="$(node -e '
      const value=JSON.parse(require("fs").readFileSync(process.argv[1],"utf8"));
      if (value.bundle_id===process.argv[2] && Array.isArray(value.steps)) {
        process.stdout.write(value.steps.join(",") || "started");
      }
    ' "$APPLE_GUIDE_META" "$BUNDLE_ID" 2>/dev/null)"
    if [[ -n "$apple_guide_steps" ]]; then
      if [[ ",$apple_guide_steps," != *,app-id,* ]]; then apple_guide_next=app-id
      elif [[ ",$apple_guide_steps," != *,push,* ]]; then apple_guide_next=push
      elif [[ ",$apple_guide_steps," != *,apns-key,* ]]; then apple_guide_next=apns-key
      fi
    fi
  fi

  if [[ -f "$APPLE_READINESS_META" ]]; then
    apple_readiness_present=true
    [[ "$(file_mode "$APPLE_READINESS_META")" == 600 ]] &&
      apple_readiness_secure=true
    if node -e '
      const value=JSON.parse(require("fs").readFileSync(process.argv[1],"utf8"));
      const confirmed=value.developer_confirmed || {};
      const checks=value.tool_checks || {};
      const developer=["existing-ready","guided-manual"].includes(value.strategy) &&
        value.evidence_level==="developer_observed" &&
        value.tool_verified===false &&
        confirmed.explicit_bundle_id===true &&
        confirmed.push_capability_enabled===true &&
        confirmed.signing_refreshed===true &&
        confirmed.apns_key_owner_identified===true;
      const tool=value.strategy==="team-key" &&
        value.evidence_level==="tool_verified" &&
        value.tool_verified===true &&
        checks.bundle_id_registered===true &&
        checks.push_capability_enabled===true;
      process.exit(
        value.schema_version===2 &&
        value.bundle_id===process.argv[2] &&
        value.strategy===process.argv[3] &&
        (developer || tool) &&
        typeof value.recorded_at==="string" ? 0 : 1
      );
    ' "$APPLE_READINESS_META" "$BUNDLE_ID" "$apple_setup_strategy" 2>/dev/null; then
      apple_readiness_valid=true
      apple_readiness_evidence="$(node -e 'process.stdout.write(JSON.parse(require("fs").readFileSync(process.argv[1],"utf8")).evidence_level)' "$APPLE_READINESS_META")"
    fi
  fi

  local asc_key_present=false asc_issuer_present=false asc_state="" asc_reason="" asc_actions=""
  if [[ "$apple_setup_strategy" == team-key ]]; then
    [[ -n "$(asc_key_field key_path)" && -f "$(asc_key_field key_path)" ]] && asc_key_present=true
    [[ -n "$(asc_key_field issuer_id)" ]] && asc_issuer_present=true
    if [[ -f "$ASC_READ_META" ]]; then
      IFS=$'\t' read -r asc_state asc_actions asc_reason < <(node -e '
        const value = JSON.parse(require("fs").readFileSync(process.argv[1], "utf8"));
        if (value.fingerprint !== process.argv[2]) { process.stdout.write("stale"); process.exit(0); }
        const state = value.error ? value.error.kind : (value.actions || []).length ? "plan" : "done";
        process.stdout.write([state, (value.actions || []).join(",") || "-",
          value.error ? value.error.reason : "-"].join("\t"));
      ' "$ASC_READ_META" "$(asc_fingerprint)" 2>/dev/null)
    fi
  fi

  if [[ "$scope_valid" == true && "$push_required" != true ]]; then
    apple_evidence_level="not_applicable"
  elif [[ "$apple_readiness_valid" == true ]]; then
    apple_evidence_level="$apple_readiness_evidence"
  fi

  if [[ -f "$APNS_KEY" && -f "$APNS_META" ]]; then
    apns_present=true
    apns_key_id="$(node -e '
      const metadata = JSON.parse(require("fs").readFileSync(process.argv[1], "utf8"));
      process.stdout.write(String(metadata.key_id || ""));
    ' "$APNS_META" 2>/dev/null)"
    apple_team_id="$(node -e '
      const metadata = JSON.parse(require("fs").readFileSync(process.argv[1], "utf8"));
      process.stdout.write(String(metadata.team_id || ""));
    ' "$APNS_META" 2>/dev/null)"
    if valid_apple_id "$apns_key_id" && valid_apple_id "$apple_team_id"; then
      apns_metadata_valid=true
    fi
    if [[ "$(file_mode "$APNS_KEY")" == 600 && "$(file_mode "$APNS_META")" == 600 ]]; then
      apns_secure=true
    fi
    if command -v openssl >/dev/null 2>&1 &&
        openssl pkey -in "$APNS_KEY" -noout -text 2>/dev/null |
          grep -Eq 'ASN1 OID: prime256v1|NIST CURVE: P-256'; then
      apns_private_key_valid=true
    fi
    if [[ -f "$APNS_VALIDATION" && "$apns_private_key_valid" == true ]]; then
      read -r apns_tool_verified apns_rejected apns_classification apns_credentials_valid < <(node -e '
        const [path, hash, keyId, teamId] = process.argv.slice(1);
        const value = JSON.parse(require("fs").readFileSync(path, "utf8"));
        const same = value.key_sha256 === hash && value.key_id === keyId && value.team_id === teamId;
        process.stdout.write([same && value.valid === true, same && value.valid === false,
          same ? value.classification || "-" : "-", same && value.credentials_valid !== false].join(" "));
      ' "$APNS_VALIDATION" "$(apns_key_sha256 "$APNS_KEY")" "$apns_key_id" "$apple_team_id" 2>/dev/null || printf 'false false - false')
      [[ "$apns_rejected" != true ]] ||
        apns_rejection_reason="$(node -e 'process.stdout.write(String(JSON.parse(require("fs").readFileSync(process.argv[1],"utf8")).reason||""))' "$APNS_VALIDATION")"
    fi
  fi

  if [[ -f "$MOBILE_ENV" ]]; then
    [[ "$(file_mode "$MOBILE_ENV")" == 600 ]] && mobile_env_secure=true
    grep -q '^ITERABLE_API_KEY=.\+' "$MOBILE_ENV" 2>/dev/null &&
      mobile_key_present=true
    mobile_key_value="$(sed -n 's/^ITERABLE_API_KEY=//p' "$MOBILE_ENV" | head -1)"
    mobile_region="$(sed -n 's/^ITERABLE_DATA_REGION=//p' "$MOBILE_ENV" | head -1)"
    mobile_jwt="$(sed -n 's/^ITERABLE_JWT_ENABLED=//p' "$MOBILE_ENV" | head -1)"
    if [[ "$mobile_key_present" == true ]]; then
      mobile_key_hash="$(printf '%s' "$mobile_key_value" |
        shasum -a 256 | awk '{print $1}')"
    fi
  fi
  if [[ -f "$MOBILE_XCCONFIG" ]]; then
    mobile_xcconfig_present=true
    [[ "$(file_mode "$MOBILE_XCCONFIG")" == 600 ]] &&
      mobile_xcconfig_secure=true
  fi
  if [[ -f "$MOBILE_VALIDATION" ]]; then
    mobile_validation_present=true
    [[ "$(file_mode "$MOBILE_VALIDATION")" == 600 ]] &&
      mobile_validation_secure=true
    if node -e '
      const value = JSON.parse(require("fs").readFileSync(process.argv[1], "utf8"));
      process.exit(
        value.valid === true &&
        value.server_access_refused === true &&
        typeof value.key_sha256 === "string" &&
        ["US", "EU"].includes(value.data_region) &&
        typeof value.jwt_enabled === "boolean" ? 0 : 1
      );
    ' "$MOBILE_VALIDATION" 2>/dev/null; then
      mobile_validation_hash="$(node -e '
        const value = JSON.parse(require("fs").readFileSync(process.argv[1], "utf8"));
        process.stdout.write(value.key_sha256);
      ' "$MOBILE_VALIDATION")"
      mobile_validation_region="$(node -e '
        const value = JSON.parse(require("fs").readFileSync(process.argv[1], "utf8"));
        process.stdout.write(value.data_region);
      ' "$MOBILE_VALIDATION")"
      mobile_validation_jwt="$(node -e '
        const value = JSON.parse(require("fs").readFileSync(process.argv[1], "utf8"));
        process.stdout.write(String(value.jwt_enabled));
      ' "$MOBILE_VALIDATION")"
      mobile_validation_classification="$(node -e '
        const value = JSON.parse(require("fs").readFileSync(process.argv[1], "utf8"));
        process.stdout.write(String(value.classification || ""));
      ' "$MOBILE_VALIDATION")"
      if [[ "$mobile_validation_secure" == true &&
          "$mobile_validation_hash" == "$mobile_key_hash" &&
          "$mobile_validation_region" == "$mobile_region" &&
          "$mobile_validation_jwt" == "$mobile_jwt" ]]; then
        mobile_validated=true
      fi
    fi
    mobile_rejection_reason="$(rejection_reason "$MOBILE_VALIDATION" "$mobile_key_hash")"
    [[ -z "$mobile_rejection_reason" ]] || mobile_validation_rejected=true
  fi
  if [[ -f "$MOBILE_ENV" ]]; then
    server_key_value="$(sed -n 's/^ITERABLE_SERVER_KEY=//p' "$MOBILE_ENV" | head -1)"
    if [[ -n "$server_key_value" ]]; then
      server_key_present=true
      server_key_hash="$(printf '%s' "$server_key_value" |
        shasum -a 256 | awk '{print $1}')"
    fi
  fi
  if [[ -f "$SERVER_VALIDATION" ]]; then
    server_validation_present=true
    [[ "$(file_mode "$SERVER_VALIDATION")" == 600 ]] &&
      server_validation_secure=true
    if node -e '
      const value = JSON.parse(require("fs").readFileSync(process.argv[1], "utf8"));
      process.exit(
        value.valid === true &&
        typeof value.key_sha256 === "string" &&
        ["US", "EU"].includes(value.data_region) ? 0 : 1
      );
    ' "$SERVER_VALIDATION" 2>/dev/null; then
      server_validation_hash="$(node -e '
        const value = JSON.parse(require("fs").readFileSync(process.argv[1], "utf8"));
        process.stdout.write(value.key_sha256);
      ' "$SERVER_VALIDATION")"
      server_validation_region="$(node -e '
        const value = JSON.parse(require("fs").readFileSync(process.argv[1], "utf8"));
        process.stdout.write(value.data_region);
      ' "$SERVER_VALIDATION")"
      server_validation_classification="$(node -e '
        const value = JSON.parse(require("fs").readFileSync(process.argv[1], "utf8"));
        process.stdout.write(String(value.classification || ""));
      ' "$SERVER_VALIDATION")"
      if [[ "$server_validation_secure" == true &&
          "$server_validation_hash" == "$server_key_hash" &&
          "$server_validation_region" == "$scope_region" ]]; then
        server_validated=true
      fi
    fi
    server_rejection_reason="$(rejection_reason "$SERVER_VALIDATION" "$server_key_hash")"
    [[ -z "$server_rejection_reason" ]] || server_validation_rejected=true
  fi
  unset server_key_value
  if [[ -n "$mobile_key_hash" && "$mobile_key_hash" == "$server_key_hash" ]]; then
    keys_identical=true
    mobile_validated=false
    server_validated=false
    mobile_validation_rejected=true
    mobile_rejection_reason="The Mobile and Server-side slots hold the same key, so at most one of them is right."
  fi

  if [[ -f "$PROOF_TARGET" ]]; then
    proof_target_present=true
    [[ "$(file_mode "$PROOF_TARGET")" == 600 ]] && proof_target_secure=true
    if node -e '
      const value = JSON.parse(require("fs").readFileSync(process.argv[1], "utf8"));
      const mode=value.proof_mode || "behavioral";
      const standard=mode==="behavioral";
      const instrumented=mode==="instrumented";
      const verificationOnly=process.argv[2]==="true";
      const valid = (standard || instrumented) &&
        typeof value.bundle_id === "string" && value.bundle_id.length > 0 &&
        (typeof value.proof_mode === "undefined" ||
          ["behavioral", "instrumented"].includes(value.proof_mode)) &&
        ["email", "user-id"].includes(value.identity_type) &&
        typeof value.identity === "string" && value.identity.length > 0 &&
        (standard ||
          (typeof value.switch_identity === "string" &&
           value.switch_identity.length > 0 &&
           value.switch_identity !== value.identity)) &&
        typeof value.device === "string" &&
        ["simulator", "physical"].includes(value.device_kind) &&
        (value.device_kind !== "simulator" ||
          typeof value.simulator_runtime === "string") &&
        typeof value.app_path === "string" &&
        ((standard && verificationOnly) || value.app_path.length > 0) &&
        ["development", "production"].includes(value.environment) &&
        value.apns_environment ===
          (value.environment === "development" ? "sandbox" : "production") &&
        typeof value.production_follow_up_required === "boolean" &&
        Array.isArray(value.profile_fields) && Array.isArray(value.events) &&
        typeof value.started_at === "string" &&
        typeof value.run_id === "string" && value.run_id.length > 0 &&
        (standard || value.baseline?.identity_exists === false) &&
        (standard || value.baseline?.switch_identity_exists === false) &&
        typeof value.markers?.user_targeted === "string" &&
        (standard || typeof value.markers?.user_targeted_switch === "string") &&
        (standard || typeof value.expectations?.tap_route === "string") &&
        (standard || typeof value.expectations?.logout_switch === "string");
      process.exit(valid ? 0 : 1);
    ' "$PROOF_TARGET" "$scope_verification_only" 2>/dev/null; then
      proof_target_valid=true
      proof_mode="$(node -e 'const v=JSON.parse(require("fs").readFileSync(process.argv[1],"utf8"));process.stdout.write(String(v.proof_mode||"behavioral"))' "$PROOF_TARGET")"
      proof_identity_type="$(node -e 'const v=JSON.parse(require("fs").readFileSync(process.argv[1],"utf8"));process.stdout.write(v.identity_type)' "$PROOF_TARGET")"
      proof_identity="$(node -e 'const v=JSON.parse(require("fs").readFileSync(process.argv[1],"utf8"));process.stdout.write(v.identity)' "$PROOF_TARGET")"
      proof_switch_identity="$(node -e 'const v=JSON.parse(require("fs").readFileSync(process.argv[1],"utf8"));process.stdout.write(String(v.switch_identity||""))' "$PROOF_TARGET")"
      proof_device="$(node -e 'const v=JSON.parse(require("fs").readFileSync(process.argv[1],"utf8"));process.stdout.write(v.device)' "$PROOF_TARGET")"
      proof_device_kind="$(node -e 'const v=JSON.parse(require("fs").readFileSync(process.argv[1],"utf8"));process.stdout.write(v.device_kind)' "$PROOF_TARGET")"
      proof_simulator_runtime="$(node -e 'const v=JSON.parse(require("fs").readFileSync(process.argv[1],"utf8"));process.stdout.write(String(v.simulator_runtime||""))' "$PROOF_TARGET")"
      proof_app_path="$(node -e 'const v=JSON.parse(require("fs").readFileSync(process.argv[1],"utf8"));process.stdout.write(v.app_path)' "$PROOF_TARGET")"
      proof_environment="$(node -e 'const v=JSON.parse(require("fs").readFileSync(process.argv[1],"utf8"));process.stdout.write(v.environment)' "$PROOF_TARGET")"
      proof_apns_environment="$(node -e 'const v=JSON.parse(require("fs").readFileSync(process.argv[1],"utf8"));process.stdout.write(v.apns_environment)' "$PROOF_TARGET")"
      proof_production_follow_up="$(node -e 'const v=JSON.parse(require("fs").readFileSync(process.argv[1],"utf8"));process.stdout.write(String(v.production_follow_up_required))' "$PROOF_TARGET")"
      proof_profile_fields="$(node -e 'const v=JSON.parse(require("fs").readFileSync(process.argv[1],"utf8"));process.stdout.write(v.profile_fields.join(","))' "$PROOF_TARGET")"
      proof_events="$(node -e 'const v=JSON.parse(require("fs").readFileSync(process.argv[1],"utf8"));process.stdout.write(v.events.join(","))' "$PROOF_TARGET")"
      proof_started_at="$(node -e 'const v=JSON.parse(require("fs").readFileSync(process.argv[1],"utf8"));process.stdout.write(v.started_at)' "$PROOF_TARGET")"
      proof_run_id="$(node -e 'const v=JSON.parse(require("fs").readFileSync(process.argv[1],"utf8"));process.stdout.write(v.run_id)' "$PROOF_TARGET")"
      proof_tap_expect="$(node -e 'const v=JSON.parse(require("fs").readFileSync(process.argv[1],"utf8"));process.stdout.write(String(v.expectations?.tap_route||""))' "$PROOF_TARGET")"
      proof_logout_expect="$(node -e 'const v=JSON.parse(require("fs").readFileSync(process.argv[1],"utf8"));process.stdout.write(String(v.expectations?.logout_switch||""))' "$PROOF_TARGET")"
      proof_direct_marker="$(node -e 'const v=JSON.parse(require("fs").readFileSync(process.argv[1],"utf8"));process.stdout.write(String(v.markers?.direct||""))' "$PROOF_TARGET")"
      proof_targeted_marker="$(node -e 'const v=JSON.parse(require("fs").readFileSync(process.argv[1],"utf8"));process.stdout.write(v.markers.user_targeted)' "$PROOF_TARGET")"
      proof_switch_marker="$(node -e 'const v=JSON.parse(require("fs").readFileSync(process.argv[1],"utf8"));process.stdout.write(String(v.markers?.user_targeted_switch||""))' "$PROOF_TARGET")"
    fi
  fi
  if [[ -f "$ITERABLE_APP_META" ]]; then
    iterable_app_present=true
    [[ "$(file_mode "$ITERABLE_APP_META")" == 600 ]] &&
      iterable_app_secure=true
    if node -e '
      const value = JSON.parse(require("fs").readFileSync(process.argv[1], "utf8"));
      process.exit(
        value.bundle_id === process.argv[2] &&
        ["created", "existing"].includes(value.source) &&
        typeof value.recorded_at === "string" ? 0 : 1
      );
    ' "$ITERABLE_APP_META" "$BUNDLE_ID" 2>/dev/null; then
      iterable_app_valid=true
      iterable_app_source="$(node -e '
        const value=JSON.parse(require("fs").readFileSync(process.argv[1],"utf8"));
        process.stdout.write(value.source);
      ' "$ITERABLE_APP_META")"
    fi
  fi

  if [[ -f "$ITERABLE_PUSH_META" ]]; then
    iterable_push_present=true
    [[ "$(file_mode "$ITERABLE_PUSH_META")" == 600 ]] &&
      iterable_push_secure=true
    if node -e '
      const value = JSON.parse(require("fs").readFileSync(process.argv[1], "utf8"));
      process.exit(
        value.bundle_id === process.argv[2] &&
        typeof value.recorded_at === "string" ? 0 : 1
      );
    ' "$ITERABLE_PUSH_META" "$BUNDLE_ID" 2>/dev/null; then
      iterable_push_valid=true
    fi
  fi

  if [[ "$scope_valid" != true || "$scope_secure" != true ]]; then
    next_owner="human"
    if [[ "$discovery_valid" != true ||
          "$discovery_push" == unset || "$discovery_events" == unset ||
          "$discovery_profiles" == unset || "$discovery_deep_links" == unset ||
          "$discovery_more" == unset ]]; then
      next_kind="choose_features"
      next_summary="Ask for the integration scope with one compact multi-select."
    elif [[ "$discovery_more" == true &&
            ( "$discovery_in_app" == unset || "$discovery_inbox" == unset ||
              "$discovery_embedded" == unset ) ]]; then
      next_kind="choose_more_features"
      next_summary="Ask one follow-up multi-select for the additional features."
    elif [[ -z "$discovery_identity" ]]; then
      next_kind="choose_identity"
      next_summary="Ask how the app's existing account model identifies an Iterable user."
    elif [[ -z "$discovery_region" ]]; then
      next_kind="choose_region"
      next_summary="Ask which Iterable project region owns the Mobile API key."
    elif [[ "$discovery_jwt_present" != true && "$discovery_jwt_check" == true ]]; then
      next_kind="check_jwt"
      next_summary="Show where to read the existing Mobile key's Require JWT setting, then record what the developer reads."
    elif [[ "$discovery_jwt_present" != true ]]; then
      next_kind="choose_jwt"
      next_summary="Ask whether the Mobile key a later step creates or picks should require JWT; No JWT is recommended unless the app has a JWT backend."
    else
      next_kind="confirm_scope"
      next_summary="Show the complete proposed scope and record it only after the developer confirms."
    fi
  elif [[ -n "$(missing_tools)" ]]; then
    local missing_tools
    missing_tools="$(missing_tools)"
    next_kind="install_tools"
    next_owner="human"
    next_summary="Install the missing local tools before the selected Iterable integration can be completed: $missing_tools."
  elif [[ "$scope_verification_only" == true &&
          ( "$server_key_present" != true || "$mobile_env_secure" != true ) ]]; then
    next_kind="configure_server"
    next_owner="human"
    next_summary="Capture the dedicated Server-side key needed to read the existing integration and send one marked proof notification. This does not replay Apple, APNs, or app setup."
  elif [[ "$scope_verification_only" == true &&
          "$server_validation_rejected" == true ]]; then
    next_kind="replace_server_key"
    next_owner="human"
    next_summary="The captured Server-side key was rejected: $server_rejection_reason Copy a current Server-side key and replace it."
  elif [[ "$scope_verification_only" == true &&
          "$server_validated" != true ]]; then
    next_kind="validate_server"
    next_owner="tool"
    next_summary="Validate the Server-side key against the recorded Iterable region before verification reads or sends."
  elif [[ "$scope_verification_only" == true ]]; then
    next_kind="verify_app"
    next_owner="tool"
    next_summary="The minimal verification context and Server-side key are ready. Continue the existing-app proof."
  elif [[ "$push_required" == true && "$target_recorded" != true ]]; then
    next_kind="choose_bundle"
    next_owner="human"
    next_summary="Confirm the app's exact, explicit iOS Bundle ID and product name, read from its Xcode build settings."
  elif [[ "$push_required" == true &&
          ( "$apple_setup_valid" != true || "$apple_setup_secure" != true ) ]]; then
    next_kind="choose_apple_setup"
    next_owner="human"
    next_summary="Choose whether to reuse an existing Apple setup, follow a guided Account Holder or Admin handoff, or let an App Store Connect Team key register the App ID and Push Notifications."
  elif [[ "$push_required" == true &&
          "$apple_setup_strategy" == existing-ready &&
          ( "$apple_readiness_valid" != true ||
            "$apple_readiness_secure" != true ) ]]; then
    next_kind="confirm_existing_apple"
    next_owner="human"
    next_summary="Read back the existing Bundle ID, Push Notifications capability, signing, and APNs ownership before recording developer-observed readiness."
  elif [[ "$push_required" == true &&
          "$apple_setup_strategy" == guided-manual &&
          ( "$apple_readiness_valid" != true ||
            "$apple_readiness_secure" != true ) ]]; then
    next_owner="human"
    case "$apple_guide_next" in
      app-id)
        next_kind="apple_step_app_id"
        next_summary="Guided Apple setup, step 1 of 3: register the explicit App ID $BUNDLE_ID in Apple Developer > Identifiers. The developer does the clicks; the selected option records it."
        ;;
      push)
        next_kind="apple_step_push"
        next_summary="Guided Apple setup, step 2 of 3: enable Push Notifications on App ID $BUNDLE_ID and read it back."
        ;;
      apns-key)
        next_kind="apple_step_apns_key"
        next_summary="Guided Apple setup, step 3 of 3: reuse an APNs key whose .p8 is still held, or create and download one."
        ;;
      *)
        next_kind="confirm_manual_apple"
        next_summary="Offer the step-by-step Apple Developer walkthrough (App ID, Push Notifications, APNs key), or record a setup an Account Holder or Admin already finished."
        ;;
    esac
  elif [[ "$push_required" == true &&
          "$apple_setup_strategy" == team-key &&
          ( "$apple_readiness_valid" != true ||
            "$apple_readiness_secure" != true ) ]]; then
    next_owner="human"
    if [[ "$asc_key_present" != true ]]; then
      next_kind="asc_key"
      next_summary="Ask for the path to the App Store Connect Team API key .p8 (not the APNs key)."
    elif [[ "$asc_issuer_present" != true ]]; then
      next_kind="asc_issuer"
      next_summary="Ask for the Issuer ID shown with the App Store Connect Team keys."
    elif [[ "$asc_state" == auth ]]; then
      next_kind="asc_rejected"
      next_summary="$asc_reason"
    elif [[ "$asc_state" == conflict ]]; then
      next_kind="asc_conflict"
      next_summary="$asc_reason"
    elif [[ "$asc_state" == plan ]]; then
      next_kind="asc_plan"
      next_summary="Show the exact App Store Connect changes for $BUNDLE_ID and apply them only after the developer approves."
    else
      next_kind="asc_read"
      next_owner="tool"
      next_summary="Read $BUNDLE_ID and its capabilities from App Store Connect with the Team key. This makes no change."
    fi
  elif [[ "$push_required" == true &&
          "$apple_setup_strategy" == team-key &&
          "$apns_present" != true &&
          ",$apple_guide_steps," != *,apns-key,* ]]; then
    next_kind="apple_step_apns_key"
    next_owner="human"
    next_summary="App Store Connect has the App ID and Push Notifications. The APNs key has no public API: reuse one whose .p8 is still held, or create and download one."
  elif [[ "$push_required" == true &&
          ( "$apns_present" != true || "$apns_secure" != true ||
            "$apns_metadata_valid" != true || "$apns_private_key_valid" != true ) ]]; then
    next_kind="import_apns"
    next_owner="human"
    next_summary="Create or reuse an APNs authentication key in Apple Developer, then import its one-time .p8 download."
  elif [[ "$push_required" == true && "$apns_rejected" == true ]]; then
    next_kind="replace_apns_key"
    next_owner="human"
    next_summary="$apns_rejection_reason Check the key in Apple Developer, then re-import it."
  elif [[ "$push_required" == true && "$apns_tool_verified" != true ]]; then
    next_kind="validate_apns"
    next_owner="tool"
    next_summary="Sign an APNs provider token with the imported key and send one probe to a random device token in the APNs sandbox. BadDeviceToken proves the key, Key ID, and Team ID; it does not check the App ID or Push capability."
  elif [[ "$mobile_key_present" != true || "$mobile_env_secure" != true ||
          "$mobile_xcconfig_present" != true || "$mobile_xcconfig_secure" != true ]]; then
    if [[ "$iterable_setup_valid" == true ]]; then
      next_kind="capture_iterable"
      next_owner="human"
      next_summary="Show the single Mobile-key dashboard step exactly as written. The developer performs the browser clicks; the capture option securely takes the copied key."
    else
      next_kind="configure_iterable"
      next_owner="human"
      next_summary="Offer the guided Mobile-key dashboard step, secure capture for an already copied key, or the terminal handoff."
    fi
  elif [[ "$mobile_validation_rejected" == true ]]; then
    next_kind="replace_mobile_key"
    next_owner="human"
    next_summary="The captured Mobile key was rejected: $mobile_rejection_reason Copy the correct Mobile key and replace it."
  elif [[ "$mobile_validated" != true ]]; then
    next_kind="validate_iterable"
    next_owner="tool"
    next_summary="Prove the captured value authenticates as a Mobile key in the recorded region before editing the app."
  elif [[ "$server_key_present" != true || "$mobile_env_secure" != true ]]; then
    next_kind="configure_server"
    next_owner="human"
    next_summary="Create or select the dedicated Server-side verification key immediately after the Mobile key, then capture it securely."
  elif [[ "$server_validation_rejected" == true ]]; then
    next_kind="replace_server_key"
    next_owner="human"
    next_summary="The captured Server-side key was rejected: $server_rejection_reason Copy a current Server-side key and replace it."
  elif [[ "$server_validated" != true ]]; then
    next_kind="validate_server"
    next_owner="tool"
    next_summary="Prove the captured value authenticates as a Server-side key in the recorded region before application integration."
  elif [[ "$push_required" != true ]]; then
    next_kind="integrate_app"
    next_owner="agent"
    next_summary="Use iterable-ios to wire, build, and test the recorded features with the validated Mobile key. This app-specific edit has no generic tool command. Provisioning has already validated the separate Server-side proof key; after the build passes, run $BIN/ios-verify inspect."
  elif [[ "$iterable_app_valid" != true || "$iterable_app_secure" != true ]]; then
    next_kind="configure_iterable_app"
    next_owner="human"
    next_summary="Guide the developer through creating the matching Iterable iOS mobile app, or explicitly recording that it already exists."
  elif [[ "$iterable_push_valid" != true || "$iterable_push_secure" != true ]]; then
    next_kind="configure_iterable_push"
    next_owner="human"
    next_summary="Guide the developer through adding the recorded APNs credential to the matching Iterable iOS app, then record the read-back."
  else
    next_kind="integrate_app"
    next_owner="agent"
    next_summary="Use iterable-ios to wire, build, and test the recorded features. This app-specific edit has no generic tool command. Provisioning has already validated the separate Server-side proof key; after the build passes, run $BIN/ios-verify inspect."
  fi

  local next_question="null" next_command=""
  case "$next_kind" in
    choose_features|choose_more_features|choose_identity|choose_region|choose_jwt|choose_apple_setup)
      next_question="$(ios_question "$next_kind")"
      next_command="$BIN/ios-provision question --kind $next_kind"
      ;;
    check_jwt)
      next_question="$(ios_question check_jwt "$discovery_region")"
      next_command="$BIN/ios-provision question --kind check_jwt"
      ;;
    confirm_existing_apple|confirm_manual_apple|apple_step_app_id|apple_step_push|apple_step_apns_key)
      next_question="$(ios_question "$next_kind" "$BUNDLE_ID" "$APP_NAME")"
      next_command="$BIN/ios-provision question --kind $next_kind --bundle-id $BUNDLE_ID"
      ;;
    confirm_scope)
      next_question="$(ios_question confirm_scope "$discovery_features" \
        "$discovery_identity" "$discovery_region" "$discovery_jwt")"
      next_command="$BIN/ios-provision question --kind confirm_scope"
      ;;
    configure_iterable)
      next_question="$(ios_question configure_iterable "$scope_region" "$scope_jwt")"
      next_command="$BIN/ios-provision question --kind configure_iterable"
      ;;
    capture_iterable)
      next_question="$(ios_question capture_iterable "$scope_region" "$scope_jwt")"
      next_command="$BIN/ios-provision question --kind capture_iterable"
      ;;
    choose_bundle)
      load_detected_target
      detected_bundle="${BUNDLE_ID:-$(detected_field bundle_id)}"
      detected_name="$(detected_field name "$detected_bundle")"
      detected_source="$(detected_field source)"
      next_question="$(ios_question choose_bundle "$detected_bundle" "$detected_name" "$detected_source")"
      next_command="$BIN/ios-provision question --kind choose_bundle"
      ;;
    install_tools)
      next_question="$(ios_question install_tools "$(missing_tools)")"
      next_command="$BIN/ios-provision question --kind install_tools"
      ;;
    validate_iterable)
      next_command="$BIN/ios-provision validate-mobile"
      ;;
    configure_server)
      next_question="$(ios_question configure_server "$scope_region" "$scope_verification_only")"
      next_command="$BIN/ios-provision question --kind configure_server"
      ;;
    validate_server)
      next_command="$BIN/ios-provision validate-server"
      ;;
    asc_read)
      next_command="$BIN/ios-provision asc-read"
      ;;
    asc_key|asc_issuer|asc_rejected|asc_conflict|asc_plan)
      next_question="$(ios_question "$next_kind" "$BUNDLE_ID" "$asc_reason" "$asc_actions" "$(asc_app_name)")"
      next_command="$BIN/ios-provision question --kind $next_kind"
      ;;
    validate_apns)
      next_command="$BIN/ios-provision validate-apns"
      ;;
    replace_apns_key)
      next_question="$(ios_question replace_apns_key "$apns_rejection_reason" "$apns_key_id" "$apple_team_id" "$apns_classification" "$BUNDLE_ID")"
      next_command="$BIN/ios-provision question --kind replace_apns_key"
      ;;
    replace_mobile_key)
      next_question="$(ios_question replace_mobile_key "$scope_region" "$scope_jwt" "$mobile_rejection_reason")"
      next_command="$BIN/ios-provision question --kind replace_mobile_key"
      ;;
    replace_server_key)
      next_question="$(ios_question replace_server_key "$scope_region" "$server_rejection_reason")"
      next_command="$BIN/ios-provision question --kind replace_server_key"
      ;;
    verify_app)
      next_command="$BIN/ios-verify status"
      ;;
    import_apns)
      load_detected_target
      next_question="$(ios_question import_apns "$(detected_field team_id "$BUNDLE_ID")")"
      next_command="$BIN/ios-provision question --kind import_apns"
      ;;
    configure_iterable_app)
      next_question="$(ios_question configure_iterable_app "$BUNDLE_ID" "$APP_NAME" "$scope_region")"
      next_command="$BIN/ios-provision question --kind configure_iterable_app --bundle-id $BUNDLE_ID"
      ;;
    configure_iterable_push)
      next_question="$(ios_question configure_iterable_push "$BUNDLE_ID" "$scope_region" "$APNS_KEY" "$apns_key_id" "$apple_team_id")"
      next_command="$BIN/ios-provision question --kind configure_iterable_push --bundle-id $BUNDLE_ID"
      ;;
    integrate_app)
      next_command=""
      ;;
  esac

  printf '{'
  printf '"tool":"iterable-ios-provision","contract":4,'
  printf '"workspace":%s,' "$(jstr "$WORKSPACE")"
  printf '"target":{"bundle_id":%s,"name":%s,"recorded":%s,"detected_bundle_id":%s,"detected_name":%s,"detected_source":%s},' \
    "$(jstr "$BUNDLE_ID")" "$(jstr "$APP_NAME")" "$target_recorded" \
    "$(jstr "$detected_bundle")" "$(jstr "$detected_name")" "$(jstr "$detected_source")"
  printf '"scope":{"path":%s,"present":%s,"mode_0600":%s,"valid":%s,"features":%s,"identity_mode":%s,"data_region":%s,"jwt_enabled":%s,"push_required":%s,"verification_only":%s},' \
    "$(jstr "$SCOPE_META")" "$scope_present" "$scope_secure" "$scope_valid" \
    "$(jstr "$scope_features")" "$(jstr "$scope_identity")" \
    "$(jstr "$scope_region")" "$(jstr "$scope_jwt")" "$push_required" \
    "$scope_verification_only"
  printf '"discovery":{"path":%s,"present":%s,"mode_0600":%s,"valid":%s,"features":%s,"identity_mode":%s,"data_region":%s,"jwt_enabled":%s},' \
    "$(jstr "$DISCOVERY_META")" "$discovery_present" "$discovery_secure" \
    "$discovery_valid" "$(jstr "$discovery_features")" \
    "$(jstr "$discovery_identity")" "$(jstr "$discovery_region")" \
    "$(jstr "$discovery_jwt")"
  printf '"tools":{"xcodebuild":%s,"node":%s,"npx":%s,"curl":%s},' \
    "$has_xcode" "$has_node" "$has_npx" "$has_curl"
  printf '"apple_setup":{"path":%s,"present":%s,"mode_0600":%s,"valid":%s,"strategy":%s,"readiness_path":%s,"readiness_present":%s,"readiness_mode_0600":%s,"readiness_valid":%s,"evidence_level":%s,"guide_steps":%s,"guide_next":%s,"asc_key_present":%s,"asc_issuer_present":%s,"asc_state":%s,"asc_actions":%s},' \
    "$(jstr "$APPLE_SETUP_META")" "$apple_setup_present" "$apple_setup_secure" \
    "$apple_setup_valid" "$(jstr "$apple_setup_strategy")" \
    "$(jstr "$APPLE_READINESS_META")" "$apple_readiness_present" \
    "$apple_readiness_secure" "$apple_readiness_valid" \
    "$(jstr "$apple_evidence_level")" \
    "$(jstr "$([[ "$apple_guide_steps" == started ]] || printf '%s' "$apple_guide_steps")")" \
    "$(jstr "$apple_guide_next")" "$asc_key_present" "$asc_issuer_present" \
    "$(jstr "$asc_state")" "$(jstr "$([[ "$asc_actions" == - ]] || printf '%s' "$asc_actions")")"
  printf '"apns":{"key_path":%s,"metadata_path":%s,"present":%s,"mode_0600":%s,"metadata_valid":%s,"private_key_valid":%s,"tool_verified":%s,"rejected":%s,"rejection_reason":%s,"classification":%s,"credentials_valid":%s},' \
    "$(jstr "$APNS_KEY")" "$(jstr "$APNS_META")" "$apns_present" "$apns_secure" \
    "$apns_metadata_valid" "$apns_private_key_valid" "$apns_tool_verified" \
    "$apns_rejected" "$(jstr "$apns_rejection_reason")" \
    "$(jstr "$([[ "$apns_classification" == - ]] || printf '%s' "$apns_classification")")" \
    "$apns_credentials_valid"
  printf '"iterable":{"setup_path":%s,"setup_present":%s,"setup_mode_0600":%s,"setup_valid":%s,"setup_driver":%s,"mobile_env_path":%s,"mobile_xcconfig_path":%s,"mobile_validation_path":%s,"mobile_key_present":%s,"mobile_key_validated":%s,"mode_0600":%s,"xcconfig_present":%s,"xcconfig_mode_0600":%s,"validation_present":%s,"validation_mode_0600":%s,"validation_classification":%s,"server_validation_path":%s,"server_key_present":%s,"server_key_validated":%s,"server_validation_present":%s,"server_validation_mode_0600":%s,"server_validation_classification":%s,"mobile_key_rejected":%s,"mobile_rejection_reason":%s,"server_key_rejected":%s,"server_rejection_reason":%s,"keys_identical":%s,"data_region":%s,"jwt_enabled":%s},' \
    "$(jstr "$ITERABLE_SETUP_META")" "$iterable_setup_present" \
    "$iterable_setup_secure" "$iterable_setup_valid" \
    "$(jstr "$iterable_setup_driver")" \
    "$(jstr "$MOBILE_ENV")" "$(jstr "$MOBILE_XCCONFIG")" \
    "$(jstr "$MOBILE_VALIDATION")" "$mobile_key_present" "$mobile_validated" \
    "$mobile_env_secure" "$mobile_xcconfig_present" \
    "$mobile_xcconfig_secure" "$mobile_validation_present" \
    "$mobile_validation_secure" "$(jstr "$mobile_validation_classification")" \
    "$(jstr "$SERVER_VALIDATION")" "$server_key_present" "$server_validated" \
    "$server_validation_present" "$server_validation_secure" \
    "$(jstr "$server_validation_classification")" \
    "$mobile_validation_rejected" "$(jstr "$mobile_rejection_reason")" \
    "$server_validation_rejected" "$(jstr "$server_rejection_reason")" \
    "$keys_identical" \
    "$(jstr "$mobile_region")" "$(jstr "$mobile_jwt")"
  printf '"proof":{"target_path":%s,"present":%s,"mode_0600":%s,"valid":%s,"proof_mode":%s,"identity_type":%s,"identity":%s,"switch_identity":%s,"device":%s,"device_kind":%s,"simulator_runtime":%s,"app_path":%s,"environment":%s,"apns_environment":%s,"production_follow_up_required":%s,"profile_fields":%s,"events":%s,"started_at":%s,"run_id":%s,"tap_expect":%s,"logout_expect":%s,"direct_marker":%s,"targeted_marker":%s,"switch_marker":%s},' \
    "$(jstr "$PROOF_TARGET")" "$proof_target_present" "$proof_target_secure" \
    "$proof_target_valid" "$(jstr "$proof_mode")" "$(jstr "$proof_identity_type")" \
    "$(jstr "$proof_identity")" "$(jstr "$proof_switch_identity")" \
    "$(jstr "$proof_device")" "$(jstr "$proof_device_kind")" \
    "$(jstr "$proof_simulator_runtime")" "$(jstr "$proof_app_path")" \
    "$(jstr "$proof_environment")" "$(jstr "$proof_apns_environment")" \
    "$proof_production_follow_up" "$(jstr "$proof_profile_fields")" \
    "$(jstr "$proof_events")" "$(jstr "$proof_started_at")" \
    "$(jstr "$proof_run_id")" "$(jstr "$proof_tap_expect")" \
    "$(jstr "$proof_logout_expect")" "$(jstr "$proof_direct_marker")" \
    "$(jstr "$proof_targeted_marker")" "$(jstr "$proof_switch_marker")"
  printf '"iterable_app":{"path":%s,"present":%s,"mode_0600":%s,"recorded_for_target":%s,"source":%s,"read_back_verifiable":false},' \
    "$(jstr "$ITERABLE_APP_META")" "$iterable_app_present" \
    "$iterable_app_secure" "$iterable_app_valid" "$(jstr "$iterable_app_source")"
  printf '"iterable_push":{"path":%s,"present":%s,"mode_0600":%s,"recorded_for_target":%s,"read_back_verifiable":false},' \
    "$(jstr "$ITERABLE_PUSH_META")" "$iterable_push_present" \
    "$iterable_push_secure" "$iterable_push_valid"
  printf '"experimental_apns":{"unsupported_private_api":true,"ruby_ready":%s,"ruby_path":%s,"fastlane_version":%s,"dependencies_ready":%s},' \
    "$has_modern_ruby" "$(jstr "$experimental_ruby")" "$(jstr "$FASTLANE_VERSION")" \
    "$experimental_fastlane"
  printf '"next":{"owner":%s,"kind":%s,"command":%s,"summary":%s,"question":%s}' \
    "$(jstr "$next_owner")" "$(jstr "$next_kind")" \
    "$(jstr "$next_command")" "$(jstr "$next_summary")" "$next_question"
  printf '}\n'
}

rejection_reason() {
  local path="$1" hash="$2"
  [[ -n "$hash" && -f "$path" ]] || return 0
  node -e '
    const value = JSON.parse(require("fs").readFileSync(process.argv[1], "utf8"));
    if (value.valid === false && value.key_sha256 === process.argv[2]) {
      process.stdout.write(String(value.reason || "The key was rejected."));
    }
  ' "$path" "$hash" 2>/dev/null
}

missing_tools() {
  local missing=""
  command -v xcodebuild >/dev/null 2>&1 || missing="${missing:+$missing, }xcodebuild"
  command -v node >/dev/null 2>&1 || missing="${missing:+$missing, }node"
  command -v curl >/dev/null 2>&1 || missing="${missing:+$missing, }curl"
  printf '%s' "$missing"
}

require_ios_next() {
  local action="$1"
  shift
  local status next summary allowed
  status="$(status_json)" ||
    die "$action could not verify the current iOS provisioning state"
  next="$(node -e '
    const status=JSON.parse(process.argv[1]);
    process.stdout.write(String(status.next?.kind || ""));
  ' "$status")"
  summary="$(node -e '
    const status=JSON.parse(process.argv[1]);
    process.stdout.write(String(status.next?.summary || ""));
  ' "$status")"
  for allowed in "$@"; do
    [[ "$next" == "$allowed" ]] && return
  done
  die "$action is out of order: ios-provision status says '$next' is next. $summary Run $BIN/ios-provision status and follow that action; do not skip ahead because a later command can run independently."
}

record_target() {
  [[ "$CONFIRM" == true ]] ||
    die "record-target requires --confirm after selecting the exact application target"
  [[ -n "$BUNDLE_ID" ]] || die "record-target requires --bundle-id"
  if [[ "$APP_NAME_EXPLICIT" != true ]]; then
    load_detected_target
    APP_NAME="$(detected_field name "$BUNDLE_ID")"
  fi
  [[ -n "${APP_NAME//[[:space:]]/}" ]] ||
    die "could not read the product name for $BUNDLE_ID from the Xcode project; rerun with --name '<the app name shown in Xcode>'"
  [[ "$APP_NAME" != *$'\n'* ]] || die "the app name must be one line"
  init_workspace
  local target_changed=false
  if [[ -f "$TARGET_META" ]] &&
      ! node -e '
        const value=JSON.parse(require("fs").readFileSync(process.argv[1],"utf8"));
        process.exit(value.bundle_id===process.argv[2] ? 0 : 1);
      ' "$TARGET_META" "$BUNDLE_ID"; then
    target_changed=true
    rm -f \
      "$APPLE_SETUP_META" \
      "$APPLE_READINESS_META" \
      "$APPLE_GUIDE_META" \
      "$APNS_META" \
      "$APNS_VALIDATION" \
      "$ASC_READ_META" \
      "$ITERABLE_APP_META" \
      "$ITERABLE_PUSH_META" \
      "$PROOF_TARGET" \
      "$PROOF_DISCOVERY_META"
    rm -rf "$WORKSPACE/proof" \
      "$WORKSPACE/sends" \
      "$WORKSPACE/observations" \
      "$WORKSPACE/launches"
  fi
  (
    umask 077
    node -e '
      const fs=require("fs");
      fs.writeFileSync(process.argv[1],JSON.stringify({
        bundle_id:process.argv[2],
        name:process.argv[3]
      },null,2)+"\n",{mode:0o600});
    ' "$TARGET_META" "$BUNDLE_ID" "$APP_NAME"
  )
  chmod 600 "$TARGET_META"
  if [[ "$target_changed" == true ]]; then
    printf 'The Bundle ID changed. Removed incompatible local Apple, APNs, Iterable push, and proof records; no external credential or Apple resource was changed.\n' >&2
  fi
  printf 'Recorded the exact iOS target %s at %s (mode 0600).\n' \
    "$BUNDLE_ID" "$TARGET_META" >&2
  status_json
}

record_apple_setup() {
  [[ "$CONFIRM" == true ]] ||
    die "record-apple-setup requires --confirm after the developer chooses an Apple setup path"
  [[ "$APPLE_STRATEGY" == existing-ready ||
     "$APPLE_STRATEGY" == guided-manual ||
     "$APPLE_STRATEGY" == team-key ]] ||
    die "record-apple-setup requires --strategy existing-ready, guided-manual, or team-key"
  [[ -f "$SCOPE_META" && -f "$TARGET_META" ]] ||
    die "record the integration scope and exact iOS target before choosing an Apple setup path"
  require_ios_next "record-apple-setup" choose_apple_setup

  init_workspace
  (
    umask 077
    node -e '
      const fs=require("fs");
      fs.writeFileSync(process.argv[1],JSON.stringify({
        schema_version:1,
        bundle_id:process.argv[2],
        strategy:process.argv[3],
        selected_at:new Date().toISOString()
      },null,2)+"\n",{mode:0o600});
    ' "$APPLE_SETUP_META" "$BUNDLE_ID" "$APPLE_STRATEGY"
  )
  chmod 600 "$APPLE_SETUP_META"
  rm -f "$APPLE_READINESS_META" "$APPLE_GUIDE_META" "$ASC_READ_META"
  printf 'Recorded Apple setup strategy %s for %s. No Apple resource was read or changed.\n' \
    "$APPLE_STRATEGY" "$BUNDLE_ID" >&2
  status_json
}

clear_apple_setup() {
  [[ "$CONFIRM" == true ]] ||
    die "clear-apple-setup requires --confirm"
  [[ -f "$TARGET_META" ]] || die "record the exact iOS target first"
  rm -f "$APPLE_SETUP_META" "$APPLE_READINESS_META" "$APPLE_GUIDE_META" "$ASC_READ_META"
  printf 'Cleared the local Apple setup selection. No Apple resource was changed.\n' >&2
  status_json
}

record_apple_readiness() {
  [[ "$CONFIRM" == true ]] ||
    die "record-apple-readiness requires --confirm after the Apple values are read back"
  [[ "$APPLE_STRATEGY" == existing-ready ||
     "$APPLE_STRATEGY" == guided-manual ]] ||
    die "record-apple-readiness requires --strategy existing-ready or guided-manual"
  [[ -f "$APPLE_SETUP_META" && -f "$TARGET_META" ]] ||
    die "choose an Apple setup path and exact iOS target first"
  node -e '
    const setup=JSON.parse(require("fs").readFileSync(process.argv[1],"utf8"));
    process.exit(
      setup.bundle_id===process.argv[2] &&
      setup.strategy===process.argv[3] ? 0 : 1
    );
  ' "$APPLE_SETUP_META" "$BUNDLE_ID" "$APPLE_STRATEGY" ||
    die "the Apple readiness strategy does not match the recorded setup path"
  require_ios_next "record-apple-readiness" \
    confirm_existing_apple confirm_manual_apple
  write_apple_readiness record
}

write_apple_readiness() {
  local via="$1"
  init_workspace
  (
    umask 077
    node -e '
      const fs=require("fs");
      fs.writeFileSync(process.argv[1],JSON.stringify({
        schema_version:2,
        bundle_id:process.argv[2],
        strategy:process.argv[3],
        evidence_level:"developer_observed",
        tool_verified:false,
        developer_confirmed:{
          explicit_bundle_id:true,
          push_capability_enabled:true,
          signing_refreshed:true,
          apns_key_owner_identified:true
        },
        via:process.argv[4],
        recorded_at:new Date().toISOString()
      },null,2)+"\n",{mode:0o600});
    ' "$APPLE_READINESS_META" "$BUNDLE_ID" "$APPLE_STRATEGY" "$via"
  )
  chmod 600 "$APPLE_READINESS_META"
  printf 'Recorded developer-observed Apple readiness for %s. This is not API verification or delivery proof.\n' \
    "$BUNDLE_ID" >&2
  status_json
}

record_apple_step() {
  [[ "$CONFIRM" == true ]] ||
    die "record-apple-step requires --confirm after the developer finishes the step"
  local expected
  case "$APPLE_STEP" in
    start) expected=confirm_manual_apple ;;
    app-id) expected=apple_step_app_id ;;
    push) expected=apple_step_push ;;
    apns-key) expected=apple_step_apns_key ;;
    *) die "record-apple-step requires --step start, app-id, push, or apns-key" ;;
  esac
  [[ -f "$APPLE_SETUP_META" && -f "$TARGET_META" ]] ||
    die "choose the guided Apple setup for the exact iOS target first"
  require_ios_next "record-apple-step --step $APPLE_STEP" "$expected"

  init_workspace
  (
    umask 077
    node -e '
      const fs=require("fs");
      const [path,bundle,step]=process.argv.slice(1);
      let value={schema_version:1,bundle_id:bundle,steps:[]};
      if (step!=="start" && fs.existsSync(path)) {
        const current=JSON.parse(fs.readFileSync(path,"utf8"));
        if (current.bundle_id===bundle && Array.isArray(current.steps)) value=current;
      }
      if (step!=="start" && !value.steps.includes(step)) value.steps.push(step);
      value.updated_at=new Date().toISOString();
      fs.writeFileSync(path,JSON.stringify(value,null,2)+"\n",{mode:0o600});
    ' "$APPLE_GUIDE_META" "$BUNDLE_ID" "$APPLE_STEP"
  )
  chmod 600 "$APPLE_GUIDE_META"
  if [[ "$APPLE_STEP" == apns-key ]] &&
      ! node -e 'process.exit(JSON.parse(require("fs").readFileSync(process.argv[1],"utf8")).strategy==="team-key"?0:1)' "$APPLE_SETUP_META"; then
    APPLE_STRATEGY=guided-manual
    write_apple_readiness walkthrough
    return
  fi
  status_json
}

record_iterable_app() {
  [[ "$CONFIRM" == true ]] ||
    die "record-iterable-app requires --confirm after the dashboard app is created or read back"
  [[ -n "$BUNDLE_ID" ]] || die "record-iterable-app requires --bundle-id"
  [[ "$ITERABLE_APP_SOURCE" == created ||
     "$ITERABLE_APP_SOURCE" == existing ]] ||
    die "record-iterable-app requires --source created or existing"
  [[ -f "$TARGET_META" ]] || die "record the exact iOS target first"
  node -e '
    const value=JSON.parse(require("fs").readFileSync(process.argv[1],"utf8"));
    process.exit(value.bundle_id===process.argv[2] ? 0 : 1);
  ' "$TARGET_META" "$BUNDLE_ID" ||
    die "the Iterable iOS app Bundle ID does not match the recorded target"
  require_ios_next "record-iterable-app" configure_iterable_app
  init_workspace
  (
    umask 077
    node -e '
      const fs=require("fs");
      fs.writeFileSync(process.argv[1],JSON.stringify({
        bundle_id:process.argv[2],
        source:process.argv[3],
        recorded_at:new Date().toISOString(),
        read_back_verifiable:false
      },null,2)+"\n",{mode:0o600});
    ' "$ITERABLE_APP_META" "$BUNDLE_ID" "$ITERABLE_APP_SOURCE"
  )
  chmod 600 "$ITERABLE_APP_META"
  printf 'Recorded the Iterable iOS mobile app for %s as %s. Its dashboard state is not independently readable.\n' \
    "$BUNDLE_ID" "$ITERABLE_APP_SOURCE" >&2
  status_json
}

record_iterable_push() {
  [[ "$CONFIRM" == true ]] ||
    die "record-iterable-push requires --confirm after the saved dashboard values are read back"
  [[ -n "$BUNDLE_ID" ]] || die "record-iterable-push requires --bundle-id"
  [[ -f "$TARGET_META" ]] || die "record the exact iOS target first"
  node -e '
    const value=JSON.parse(require("fs").readFileSync(process.argv[1],"utf8"));
    process.exit(value.bundle_id===process.argv[2] ? 0 : 1);
  ' "$TARGET_META" "$BUNDLE_ID" ||
    die "the Iterable iOS app Bundle ID does not match the recorded target"
  require_ios_next "record-iterable-push" configure_iterable_push
  init_workspace
  (
    umask 077
    node -e '
      const fs=require("fs");
      fs.writeFileSync(process.argv[1],JSON.stringify({
        bundle_id:process.argv[2],
        recorded_at:new Date().toISOString(),
        read_back_verifiable:false
      },null,2)+"\n",{mode:0o600});
    ' "$ITERABLE_PUSH_META" "$BUNDLE_ID"
  )
  chmod 600 "$ITERABLE_PUSH_META"
  printf 'Recorded the Iterable APNs credential step for iOS app %s. Delivery is still unproved.\n' \
    "$BUNDLE_ID" >&2
  status_json
}

import_apns() {
  [[ "$CONFIRM" == true ]] || die "import-apns requires --confirm"
  [[ -n "$APNS_SOURCE" ]] || die "import-apns requires --file"
  [[ -f "$APNS_SOURCE" && ! -L "$APNS_SOURCE" ]] || die "APNs key must be a regular, non-symlinked file"
  if [[ -z "$APNS_KEY_ID" && "$(basename "$APNS_SOURCE")" =~ ^AuthKey_([A-Z0-9]{10})\.p8$ ]]; then
    APNS_KEY_ID="${BASH_REMATCH[1]}"
  fi
  if [[ -z "$APPLE_TEAM_ID" ]]; then
    load_detected_target
    APPLE_TEAM_ID="$(detected_field team_id "$BUNDLE_ID")"
  fi
  valid_apple_id "$APNS_KEY_ID" ||
    die "APNs Key ID must be 10 uppercase letters or digits; the file is not named AuthKey_<KEYID>.p8, so pass --key-id"
  valid_apple_id "$APPLE_TEAM_ID" ||
    die "Apple Team ID must be 10 uppercase letters or digits; DEVELOPMENT_TEAM could not be read from the app target, so pass --team-id"
  if [[ "$REPLACE" == true ]]; then
    require_ios_next "import-apns --replace" replace_apns_key validate_apns import_apns integrate_app
  else
    require_ios_next "import-apns" import_apns
  fi

  APNS_SOURCE="$(cd "$(dirname "$APNS_SOURCE")" && pwd -P)/$(basename "$APNS_SOURCE")"
  local project_root tracked_path
  project_root="$(git rev-parse --show-toplevel 2>/dev/null)" || project_root=""
  if [[ -n "$project_root" && "$APNS_SOURCE" == "$project_root/"* ]]; then
    tracked_path="${APNS_SOURCE#"$project_root"/}"
    if git -C "$project_root" ls-files --error-unmatch -- "$tracked_path" >/dev/null 2>&1; then
      die "the APNs key is tracked by Git; move it to secure local storage first"
    fi
  fi

  if command -v openssl >/dev/null 2>&1; then
    openssl pkey -in "$APNS_SOURCE" -noout >/dev/null 2>&1 ||
      die "the APNs file is not a readable private key"
    openssl pkey -in "$APNS_SOURCE" -text -noout 2>/dev/null |
      grep -Eq 'ASN1 OID: prime256v1|NIST CURVE: P-256' ||
      die "the APNs file is not an EC P-256 private key"
  elif ! grep -q '^-----BEGIN PRIVATE KEY-----$' "$APNS_SOURCE"; then
    die "the APNs file does not contain a private-key PEM header"
  fi

  if [[ -n "$APNS_KEY" && "$APNS_KEY" != "$APNS_SOURCE" && "$REPLACE" != true ]]; then
    die "$APNS_META already records a different key path; use --replace only when the replace step offers it"
  fi
  rm -f "$APNS_VALIDATION"

  init_workspace
  chmod 600 "$APNS_SOURCE" || die "could not restrict the APNs key to mode 0600"
  APNS_KEY="$APNS_SOURCE"

  {
    printf '{\n'
    printf '  "key_id": %s,\n' "$(jstr "$APNS_KEY_ID")"
    printf '  "team_id": %s,\n' "$(jstr "$APPLE_TEAM_ID")"
    printf '  "key_path": %s\n' "$(jstr "$APNS_KEY")"
    printf '}\n'
  } > "$APNS_META"
  chmod 600 "$APNS_META"

  printf 'Recorded developer-identified APNs key material at %s (mode 0600); it was not copied or printed. The tool verified EC P-256 key shape, not the Apple service assignment.\n' "$APNS_KEY" >&2
  status_json
}

clip_paste() {
  if command -v pbpaste >/dev/null 2>&1; then
    pbpaste
  elif command -v wl-paste >/dev/null 2>&1; then
    wl-paste --no-newline
  elif command -v xclip >/dev/null 2>&1; then
    xclip -o -selection clipboard
  elif command -v xsel >/dev/null 2>&1; then
    xsel -ob
  else
    return 2
  fi
}

clip_clear() {
  if command -v pbcopy >/dev/null 2>&1; then
    printf '' | pbcopy
  elif command -v wl-copy >/dev/null 2>&1; then
    printf '' | wl-copy
  elif command -v xclip >/dev/null 2>&1; then
    printf '' | xclip -selection clipboard
  elif command -v xsel >/dev/null 2>&1; then
    printf '' | xsel -ib
  fi
}

read_clipboard_key() {
  local clipboard value
  if ! clipboard="$(clip_paste 2>/dev/null)"; then
    die "no supported clipboard command was found"
  fi
  value="${clipboard//$'\r'/}"
  while [[ "$value" == [[:space:]]* ]]; do value="${value#?}"; done
  while [[ "$value" == *[[:space:]] ]]; do value="${value%?}"; done

  [[ -n "$value" ]] || die "the clipboard is empty"
  [[ "$value" != *$'\n'* && "$value" != *[[:space:]]* ]] ||
    die "the clipboard contains more than one key value"
  ((${#value} >= 20)) || die "the clipboard value is too short to be an Iterable API key"
  [[ "$value" =~ ^[A-Za-z0-9._~+/=-]+$ ]] ||
    die "the clipboard value contains characters not expected in an Iterable API key"
  CLIPBOARD_KEY="$value"
}

key_sha256() {
  printf '%s' "$1" | shasum -a 256 | awk '{print $1}'
}

env_value() {
  [[ -f "$MOBILE_ENV" ]] || return 0
  sed -n "s/^$1=//p" "$MOBILE_ENV" | head -1
}

# Receipts hold only a fingerprint, region, and classification; never the key.
write_key_receipt() {
  local path="$1" valid="$2" hash="$3" region="$4" jwt="$5" classification="$6" reason="$7"
  local extra="$8"
  init_workspace
  (
    umask 077
    node -e '
      const [path, valid, hash, region, jwt, classification, reason, extra] =
        process.argv.slice(1);
      const value = {
        valid: valid === "true",
        key_sha256: hash,
        data_region: region
      };
      if (jwt) value.jwt_enabled = jwt === "true";
      value.classification = classification;
      if (reason) value.reason = reason;
      Object.assign(value, extra ? JSON.parse(extra) : {});
      value[valid === "true" ? "validated_at" : "rejected_at"] =
        new Date().toISOString().replace(/\.\d+Z$/, "Z");
      require("fs").writeFileSync(path, JSON.stringify(value, null, 2) + "\n",
        { mode: 0o600 });
    ' "$path" "$valid" "$hash" "$region" "$jwt" "$classification" "$reason" "$extra"
  )
  chmod 600 "$path"
}

capture_mobile() {
  [[ "$CONFIRM" == true ]] || die "capture-mobile requires --confirm"
  [[ "$DATA_REGION" == US || "$DATA_REGION" == EU ]] ||
    die "capture-mobile requires --region US or --region EU"
  [[ "$JWT_ENABLED" == true || "$JWT_ENABLED" == false ]] ||
    die "capture-mobile requires an explicit --jwt-enabled true or false"
  [[ -f "$SCOPE_META" ]] ||
    die "record the integration scope before capturing a Mobile API key"
  node -e '
    const scope = JSON.parse(require("fs").readFileSync(process.argv[1], "utf8"));
    const matches = scope.data_region === process.argv[2] &&
      String(scope.jwt_enabled) === process.argv[3];
    process.exit(matches ? 0 : 1);
  ' "$SCOPE_META" "$DATA_REGION" "$JWT_ENABLED" ||
    die "the Mobile key region or JWT policy does not match the recorded integration scope"

  local existing=false old_mobile server_lines=""
  if [[ -f "$MOBILE_ENV" ]] && grep -q '^ITERABLE_API_KEY=.\+' "$MOBILE_ENV" ||
      [[ -f "$MOBILE_XCCONFIG" ]]; then
    existing=true
  fi
  if [[ "$REPLACE" == true ]]; then
    [[ "$existing" == true ]] ||
      die "there is no captured Mobile key to replace; run capture-mobile without --replace"
    require_ios_next "capture-mobile --replace" replace_mobile_key validate_iterable
  else
    [[ "$existing" != true ]] ||
      die "the ignored iOS workspace already contains Mobile-key configuration; it was not overwritten. Use --replace only when status offers it"
    require_ios_next "capture-mobile" configure_iterable capture_iterable
  fi

  read_clipboard_key
  local value="$CLIPBOARD_KEY"
  CLIPBOARD_KEY=""
  old_mobile="$(env_value ITERABLE_API_KEY)"
  if [[ -n "$old_mobile" && "$value" == "$old_mobile" ]]; then
    unset value old_mobile
    die "the clipboard still holds the Mobile key that was already captured; copy the corrected Mobile key first"
  fi
  if [[ -n "$(env_value ITERABLE_SERVER_KEY)" &&
        "$value" == "$(env_value ITERABLE_SERVER_KEY)" ]]; then
    unset value old_mobile
    die "the clipboard holds the Server-side key already captured; copy the Mobile key instead"
  fi
  unset old_mobile
  [[ ! -f "$MOBILE_ENV" ]] ||
    server_lines="$(grep -E '^(# Read-only verification credential|ITERABLE_SERVER_KEY=)' "$MOBILE_ENV" || true)"

  init_workspace
  (
    umask 077
    {
      printf '# Written by ios-provision capture-mobile. This file is local and ignored.\n'
      printf 'ITERABLE_API_KEY=%s\n' "$value"
      printf 'ITERABLE_DATA_REGION=%s\n' "$DATA_REGION"
      printf 'ITERABLE_JWT_ENABLED=%s\n' "$JWT_ENABLED"
      [[ -z "$server_lines" ]] || printf '\n%s\n' "$server_lines"
    } > "$MOBILE_ENV"
    {
      printf '// Written by ios-provision capture-mobile. Local and ignored.\n'
      printf 'ITERABLE_API_KEY = %s\n' "$value"
      printf 'ITERABLE_DATA_REGION = %s\n' "$DATA_REGION"
      printf 'ITERABLE_JWT_ENABLED = %s\n' "$JWT_ENABLED"
    } > "$MOBILE_XCCONFIG"
  )
  chmod 600 "$MOBILE_ENV" "$MOBILE_XCCONFIG"
  rm -f "$MOBILE_VALIDATION"
  unset value server_lines
  clip_clear

  printf 'Stored the Iterable Mobile API key in %s and %s at mode 0600; the key was not printed.\n' \
    "$MOBILE_ENV" "$MOBILE_XCCONFIG" >&2
  printf 'The clipboard was cleared.\n' >&2
  status_json
}

es256_jwt() {
  local header="$1" claims="$2" key_path="$3"
  node -e '
    const crypto = require("crypto");
    const [header, claims, keyPath] = process.argv.slice(1);
    const b64 = value => Buffer.from(value).toString("base64url");
    const input = `${b64(header)}.${b64(claims)}`;
    const key = crypto.createPrivateKey(require("fs").readFileSync(keyPath));
    const signature = crypto.sign("sha256", Buffer.from(input),
      { key, dsaEncoding: "ieee-p1363" });
    process.stdout.write(`${input}.${signature.toString("base64url")}`);
  ' "$header" "$claims" "$key_path" 2>/dev/null
}

json_reason() {
  printf '%s' "$1" | node -e '
    let input = "";
    process.stdin.on("data", chunk => input += chunk).on("end", () => {
      try {
        const value = JSON.parse(input);
        const error = (value.errors || [])[0] || {};
        process.stdout.write(String(value.reason || error.detail || error.title || error.code || ""));
      } catch {}
    });
  '
}

apns_key_sha256() {
  shasum -a 256 < "$1" | awk '{print $1}'
}

# A push to a random, never-issued device token: APNs authenticates the provider
# token before it looks at the device, so BadDeviceToken proves key, Key ID, and
# Team ID. It proves nothing about the App ID or its Push capability.
validate_apns() {
  command -v node >/dev/null 2>&1 || die "node is not installed"
  command -v curl >/dev/null 2>&1 || die "curl is not installed"
  [[ -f "$APNS_META" && -n "$APNS_KEY" && -f "$APNS_KEY" ]] ||
    die "import the APNs key before validating it"
  [[ -n "$BUNDLE_ID" ]] || die "record the exact iOS target before validating the APNs key"
  require_ios_next "validate-apns" validate_apns replace_apns_key

  local key_id team_id now jwt token out code body reason key_hash
  key_id="$(node -e 'process.stdout.write(String(JSON.parse(require("fs").readFileSync(process.argv[1],"utf8")).key_id||""))' "$APNS_META")"
  team_id="$(node -e 'process.stdout.write(String(JSON.parse(require("fs").readFileSync(process.argv[1],"utf8")).team_id||""))' "$APNS_META")"
  valid_apple_id "$key_id" && valid_apple_id "$team_id" ||
    die "the recorded APNs Key ID or Team ID is malformed; re-import the key"
  now="$(date +%s)"
  jwt="$(es256_jwt "{\"alg\":\"ES256\",\"kid\":\"$key_id\"}" \
    "{\"iss\":\"$team_id\",\"iat\":$now}" "$APNS_KEY")" ||
    die "could not sign an APNs provider token with the recorded .p8"
  token="$(node -e 'process.stdout.write(require("crypto").randomBytes(32).toString("hex"))')"
  out="$(curl_with_secret_header "authorization: bearer $jwt" \
    --http2 -sS -w $'\n%{http_code}' -X POST \
    -H "apns-topic: $BUNDLE_ID" -H 'apns-push-type: alert' -H 'apns-priority: 5' \
    -H 'Content-Type: application/json' -d '{"aps":{"alert":"probe"}}' \
    "https://api.sandbox.push.apple.com/3/device/$token" 2>&1)" || true
  unset jwt
  code="${out##*$'\n'}"
  body="${out%$'\n'*}"
  reason="$(json_reason "$body")"
  key_hash="$(apns_key_sha256 "$APNS_KEY")"

  if [[ "$code" == 400 && "$reason" == BadDeviceToken ]]; then
    write_apns_receipt true "$key_hash" "$key_id" "$team_id" apns-key-accepted "" true
    printf 'APNs accepted the provider token signed with this key, Key ID, and Team ID. This does not check the App ID or its Push Notifications capability.\n' >&2
    status_json
  elif [[ "$reason" == TopicDisallowed || "$reason" == BadTopic ]]; then
    write_apns_receipt false "$key_hash" "$key_id" "$team_id" apns-key-topic-not-allowed \
      "Apple accepted this key, but it isn't allowed to send to $BUNDLE_ID — it may be a topic-restricted key that doesn't include this Bundle ID. Use a Team-scoped APNs key, or add this Bundle ID to the key's topics in Apple Developer → Keys." true
    die "APNs accepted the key, Key ID, and Team ID but refused the topic $BUNDLE_ID ($reason). Run $BIN/ios-provision status for the replace step."
  elif [[ "$code" == 403 && "$reason" == InvalidProviderToken ]]; then
    write_apns_receipt false "$key_hash" "$key_id" "$team_id" rejected \
      "APNs rejected the provider token: the Key ID or Team ID is wrong, or the key was revoked." false
    die "APNs rejected the provider token: the Key ID ($key_id) or Team ID ($team_id) is wrong, or the key was revoked. Run $BIN/ios-provision status for the replace step."
  else
    die "the APNs check was inconclusive (HTTP ${code:-none}${reason:+, $reason}); run $BIN/ios-provision validate-apns again"
  fi
}

write_apns_receipt() {
  local valid="$1" hash="$2" key_id="$3" team_id="$4" classification="$5" reason="$6"
  local credentials_valid="$7"
  init_workspace
  (
    umask 077
    node -e '
      const [path, valid, hash, keyId, teamId, classification, reason, credentials] = process.argv.slice(1);
      const value = {
        valid: valid === "true",
        credentials_valid: credentials === "true",
        key_sha256: hash,
        key_id: keyId,
        team_id: teamId,
        environment: "sandbox",
        classification
      };
      if (credentials === "true") {
        value.proves = "the .p8, Key ID, and Team ID sign an APNs provider token Apple accepts";
        value.does_not_prove = "the App ID, its Push Notifications capability, or delivery";
      }
      if (reason) value.reason = reason;
      value[valid === "true" ? "validated_at" : "rejected_at"] =
        new Date().toISOString().replace(/\.\d+Z$/, "Z");
      require("fs").writeFileSync(path, JSON.stringify(value, null, 2) + "\n", { mode: 0o600 });
    ' "$APNS_VALIDATION" "$valid" "$hash" "$key_id" "$team_id" "$classification" "$reason" "$credentials_valid"
  )
  chmod 600 "$APNS_VALIDATION"
}

valid_issuer_id() {
  [[ "$1" =~ ^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12}$ ]]
}

asc_key_field() {
  [[ -f "$ASC_KEY_META" ]] || return 0
  node -e '
    const value = JSON.parse(require("fs").readFileSync(process.argv[1], "utf8"));
    process.stdout.write(String(value[process.argv[2]] || ""));
  ' "$ASC_KEY_META" "$1" 2>/dev/null
}

asc_fingerprint() {
  printf '%s|%s|%s|%s' "$(asc_key_field key_path)" "$(asc_key_field key_id)" \
    "$(asc_key_field issuer_id)" "$BUNDLE_ID" | shasum -a 256 | awk '{print $1}'
}

asc_app_name() {
  local name="${APP_NAME//[^A-Za-z0-9 ]/}"
  printf '%s' "${name:-App}"
}

# Sets ASC_CODE and ASC_BODY. The signed token travels on curl's stdin, never argv.
asc_call() {
  local method="$1" path="$2" body="${3:-}" key_path key_id issuer now jwt out
  key_path="$(asc_key_field key_path)"
  key_id="$(asc_key_field key_id)"
  issuer="$(asc_key_field issuer_id)"
  now="$(date +%s)"
  jwt="$(es256_jwt "{\"alg\":\"ES256\",\"kid\":\"$key_id\",\"typ\":\"JWT\"}" \
    "{\"iss\":\"$issuer\",\"iat\":$now,\"exp\":$((now + 1200)),\"aud\":\"appstoreconnect-v1\"}" \
    "$key_path")" || die "could not sign an App Store Connect token with the recorded .p8"
  if [[ -n "$body" ]]; then
    out="$(curl_with_secret_header "Authorization: Bearer $jwt" -sS -w $'\n%{http_code}' \
      -X "$method" -H 'Content-Type: application/json' -d "$body" \
      "https://api.appstoreconnect.apple.com$path" 2>&1)" || true
  else
    out="$(curl_with_secret_header "Authorization: Bearer $jwt" -sS -w $'\n%{http_code}' \
      -X "$method" "https://api.appstoreconnect.apple.com$path" 2>&1)" || true
  fi
  unset jwt
  ASC_CODE="${out##*$'\n'}"
  ASC_BODY="${out%$'\n'*}"
}

asc_write_read() {
  local json="$1"
  init_workspace
  (
    umask 077
    printf '%s\n' "$json" > "$ASC_READ_META"
  )
  chmod 600 "$ASC_READ_META"
}

asc_record_error() {
  local kind="$1" reason="$2"
  ASC_ERROR="$reason"
  asc_write_read "$(node -e '
    const [fingerprint, bundle, kind, http, reason] = process.argv.slice(1);
    process.stdout.write(JSON.stringify({
      fingerprint, bundle_id: bundle, error: { kind, http, reason },
      read_at: new Date().toISOString()
    }, null, 2));
  ' "$(asc_fingerprint)" "$BUNDLE_ID" "$kind" "$ASC_CODE" "$reason")"
}

asc_auth_error() {
  local detail
  detail="$(json_reason "$ASC_BODY")"
  if [[ "$ASC_CODE" == 401 ]]; then
    asc_record_error auth "App Store Connect rejected the key (HTTP 401${detail:+: $detail}): the Issuer ID or Key ID is wrong, the key was revoked, or the .p8 is not the App Store Connect key."
  else
    asc_record_error auth "App Store Connect refused the request (HTTP 403${detail:+: $detail}): provisioning needs a Team key with the Admin or App Manager role. Individual keys cannot use provisioning endpoints."
  fi
}

# Sets ASC_RESOURCE_ID, ASC_PLATFORM and ASC_PUSH. Returns 1 after recording an
# authorization error, 2 when the answer was inconclusive.
asc_read_bundle() {
  ASC_RESOURCE_ID="" ASC_PLATFORM="" ASC_PUSH=false
  asc_call GET "/v1/bundleIds?filter%5Bidentifier%5D=$BUNDLE_ID&limit=200"
  case "$ASC_CODE" in
    200) ;;
    401|403) asc_auth_error; return 1 ;;
    *) return 2 ;;
  esac
  read -r ASC_RESOURCE_ID ASC_PLATFORM < <(printf '%s' "$ASC_BODY" | node -e '
    let input = "";
    process.stdin.on("data", chunk => input += chunk).on("end", () => {
      const match = (JSON.parse(input).data || []).find(
        item => item?.attributes?.identifier === process.argv[1]);
      process.stdout.write(match ? `${match.id} ${match.attributes.platform || "UNKNOWN"}` : "");
    });
  ' "$BUNDLE_ID" 2>/dev/null)
  [[ -n "$ASC_RESOURCE_ID" ]] || return 0
  asc_call GET "/v1/bundleIds/$ASC_RESOURCE_ID/bundleIdCapabilities?limit=200"
  case "$ASC_CODE" in
    200) ;;
    401|403) asc_auth_error; return 1 ;;
    *) return 2 ;;
  esac
  printf '%s' "$ASC_BODY" | node -e '
    let input = "";
    process.stdin.on("data", chunk => input += chunk).on("end", () => {
      const found = (JSON.parse(input).data || []).some(
        item => item?.attributes?.capabilityType === "PUSH_NOTIFICATIONS");
      process.exit(found ? 0 : 1);
    });
  ' && ASC_PUSH=true
  return 0
}

asc_actions() {
  local actions=""
  [[ -n "$ASC_RESOURCE_ID" ]] || actions="create-bundle-id"
  [[ "$ASC_PUSH" == true ]] || actions="${actions:+$actions,}enable-push"
  printf '%s' "$actions"
}

write_team_readiness() {
  init_workspace
  (
    umask 077
    node -e '
      const fs=require("fs");
      fs.writeFileSync(process.argv[1],JSON.stringify({
        schema_version:2,
        bundle_id:process.argv[2],
        strategy:"team-key",
        evidence_level:"tool_verified",
        tool_verified:true,
        tool_checks:{bundle_id_registered:true,push_capability_enabled:true},
        bundle_resource_id:process.argv[3],
        via:"app-store-connect-api",
        not_checked:"signing and provisioning profiles",
        recorded_at:new Date().toISOString()
      },null,2)+"\n",{mode:0o600});
    ' "$APPLE_READINESS_META" "$BUNDLE_ID" "$1"
  )
  chmod 600 "$APPLE_READINESS_META"
}

asc_inconclusive() {
  die "App Store Connect gave an inconclusive answer (HTTP ${ASC_CODE:-none}${1:+, $1}); run $BIN/ios-provision $2 again"
}

record_asc_key() {
  [[ "$CONFIRM" == true ]] || die "record-asc-key requires --confirm"
  [[ -f "$APPLE_SETUP_META" ]] &&
    node -e 'process.exit(JSON.parse(require("fs").readFileSync(process.argv[1],"utf8")).strategy==="team-key"?0:1)' "$APPLE_SETUP_META" ||
    die "choose the App Store Connect Team-key path first"
  require_ios_next "record-asc-key" asc_key asc_issuer asc_rejected
  local key_path="" key_id="" issuer=""
  if [[ -n "$APNS_SOURCE" ]]; then
    [[ -f "$APNS_SOURCE" && ! -L "$APNS_SOURCE" ]] ||
      die "the App Store Connect key must be a regular, non-symlinked file"
    key_id="$APNS_KEY_ID"
    if [[ -z "$key_id" && "$(basename "$APNS_SOURCE")" =~ ^AuthKey_([A-Z0-9]{10})\.p8$ ]]; then
      key_id="${BASH_REMATCH[1]}"
    fi
    valid_apple_id "$key_id" ||
      die "the App Store Connect Key ID must be 10 uppercase letters or digits; the file is not named AuthKey_<KEYID>.p8, so pass --key-id"
    key_path="$(cd "$(dirname "$APNS_SOURCE")" && pwd -P)/$(basename "$APNS_SOURCE")"
    local project_root
    project_root="$(git rev-parse --show-toplevel 2>/dev/null)" || project_root=""
    if [[ -n "$project_root" && "$key_path" == "$project_root/"* ]] &&
        git -C "$project_root" ls-files --error-unmatch -- "${key_path#"$project_root"/}" >/dev/null 2>&1; then
      die "the App Store Connect key is tracked by Git; move it to secure local storage first"
    fi
    openssl pkey -in "$key_path" -text -noout 2>/dev/null |
      grep -Eq 'ASN1 OID: prime256v1|NIST CURVE: P-256' ||
      die "the App Store Connect key file is not an EC P-256 private key"
    chmod 600 "$key_path" || die "could not restrict the App Store Connect key to mode 0600"
  fi
  if [[ -n "$ASC_ISSUER_ID" ]]; then
    valid_issuer_id "$ASC_ISSUER_ID" ||
      die "the Issuer ID must look like 57246542-96fe-1a63-e053-0824d011072a"
    issuer="$ASC_ISSUER_ID"
  fi
  [[ -n "$key_path" || -n "$issuer" || "$ANSWER_CLEAR" == true ]] ||
    die "record-asc-key needs --file, --issuer-id, or --clear"
  init_workspace
  (
    umask 077
    node -e '
      const fs = require("fs");
      const [path, keyPath, keyId, issuer, clear] = process.argv.slice(1);
      const value = fs.existsSync(path) ? JSON.parse(fs.readFileSync(path, "utf8")) : {};
      if (keyPath) Object.assign(value, { key_path: keyPath, key_id: keyId });
      if (issuer) value.issuer_id = issuer.toLowerCase();
      if (clear === "true") delete value.issuer_id;
      fs.writeFileSync(path, JSON.stringify(value, null, 2) + "\n", { mode: 0o600 });
    ' "$ASC_KEY_META" "$key_path" "$key_id" "$issuer" "$ANSWER_CLEAR"
  )
  chmod 600 "$ASC_KEY_META"
  rm -f "$ASC_READ_META"
  printf 'Recorded the App Store Connect key reference at %s (mode 0600); the key itself was not copied or printed.\n' "$ASC_KEY_META" >&2
  status_json
}

asc_read() {
  command -v node >/dev/null 2>&1 || die "node is not installed"
  command -v curl >/dev/null 2>&1 || die "curl is not installed"
  require_ios_next "asc-read" asc_read asc_rejected
  local rc=0 actions
  asc_read_bundle || rc=$?
  ((rc != 1)) || die "$ASC_ERROR Run $BIN/ios-provision status for the next step."
  ((rc != 2)) || asc_inconclusive "$(json_reason "$ASC_BODY")" asc-read
  actions="$(asc_actions)"
  asc_write_read "$(node -e '
    const [fingerprint, bundle, id, platform, actions, name] = process.argv.slice(1);
    process.stdout.write(JSON.stringify({
      fingerprint, bundle_id: bundle, bundle_resource_id: id, platform,
      name, actions: actions ? actions.split(",") : [],
      read_at: new Date().toISOString()
    }, null, 2));
  ' "$(asc_fingerprint)" "$BUNDLE_ID" "$ASC_RESOURCE_ID" "$ASC_PLATFORM" "$actions" "$(asc_app_name)")"
  if [[ -z "$actions" ]]; then
    write_team_readiness "$ASC_RESOURCE_ID"
    printf 'App Store Connect already has the explicit App ID %s with Push Notifications; nothing was changed.\n' "$BUNDLE_ID" >&2
  fi
  status_json
}

asc_apply() {
  [[ "$CONFIRM" == true ]] || die "asc-apply requires --confirm after the developer approves the shown plan"
  require_ios_next "asc-apply" asc_plan
  local planned rc=0 actions name
  planned="$(node -e 'process.stdout.write((JSON.parse(require("fs").readFileSync(process.argv[1],"utf8")).actions||[]).join(","))' "$ASC_READ_META")"
  asc_read_bundle || rc=$?
  ((rc != 1)) || die "$ASC_ERROR Run $BIN/ios-provision status for the next step."
  ((rc != 2)) || asc_inconclusive "$(json_reason "$ASC_BODY")" "asc-apply --confirm"
  actions="$(asc_actions)"
  if [[ "$actions" != "$planned" ]]; then
    rm -f "$ASC_READ_META"
    die "App Store Connect changed since the plan was shown (now: ${actions:-nothing to do}); run $BIN/ios-provision status to see the new plan"
  fi
  name="$(asc_app_name)"
  if [[ ",$actions," == *,create-bundle-id,* ]]; then
    asc_call POST /v1/bundleIds "$(node -e '
      process.stdout.write(JSON.stringify({data:{type:"bundleIds",
        attributes:{identifier:process.argv[1],name:process.argv[2],platform:"IOS"}}}));
    ' "$BUNDLE_ID" "$name")"
    case "$ASC_CODE" in
      201)
        ASC_RESOURCE_ID="$(printf '%s' "$ASC_BODY" | node -e '
          let input="";process.stdin.on("data",c=>input+=c).on("end",()=>{
            try{process.stdout.write(String(JSON.parse(input).data.id||""))}catch{}});')"
        ;;
      401|403) asc_auth_error; die "$ASC_ERROR Run $BIN/ios-provision status for the next step." ;;
      409)
        asc_record_error conflict "Apple refused to create $BUNDLE_ID (HTTP 409${ASC_BODY:+: $(json_reason "$ASC_BODY")}): the identifier is registered to another team or is not a valid explicit Bundle ID."
        die "$ASC_ERROR Run $BIN/ios-provision status for the next step."
        ;;
      *) asc_inconclusive "$(json_reason "$ASC_BODY")" "asc-apply --confirm" ;;
    esac
    [[ -n "$ASC_RESOURCE_ID" ]] ||
      die "App Store Connect created $BUNDLE_ID but did not return its id; run $BIN/ios-provision asc-read before changing anything else"
  fi
  if [[ ",$actions," == *,enable-push,* ]]; then
    asc_call POST /v1/bundleIdCapabilities "$(node -e '
      process.stdout.write(JSON.stringify({data:{type:"bundleIdCapabilities",
        attributes:{capabilityType:"PUSH_NOTIFICATIONS"},
        relationships:{bundleId:{data:{type:"bundleIds",id:process.argv[1]}}}}}));
    ' "$ASC_RESOURCE_ID")"
    case "$ASC_CODE" in
      201|409) ;;
      401|403) asc_auth_error; die "$ASC_ERROR Run $BIN/ios-provision status for the next step." ;;
      *) asc_inconclusive "$(json_reason "$ASC_BODY")" asc-read ;;
    esac
  fi
  rc=0
  asc_read_bundle || rc=$?
  ((rc != 1)) || die "$ASC_ERROR Run $BIN/ios-provision status for the next step."
  [[ "$rc" == 0 && -n "$ASC_RESOURCE_ID" && "$ASC_PUSH" == true ]] ||
    asc_inconclusive "the read-back did not show Push Notifications on $BUNDLE_ID" asc-read
  asc_write_read "$(node -e '
    const [fingerprint, bundle, id] = process.argv.slice(1);
    process.stdout.write(JSON.stringify({fingerprint, bundle_id: bundle,
      bundle_resource_id: id, actions: [], applied_at: new Date().toISOString()}, null, 2));
  ' "$(asc_fingerprint)" "$BUNDLE_ID" "$ASC_RESOURCE_ID")"
  write_team_readiness "$ASC_RESOURCE_ID"
  printf 'Registered %s with Push Notifications through App Store Connect and read it back.\n' "$BUNDLE_ID" >&2
  status_json
}

curl_with_secret_header() {
  local header="$1"
  shift
  header="${header//\\/\\\\}"
  header="${header//\"/\\\"}"
  printf 'header = "%s"\n' "$header" | curl -K - "$@"
}

iterable_probe() {
  local key="$1" base="$2" out
  out="$(curl_with_secret_header "Api-Key: $key" \
    -sS -w $'\n%{http_code}' -X POST \
    -H 'Content-Type: application/json' \
    -d '{}' "$base/api/users/registerDeviceToken" 2>&1)" || true
  PROBE_CODE="${out##*$'\n'}"
  PROBE_BODY="${out%$'\n'*}"
}

server_probe() {
  local key="$1" base="$2" out
  out="$(curl_with_secret_header "Api-Key: $key" \
    -sS -w $'\n%{http_code}' "$base/api/channels" 2>&1)" || true
  PROBE_CODE="${out##*$'\n'}"
  PROBE_BODY="${out%$'\n'*}"
}

reject_mobile_key() {
  local hash="$1" region="$2" jwt="$3" reason="$4"
  write_key_receipt "$MOBILE_VALIDATION" false "$hash" "$region" "$jwt" \
    rejected "$reason" ""
  die "$reason Copy the correct Mobile key, then run $BIN/ios-provision capture-mobile --replace --region $region --jwt-enabled $jwt --confirm"
}

validate_mobile() {
  command -v node >/dev/null 2>&1 || die "node is not installed"
  command -v curl >/dev/null 2>&1 || die "curl is not installed"
  [[ -f "$SCOPE_META" && -f "$MOBILE_ENV" ]] ||
    die "capture the Mobile API key after recording scope before validating it"
  [[ "$(file_mode "$MOBILE_ENV")" == 600 ]] ||
    die "the Mobile API-key file is not mode 0600"
  require_ios_next "validate-mobile" validate_iterable replace_mobile_key

  local key region jwt base real_code real_body control_code control_body
  local classification key_hash server_key
  key="$(env_value ITERABLE_API_KEY)"
  region="$(env_value ITERABLE_DATA_REGION)"
  jwt="$(env_value ITERABLE_JWT_ENABLED)"
  [[ -n "$key" ]] || die "the captured Mobile API key is empty"
  [[ "$region" == US || "$region" == EU ]] ||
    die "the captured Mobile API key has no valid region"
  [[ "$jwt" == true || "$jwt" == false ]] ||
    die "the captured Mobile API key has no explicit JWT policy"
  node -e '
    const scope = JSON.parse(require("fs").readFileSync(process.argv[1], "utf8"));
    process.exit(
      scope.data_region === process.argv[2] &&
      String(scope.jwt_enabled) === process.argv[3] ? 0 : 1
    );
  ' "$SCOPE_META" "$region" "$jwt" ||
    die "the captured Mobile key no longer matches the confirmed region or JWT policy"

  key_hash="$(key_sha256 "$key")"
  server_key="$(env_value ITERABLE_SERVER_KEY)"
  if [[ -n "$server_key" && "$server_key" == "$key" ]]; then
    unset key server_key
    reject_mobile_key "$key_hash" "$region" "$jwt" \
      "The Mobile and Server-side slots hold the same key, so at most one of them is right."
  fi
  unset server_key

  if [[ "$region" == EU ]]; then
    base="https://api.eu.iterable.com"
  else
    base="https://api.iterable.com"
  fi

  iterable_probe "$key" "$base"
  real_code="$PROBE_CODE"
  real_body="$PROBE_BODY"
  iterable_probe "itbl-ios-deliberately-invalid-key" "$base"
  control_code="$PROBE_CODE"
  control_body="$PROBE_BODY"

  case "$control_code" in
    401|403) ;;
    *)
      unset key
      die "the invalid control key answered HTTP $control_code, so this probe cannot distinguish a working credential"
      ;;
  esac

  if [[ "$jwt" == false ]]; then
    case "$real_code" in
      400) classification="authenticated-mobile-key" ;;
      *)
        unset key real_body control_body
        reject_mobile_key "$key_hash" "$region" "$jwt" \
          "The Mobile-key probe answered HTTP $real_code; the key type, region, or credential is wrong."
        ;;
    esac
  else
    if [[ "$real_code" =~ ^(401|403)$ ]] &&
        grep -Eqi 'InvalidJwtPayload|JWT' <<< "$real_body" &&
        ! grep -Eqi 'InvalidJwtPayload|JWT' <<< "$control_body"; then
      classification="jwt-protected-mobile-key"
    else
      unset key real_body control_body
      reject_mobile_key "$key_hash" "$region" "$jwt" \
        "The JWT-protected Mobile-key probe was not distinguishable from an invalid credential."
    fi
  fi

  # Iterable refuses a Mobile key on /api/channels with "insufficient
  # privileges" (verified live); a 200 means a Server-side key.
  server_probe "$key" "$base"
  unset key real_body control_body
  if [[ "$PROBE_CODE" == 401 ]] &&
      grep -qi 'insufficient privileges' <<< "$PROBE_BODY"; then
    :
  elif [[ "$PROBE_CODE" == 200 ]]; then
    reject_mobile_key "$key_hash" "$region" "$jwt" \
      "This key can read the project's channel list, which a Mobile key cannot: a Server-side key was captured in the Mobile slot."
  elif [[ -z "$PROBE_CODE" || "$PROBE_CODE" == 000 || "$PROBE_CODE" == 5?? ]]; then
    die "the Mobile-key privilege check could not reach Iterable (HTTP ${PROBE_CODE:-none}); run validate-mobile again"
  else
    reject_mobile_key "$key_hash" "$region" "$jwt" \
      "Iterable answered HTTP $PROBE_CODE to the Mobile-key privilege check instead of the insufficient-privileges refusal a Mobile key gets, so this key is not validated."
  fi

  write_key_receipt "$MOBILE_VALIDATION" true "$key_hash" "$region" "$jwt" \
    "$classification" "" '{"server_access_refused":true}'
  printf 'Validated the captured Iterable Mobile API key for %s without printing it.\n' \
    "$region" >&2
  status_json
}

capture_server() {
  [[ "$CONFIRM" == true ]] ||
    die "capture-server requires --confirm after creating or selecting the dedicated Server-side verification API key"
  [[ -f "$SCOPE_META" ]] ||
    die "record the integration or verification scope before preparing verification"
  if [[ ! -f "$MOBILE_ENV" ]]; then
    local verification_only
    verification_only="$(node -e '
      const v=JSON.parse(require("fs").readFileSync(process.argv[1],"utf8"));
      process.stdout.write(String(v.verification_only===true));
    ' "$SCOPE_META")"
    [[ "$verification_only" == true ]] ||
      die "capture the Mobile API key before preparing verification"
    init_workspace
    (
      umask 077
      printf '# Verification-only credential file; never linked into the app.\n' \
        > "$MOBILE_ENV"
    )
    chmod 600 "$MOBILE_ENV"
  fi
  [[ "$(file_mode "$MOBILE_ENV")" == 600 ]] ||
    die "the iOS credential file is not mode 0600"
  local existing=false old_server
  grep -q '^ITERABLE_SERVER_KEY=.\+' "$MOBILE_ENV" 2>/dev/null && existing=true
  if [[ "$REPLACE" == true ]]; then
    [[ "$existing" == true ]] ||
      die "there is no captured Server-side key to replace; run capture-server --confirm"
  else
    [[ "$existing" != true ]] ||
      die "the ignored iOS workspace already contains a Server-side key; it was not overwritten. To rotate it, copy the new key and run $BIN/ios-provision capture-server --replace --confirm"
    require_ios_next "capture-server" configure_server
  fi

  read_clipboard_key
  local value="$CLIPBOARD_KEY"
  CLIPBOARD_KEY=""
  old_server="$(env_value ITERABLE_SERVER_KEY)"
  if [[ -n "$old_server" && "$value" == "$old_server" ]]; then
    unset value old_server
    die "the clipboard still holds the Server-side key that was already captured; copy the new key first"
  fi
  unset old_server
  if [[ -n "$(env_value ITERABLE_API_KEY)" &&
        "$value" == "$(env_value ITERABLE_API_KEY)" ]]; then
    unset value
    die "the clipboard holds the Mobile key already captured; copy the Server-side key instead"
  fi

  local kept
  kept="$(grep -Ev '^(# Read-only verification credential|ITERABLE_SERVER_KEY=)' "$MOBILE_ENV")"
  (
    umask 077
    {
      printf '%s\n' "$kept"
      printf '\n# Read-only verification credential; never linked into the app.\n'
      printf 'ITERABLE_SERVER_KEY=%s\n' "$value"
    } > "$MOBILE_ENV"
  )
  chmod 600 "$MOBILE_ENV"
  rm -f "$SERVER_VALIDATION"
  unset value kept
  clip_clear

  printf 'Stored the Iterable Server-side verification key in %s at mode 0600; the key was not printed.\n' \
    "$MOBILE_ENV" >&2
  printf 'The clipboard was cleared.\n' >&2
  status_json
}

reject_server_key() {
  local hash="$1" region="$2" reason="$3"
  write_key_receipt "$SERVER_VALIDATION" false "$hash" "$region" "" \
    rejected "$reason" ""
  die "$reason Copy a current Server-side key, then run $BIN/ios-provision capture-server --replace --confirm"
}

validate_server() {
  command -v node >/dev/null 2>&1 || die "node is not installed"
  command -v curl >/dev/null 2>&1 || die "curl is not installed"
  [[ -f "$SCOPE_META" && -f "$MOBILE_ENV" ]] ||
    die "record the integration or verification scope and capture the verification key before validating it"
  [[ "$(file_mode "$MOBILE_ENV")" == 600 ]] ||
    die "the iOS credential file is not mode 0600"

  local key region base real_code real_body control_code key_hash mobile_key
  key="$(env_value ITERABLE_SERVER_KEY)"
  region="$(node -e '
    const scope = JSON.parse(require("fs").readFileSync(process.argv[1], "utf8"));
    process.stdout.write(String(scope.data_region || ""));
  ' "$SCOPE_META")"
  [[ -n "$key" ]] ||
    die "no Server-side verification key has been captured; run $BIN/ios-provision question --kind configure_server"
  [[ "$region" == US || "$region" == EU ]] ||
    die "the recorded integration scope has no valid Iterable region"
  [[ "$region" == EU ]] &&
    base="https://api.eu.iterable.com" ||
    base="https://api.iterable.com"

  key_hash="$(key_sha256 "$key")"
  mobile_key="$(env_value ITERABLE_API_KEY)"
  if [[ -n "$mobile_key" && "$mobile_key" == "$key" ]]; then
    unset key mobile_key
    reject_server_key "$key_hash" "$region" \
      "The Mobile and Server-side slots hold the same key, so at most one of them is right."
  fi
  unset mobile_key

  server_probe "$key" "$base"
  real_code="$PROBE_CODE"
  real_body="$PROBE_BODY"
  server_probe "itbl-ios-deliberately-invalid-server-key" "$base"
  control_code="$PROBE_CODE"
  unset key

  case "$control_code" in
    401|403) ;;
    *)
      die "the invalid Server-side control key answered HTTP $control_code, so this probe cannot distinguish a working credential"
      ;;
  esac
  if [[ "$real_code" != 200 ]] ||
      ! printf '%s' "$real_body" | node -e '
        let input = "";
        process.stdin.on("data", chunk => input += chunk).on("end", () => {
          try {
            const value = JSON.parse(input);
            process.exit(Array.isArray(value.channels) ? 0 : 1);
          } catch {
            process.exit(1);
          }
        });
      '; then
    unset real_body
    reject_server_key "$key_hash" "$region" \
      "The Server-side key probe answered HTTP $real_code without the project's channel list; the key type, region, or credential is wrong, or the key was rotated or deleted."
  fi
  unset real_body

  write_key_receipt "$SERVER_VALIDATION" true "$key_hash" "$region" "" \
    authenticated-server-key "" ""
  printf 'Validated the Iterable Server-side verification key for %s without printing it.\n' \
    "$region" >&2
  status_json
}

json_array_from_args() {
  if (($# == 0)); then
    printf '[]'
    return
  fi
  printf '%s\0' "$@" | node -e '
    let input = Buffer.alloc(0);
    process.stdin.on("data", chunk => input = Buffer.concat([input, chunk]));
    process.stdin.on("end", () => {
      const values = input.toString("utf8").split("\0").filter(Boolean);
      process.stdout.write(JSON.stringify([...new Set(values)]));
    });
  '
}

proof_user_exists() {
  local key="$1" region="$2" identity_type="$3" identity="$4"
  local base encoded path out code body
  [[ "$region" == EU ]] &&
    base="https://api.eu.iterable.com" ||
    base="https://api.iterable.com"
  encoded="$(node -e 'process.stdout.write(encodeURIComponent(process.argv[1]))' "$identity")"
  if [[ "$identity_type" == email ]]; then
    path="/api/users/getByEmail?email=$encoded"
  else
    path="/api/users/byUserId/$encoded"
  fi
  out="$(curl_with_secret_header "Api-Key: $key" \
    -sS -w $'\n%{http_code}' "$base$path" 2>&1)" || true
  code="${out##*$'\n'}"
  body="${out%$'\n'*}"
  case "$code" in
    200)
      printf 'true'
      ;;
    400)
      if grep -Eqi 'no user exists|not found' <<< "$body"; then
        printf 'false'
      else
        die "Iterable rejected the baseline lookup for a proof identity"
      fi
      ;;
    401|403)
      die "Iterable rejected the Server-side key while checking the proof baseline"
      ;;
    *)
      die "proof baseline lookup returned HTTP $code"
      ;;
  esac
}

record_proof() {
  [[ "$CONFIRM" == true ]] ||
    die "record-proof requires --confirm after reviewing the test identity and expected behavior"
  if [[ -f "$PROOF_TARGET" && "$RESTART_PROOF" != true ]]; then
    die "a proof run already exists; use $BIN/ios-prepare-proof restart --confirm to create a fresh run without mixing receipts"
  fi
  local flag_identity="$PROOF_IDENTITY" flag_device="$PROOF_DEVICE" flag_app_path="$PROOF_APP_PATH"
  if [[ "$FROM_ANSWERS" == true ]]; then
    [[ -f "$PROOF_DISCOVERY_META" ]] || printf '{}\n' > "$PROOF_DISCOVERY_META"
    BUNDLE_ID="$(node -e '
      const fs=require("fs");
      const v=JSON.parse(fs.readFileSync(process.argv[1],"utf8"));
      let bundle=String(v.bundle_id||"");
      if (!bundle && fs.existsSync(process.argv[2])) {
        bundle=String(JSON.parse(fs.readFileSync(process.argv[2],"utf8")).bundle_id||"");
      }
      process.stdout.write(bundle);
    ' "$PROOF_DISCOVERY_META" "$TARGET_META")"
    PROOF_MODE="$(node -e '
      const v=JSON.parse(require("fs").readFileSync(process.argv[1],"utf8"));
      process.stdout.write(String(v.proof_mode||"behavioral"));
    ' "$PROOF_DISCOVERY_META")"
    DATA_REGION="$(node -e '
      const v=JSON.parse(require("fs").readFileSync(process.argv[1],"utf8"));
      process.stdout.write(String(v.data_region||""));
    ' "$PROOF_DISCOVERY_META")"
    PROOF_IDENTITY_TYPE="$(node -e '
      const v=JSON.parse(require("fs").readFileSync(process.argv[1],"utf8"));
      process.stdout.write(String(v.identity_type||""));
    ' "$PROOF_DISCOVERY_META")"
    if [[ -z "$PROOF_IDENTITY_TYPE" && -f "$SCOPE_META" ]]; then
      PROOF_IDENTITY_TYPE="$(node -e '
        const v=JSON.parse(require("fs").readFileSync(process.argv[1],"utf8"));
        process.stdout.write(v.identity_mode==="unknown-user" ? "" : v.identity_mode);
      ' "$SCOPE_META")"
    fi
    PROOF_IDENTITY="$(node -e 'const v=JSON.parse(require("fs").readFileSync(process.argv[1],"utf8"));process.stdout.write(String(v.identity||""))' "$PROOF_DISCOVERY_META")"
    PROOF_SWITCH_IDENTITY="$(node -e 'const v=JSON.parse(require("fs").readFileSync(process.argv[1],"utf8"));process.stdout.write(String(v.switch_identity||""))' "$PROOF_DISCOVERY_META")"
    PROOF_DEVICE="$(node -e 'const v=JSON.parse(require("fs").readFileSync(process.argv[1],"utf8"));process.stdout.write(String(v.device||""))' "$PROOF_DISCOVERY_META")"
    PROOF_APP_PATH="$(node -e 'const v=JSON.parse(require("fs").readFileSync(process.argv[1],"utf8"));process.stdout.write(String(v.app_path||""))' "$PROOF_DISCOVERY_META")"
    PROOF_ENVIRONMENT="$(node -e 'const v=JSON.parse(require("fs").readFileSync(process.argv[1],"utf8"));process.stdout.write(String(v.environment||""))' "$PROOF_DISCOVERY_META")"
    PROOF_TAP_EXPECT="$(node -e 'const v=JSON.parse(require("fs").readFileSync(process.argv[1],"utf8"));process.stdout.write(String(v.tap_expect||""))' "$PROOF_DISCOVERY_META")"
    PROOF_LOGOUT_EXPECT="$(node -e 'const v=JSON.parse(require("fs").readFileSync(process.argv[1],"utf8"));process.stdout.write(String(v.logout_expect||""))' "$PROOF_DISCOVERY_META")"
    local proposed_profile proposed_event
    proposed_profile="$(node -e 'const v=JSON.parse(require("fs").readFileSync(process.argv[1],"utf8"));process.stdout.write(String(v.profile_field||""))' "$PROOF_DISCOVERY_META")"
    proposed_event="$(node -e 'const v=JSON.parse(require("fs").readFileSync(process.argv[1],"utf8"));process.stdout.write(String(v.event||""))' "$PROOF_DISCOVERY_META")"
    [[ -z "$proposed_profile" ]] || PROOF_PROFILE_FIELDS=("$proposed_profile")
    [[ -z "$proposed_event" ]] || PROOF_EVENTS=("$proposed_event")
    [[ -z "$flag_identity" ]] || PROOF_IDENTITY="$flag_identity"
    [[ -z "$flag_device" ]] || PROOF_DEVICE="$flag_device"
    [[ -z "$flag_app_path" ]] || PROOF_APP_PATH="$flag_app_path"
    if [[ -z "$PROOF_DEVICE" && "$PROOF_MODE" == behavioral ]]; then
      PROOF_DEVICE="$(node -e '
        const list=JSON.parse(process.argv[1]);
        process.stdout.write(list.length===1 ? String(list[0].id) : "");
      ' "$(proof_devices_json "" true "$(proof_min_os "$BUNDLE_ID" "$PROOF_APP_PATH")")")"
    fi
    if [[ -z "$DATA_REGION" && ! -f "$SCOPE_META" && -f "$SERVER_VALIDATION" ]]; then
      DATA_REGION="$(node -e '
        const v=JSON.parse(require("fs").readFileSync(process.argv[1],"utf8"));
        process.stdout.write(v.valid===true ? String(v.data_region||"") : "");
      ' "$SERVER_VALIDATION" 2>/dev/null)"
    fi
    if [[ ! -f "$SCOPE_META" ]]; then
      local verification_root
      verification_root="$(verification_project_root)"
      [[ -n "$BUNDLE_ID" ]] ||
        BUNDLE_ID="$(verification_detect_bundle "$verification_root")"
      [[ -n "$PROOF_IDENTITY_TYPE" ]] ||
        PROOF_IDENTITY_TYPE="$(verification_detect_identity "$verification_root")"
    fi
  fi
  [[ "$PROOF_MODE" == behavioral || "$PROOF_MODE" == instrumented ]] ||
    die "record-proof requires --proof-mode behavioral or --proof-mode instrumented"
  [[ -n "$BUNDLE_ID" ]] || die "record-proof requires --bundle-id"
  [[ "$PROOF_IDENTITY_TYPE" == email || "$PROOF_IDENTITY_TYPE" == user-id ]] ||
    die "record-proof requires --identity-type email or --identity-type user-id"
  [[ -n "$PROOF_IDENTITY" ]] || die "record-proof requires --identity"
  if [[ "$PROOF_MODE" == instrumented ]]; then
    [[ -n "$PROOF_SWITCH_IDENTITY" ]] ||
      die "instrumented proof requires a distinct --switch-identity for logout/account isolation"
    [[ "$PROOF_IDENTITY" != "$PROOF_SWITCH_IDENTITY" ]] ||
      die "the initial and switch proof identities must be different"
  fi
  local identity_value value app_path
  for identity_value in "$PROOF_IDENTITY" ${PROOF_SWITCH_IDENTITY:+"$PROOF_SWITCH_IDENTITY"}; do
    [[ "$identity_value" != *$'\n'* && "$identity_value" != *$'\t'* ]] ||
      die "proof identities must each be one line"
  done
  if [[ "$PROOF_IDENTITY_TYPE" == email &&
      ! "$PROOF_IDENTITY" =~ ^[^@[:space:]]+@[^@[:space:]]+\.[A-Za-z]{2,}$ ]]; then
    die "the proof identity must be an email address"
  fi
  if [[ "$PROOF_MODE" == instrumented && "$PROOF_IDENTITY_TYPE" == email &&
      ! "$PROOF_SWITCH_IDENTITY" =~ ^[^@[:space:]]+@[^@[:space:]]+\.[A-Za-z]{2,}$ ]]; then
    die "the switch proof identity must be an email address"
  fi
  if [[ -z "$PROOF_ENVIRONMENT" && -n "$PROOF_DEVICE" ]] && is_booted_simulator "$PROOF_DEVICE"; then
    PROOF_ENVIRONMENT=development
  fi
  [[ "$PROOF_ENVIRONMENT" == development || "$PROOF_ENVIRONMENT" == production ]] ||
    die "record-proof --environment must be development or production"
  [[ "$PROOF_DEVICE" != *$'\n'* && "$PROOF_DEVICE" != *$'\t'* ]] ||
    die "the device identifier must be one line"
  [[ -n "$PROOF_DEVICE" ]] ||
    die "record-proof requires --device for the iPhone or booted Simulator that will run the app"
  local verification_only_scope=false
  if [[ -f "$SCOPE_META" ]]; then
    verification_only_scope="$(node -e '
      const v=JSON.parse(require("fs").readFileSync(process.argv[1],"utf8"));
      process.stdout.write(String(v.verification_only===true));
    ' "$SCOPE_META" 2>/dev/null || printf false)"
  else
    verification_only_scope=true
  fi
  if [[ "$PROOF_MODE" == behavioral ]]; then
    # A standard verification deliberately ignores stale benchmark answers. This
    # matters when a developer switches back from an instrumented draft.
    PROOF_SWITCH_IDENTITY=""
    PROOF_PROFILE_FIELDS=()
    PROOF_EVENTS=()
    PROOF_TAP_EXPECT=""
    PROOF_LOGOUT_EXPECT=""
  fi
  app_path=""
  if [[ -n "$PROOF_APP_PATH" ]]; then
    [[ -d "$PROOF_APP_PATH" && "$PROOF_APP_PATH" == *.app ]] ||
      die "record-proof --app-path must name an existing .app bundle"
    app_path="$(cd "$PROOF_APP_PATH" && pwd -P)"
  elif [[ "$PROOF_MODE" == instrumented ]]; then
    die "this proof requires --app-path for the exact application build being verified"
  fi
  if [[ "$PROOF_MODE" == instrumented && -z "$PROOF_LOGOUT_EXPECT" ]]; then
    die "instrumented proof requires --logout-expect for the visible neutral or User B state"
  fi
  for value in "$PROOF_TAP_EXPECT" "$PROOF_LOGOUT_EXPECT"; do
    [[ -n "$value" ]] || continue
    [[ "$value" != *$'\n'* && "$value" != *$'\t'* ]] ||
      die "tap and logout expectations must each be one line"
    ((${#value} <= 160)) || die "tap and logout expectations must be at most 160 characters"
  done

  if [[ ! -f "$SCOPE_META" ]]; then
    [[ "$PROOF_MODE" == behavioral ]] ||
      die "instrumented proof requires a confirmed integration scope"
    [[ "$DATA_REGION" == US || "$DATA_REGION" == EU ]] ||
      die "standard verification requires the Iterable project region"
    local verification_features verification_jwt project_root
    project_root="$(verification_project_root)"
    verification_features="$(verification_detect_features "$project_root")"
    verification_jwt="$(verification_detect_jwt "$project_root")"
    init_workspace
    (
      umask 077
      node -e '
        const fs=require("fs");
        fs.writeFileSync(process.argv[1],JSON.stringify({
          features:JSON.parse(process.argv[2]),
          identity_mode:process.argv[3],
          data_region:process.argv[4],
          jwt_enabled:process.argv[5]==="true",
          verification_only:true,
          source:"existing-integration-inspection",
          recorded_at:new Date().toISOString()
        },null,2)+"\n",{mode:0o600});
      ' "$SCOPE_META" "$verification_features" "$PROOF_IDENTITY_TYPE" \
        "$DATA_REGION" "$verification_jwt"
    )
    chmod 600 "$SCOPE_META"
  fi

  local scope_identity scope_region scope_features push_required=false
  local profile_json event_json server_key server_hash validation_hash
  local initial_exists switch_exists run_id marker_suffix archive_dir=""
  local device_kind simulator_runtime="" apns_environment
  local production_follow_up_required=false simulators
  scope_identity="$(node -e '
    const scope = JSON.parse(require("fs").readFileSync(process.argv[1], "utf8"));
    process.stdout.write(String(scope.identity_mode || ""));
  ' "$SCOPE_META")"
  scope_region="$(node -e '
    const scope = JSON.parse(require("fs").readFileSync(process.argv[1], "utf8"));
    process.stdout.write(String(scope.data_region || ""));
  ' "$SCOPE_META")"
  scope_features="$(node -e '
    const scope = JSON.parse(require("fs").readFileSync(process.argv[1], "utf8"));
    process.stdout.write((scope.features || []).join(","));
  ' "$SCOPE_META")"
  [[ ",$scope_features," == *,push-notifications,* ]] && push_required=true
  if is_booted_simulator "$PROOF_DEVICE"; then
    device_kind=simulator
    simulators="$(xcrun simctl list devices --json 2>/dev/null || printf '{}')"
    simulator_runtime="$(ios_simulator_device_runtime "$simulators" "$PROOF_DEVICE")" ||
      die "the selected Simulator runtime could not be identified"
    if [[ "$push_required" == true ]]; then
      [[ "$PROOF_ENVIRONMENT" == development ]] ||
        die "iOS Simulator supports APNs sandbox proof only; use development or select a physical production target"
      ios_simulator_host_supports_apns ||
        die "this Mac/Xcode combination is not eligible for real APNs Simulator delivery"
      ios_simulator_device_supports_apns "$simulators" "$PROOF_DEVICE" ||
        die "the selected Simulator must be available and use an iOS 16+ runtime"
    fi
  elif is_connected_physical_device "$PROOF_DEVICE"; then
    device_kind=physical
  else
    die "the selected proof device is neither a booted Simulator nor a connected physical iPhone"
  fi
  [[ "$PROOF_ENVIRONMENT" == development ]] &&
    apns_environment=sandbox || apns_environment=production
  if [[ "$push_required" == true && "$PROOF_ENVIRONMENT" == development ]]; then
    production_follow_up_required=true
  fi
  if [[ "$scope_identity" != unknown-user &&
      "$scope_identity" != "$PROOF_IDENTITY_TYPE" ]]; then
    die "the proof identity type does not match the recorded $scope_identity integration"
  fi
  if [[ "$PROOF_MODE" == instrumented && "$push_required" == true ]]; then
    [[ -n "$PROOF_TAP_EXPECT" ]] ||
      die "push proof requires --tap-expect for the visible destination after a real tap"
  fi
  profile_json='[]'
  event_json='[]'
  if ((${#PROOF_PROFILE_FIELDS[@]} > 0)); then
    for value in "${PROOF_PROFILE_FIELDS[@]}"; do
      [[ "$value" != *$'\n'* && "$value" != *$'\t'* ]] ||
        die "profile fields must each be one line"
      [[ -n "$value" ]] || die "profile fields cannot be empty"
    done
    profile_json="$(json_array_from_args "${PROOF_PROFILE_FIELDS[@]}")"
  fi
  if ((${#PROOF_EVENTS[@]} > 0)); then
    for value in "${PROOF_EVENTS[@]}"; do
      [[ "$value" != *$'\n'* && "$value" != *$'\t'* ]] ||
        die "event names must each be one line"
      [[ -n "$value" ]] || die "event names cannot be empty"
    done
    event_json="$(json_array_from_args "${PROOF_EVENTS[@]}")"
  fi

  initial_exists=null
  switch_exists=null
  if [[ "$PROOF_MODE" == instrumented ]]; then
    [[ -f "$MOBILE_ENV" && "$(file_mode "$MOBILE_ENV")" == 600 ]] ||
      die "capture the Server-side verification key before recording instrumented proof"
    [[ -f "$SERVER_VALIDATION" && "$(file_mode "$SERVER_VALIDATION")" == 600 ]] ||
      die "validate the Server-side verification key before recording instrumented proof"
    server_key="$(sed -n 's/^ITERABLE_SERVER_KEY=//p' "$MOBILE_ENV" | head -1)"
    [[ -n "$server_key" ]] || die "no Server-side verification key has been captured"
    server_hash="$(printf '%s' "$server_key" | shasum -a 256 | awk '{print $1}')"
    validation_hash="$(node -e '
      const v=JSON.parse(require("fs").readFileSync(process.argv[1],"utf8"));
      process.stdout.write(
        v.valid===true && v.data_region===process.argv[2]
          ? String(v.key_sha256 || "") : ""
      );
    ' "$SERVER_VALIDATION" "$scope_region" 2>/dev/null)"
    [[ -n "$validation_hash" && "$validation_hash" == "$server_hash" ]] ||
      die "the Server-side key has not been validated for the recorded region"

    initial_exists="$(proof_user_exists "$server_key" "$scope_region" \
      "$PROOF_IDENTITY_TYPE" "$PROOF_IDENTITY")"
    switch_exists="$(proof_user_exists "$server_key" "$scope_region" \
      "$PROOF_IDENTITY_TYPE" "$PROOF_SWITCH_IDENTITY")"
    unset server_key
    [[ "$initial_exists" == false ]] ||
      die "the initial proof identity already exists; use a fresh test identity so app identification is causal"
    [[ "$switch_exists" == false ]] ||
      die "the switch proof identity already exists; use a fresh User B identity so account switching is causal"
  fi

  run_id="$(node -e 'process.stdout.write(require("crypto").randomUUID())')"
  marker_suffix="$(node -e 'process.stdout.write(require("crypto").randomBytes(6).toString("hex").toUpperCase())')"

  init_workspace
  local target_tmp
  target_tmp="$(mktemp "$WORKSPACE/.proof-target.XXXXXX")" ||
    die "could not create a secure proof target candidate"
  chmod 600 "$target_tmp"
  (
    umask 077
    node -e '
      const fs = require("fs");
      const target = {
        proof_mode: process.argv[2],
        bundle_id: process.argv[3],
        identity_type: process.argv[4],
        identity: process.argv[5],
        switch_identity: process.argv[6],
        device: process.argv[7],
        device_kind: process.argv[8],
        simulator_runtime: process.argv[9] || null,
        app_path: process.argv[10],
        environment: process.argv[11],
        apns_environment: process.argv[12],
        production_follow_up_required: process.argv[13] === "true",
        profile_fields: JSON.parse(process.argv[14]),
        events: JSON.parse(process.argv[15]),
        run_id: process.argv[16],
        baseline: {
          identity_exists: process.argv[20]==="null" ? null : process.argv[20]==="true",
          switch_identity_exists: process.argv[21]==="null" ? null : process.argv[21]==="true",
          checked_at: new Date().toISOString()
        },
        markers: {
          user_targeted: process.argv[2]==="instrumented"
            ? `ITBL-IOS-USER-A-${process.argv[17]}`
            : `ITBL-IOS-PROOF-${process.argv[17]}`,
          user_targeted_switch: process.argv[2]==="instrumented"
            ? `ITBL-IOS-USER-B-${process.argv[17]}`
            : null
        },
        expectations: {
          tap_route: process.argv[18],
          logout_switch: process.argv[19]
        },
        started_at: new Date().toISOString()
      };
      fs.writeFileSync(process.argv[1], JSON.stringify(target, null, 2) + "\n", {
        mode: 0o600
      });
    ' "$target_tmp" "$PROOF_MODE" "$BUNDLE_ID" "$PROOF_IDENTITY_TYPE" "$PROOF_IDENTITY" \
      "$PROOF_SWITCH_IDENTITY" "$PROOF_DEVICE" "$device_kind" \
      "$simulator_runtime" "$app_path" "$PROOF_ENVIRONMENT" \
      "$apns_environment" "$production_follow_up_required" "$profile_json" \
      "$event_json" "$run_id" "$marker_suffix" "$PROOF_TAP_EXPECT" \
      "$PROOF_LOGOUT_EXPECT" "$initial_exists" "$switch_exists"
  ) || {
    rm -f "$target_tmp"
    die "could not write the proof target candidate"
  }
  if [[ "$RESTART_PROOF" == true ]]; then
    local run_state old_run_id archive_root archive_tmp archive_name
    old_run_id="$(node -e '
      const v=JSON.parse(require("fs").readFileSync(process.argv[1],"utf8"));
      process.stdout.write(String(v.run_id||"unknown-run").replace(/[^A-Za-z0-9._-]/g,"-"));
    ' "$PROOF_TARGET")"
    archive_root="$WORKSPACE/archive"
    archive_name="$(date -u +%Y%m%dT%H%M%SZ)-$old_run_id-$(node -e 'process.stdout.write(require("crypto").randomBytes(4).toString("hex"))')"
    archive_tmp="$archive_root/.archive-$archive_name"
    archive_dir="$archive_root/$archive_name"
    mkdir -p "$archive_tmp" || {
      rm -f "$target_tmp"
      die "could not create a secure archive for the previous proof run"
    }
    chmod 700 "$archive_root" "$archive_tmp"
    cp -p "$PROOF_TARGET" "$archive_tmp/proof-target.json" || {
      rm -rf "$archive_tmp"
      rm -f "$target_tmp"
      die "could not archive the previous proof target"
    }
    for run_state in \
      "$WORKSPACE/launches" \
      "$WORKSPACE/sends" \
      "$WORKSPACE/proof" \
      "$WORKSPACE/observations"; do
      case "$run_state" in
        "$WORKSPACE"/launches|"$WORKSPACE"/sends|"$WORKSPACE"/proof|"$WORKSPACE"/observations) ;;
        *)
          rm -rf "$archive_tmp"
          rm -f "$target_tmp"
          die "refusing to archive an unexpected proof-state path"
          ;;
      esac
      if [[ -e "$run_state" ]]; then
        cp -pR "$run_state" "$archive_tmp/$(basename "$run_state")" || {
          rm -rf "$archive_tmp"
          rm -f "$target_tmp"
          die "could not archive the previous run-scoped proof evidence"
        }
      fi
    done
    mv "$archive_tmp" "$archive_dir" || {
      rm -rf "$archive_tmp"
      rm -f "$target_tmp"
      die "could not activate the previous proof-run archive"
    }
    chmod 700 "$archive_dir"
    rm -rf \
      "$WORKSPACE/launches" \
      "$WORKSPACE/sends" \
      "$WORKSPACE/proof" \
      "$WORKSPACE/observations" || {
        rm -f "$target_tmp"
        die "could not activate a clean run after archiving the previous evidence"
      }
  fi
  mv -f "$target_tmp" "$PROOF_TARGET" ||
    die "could not activate the fresh proof target"
  chmod 600 "$PROOF_TARGET"
  if [[ "$RESTART_PROOF" == true ]]; then
    if [[ "$PROOF_MODE" == instrumented ]]; then
      printf 'Restarted instrumented proof with fresh User A/User B baselines, run ID, and markers at %s (mode 0600). Archived the previous target, launch, send, proof, and observation evidence at %s; no outcome was marked as passed.\n' \
        "$PROOF_TARGET" "$archive_dir" >&2
    else
      printf 'Restarted standard proof for the same app identity with a fresh run ID and marker at %s (mode 0600). Archived the previous run at %s. No app was uninstalled or reinstalled.\n' \
        "$PROOF_TARGET" "$archive_dir" >&2
    fi
  else
    if [[ "$PROOF_MODE" == instrumented ]]; then
      printf 'Recorded fresh User A/User B baselines and generated exact proof markers at %s (mode 0600). No outcome was marked as passed.\n' \
        "$PROOF_TARGET" >&2
    else
      printf 'Recorded the existing app identity and generated one targeted proof marker at %s (mode 0600). No outcome was marked as passed.\n' \
        "$PROOF_TARGET" >&2
    fi
  fi
  rm -f "$PROOF_DISCOVERY_META"
  proof_started_json "$device_kind" "$push_required"
}

proof_started_json() {
  local device_kind="$1" push_required="$2" kind=verify command="$BIN/ios-verify status"
  local summary="The proof run is recorded. The verifier reads Iterable and the device next."
  if [[ "$PROOF_MODE" == behavioral && "$device_kind" == simulator && "$push_required" == true ]]; then
    kind=prove_push
    command="$BIN/ios-prove --confirm"
    summary="The proof run is recorded. ios-prove checks the Simulator and Iterable, sends one marked push, and reads the Simulator's own records for it; then run ios-verify status."
  fi
  printf '{"tool":"iterable-ios-proof-setup","contract":3,"recorded":true,"workspace":%s,"proof_target":%s,' \
    "$(jstr "$WORKSPACE")" "$(jstr "$PROOF_TARGET")"
  printf '"proof":%s,' "$(node -e '
    const v=JSON.parse(require("fs").readFileSync(process.argv[1],"utf8"));
    process.stdout.write(JSON.stringify({
      valid:true,
      proof_mode:v.proof_mode, bundle_id:v.bundle_id,
      identity_type:v.identity_type, identity:v.identity, switch_identity:v.switch_identity||"",
      device:v.device, device_kind:v.device_kind, simulator_runtime:v.simulator_runtime||null,
      app_path:v.app_path||"", environment:v.environment, apns_environment:v.apns_environment,
      production_follow_up_required:v.production_follow_up_required===true,
      profile_fields:v.profile_fields||[], events:v.events||[],
      tap_expect:v.expectations?.tap_route||"", logout_expect:v.expectations?.logout_switch||"",
      run_id:v.run_id, started_at:v.started_at
    }));
  ' "$PROOF_TARGET")"
  printf '"next":{"owner":"tool","kind":%s,"command":%s,"summary":%s}}\n' \
    "$(jstr "$kind")" "$(jstr "$command")" "$(jstr "$summary")"
}

restart_proof() {
  [[ "$CONFIRM" == true ]] ||
    die "restart-proof requires --confirm because it replaces the active proof run and archives its local evidence"
  [[ -f "$PROOF_TARGET" ]] || die "restart-proof requires an existing proof-target.json"
  [[ "$(file_mode "$PROOF_TARGET")" == 600 ]] ||
    die "restart-proof requires proof-target.json to be mode 0600"
  command -v node >/dev/null 2>&1 || die "node is not installed"

  PROOF_MODE="$(node -e '
    const v=JSON.parse(require("fs").readFileSync(process.argv[1],"utf8"));
    process.stdout.write(String(v.proof_mode||"behavioral"));
  ' "$PROOF_TARGET")"
  BUNDLE_ID="$(node -e 'const v=JSON.parse(require("fs").readFileSync(process.argv[1],"utf8"));process.stdout.write(String(v.bundle_id||""))' "$PROOF_TARGET")"
  PROOF_IDENTITY_TYPE="$(node -e 'const v=JSON.parse(require("fs").readFileSync(process.argv[1],"utf8"));process.stdout.write(String(v.identity_type||""))' "$PROOF_TARGET")"
  local requested_device="$PROOF_DEVICE"
  PROOF_DEVICE="$(node -e 'const v=JSON.parse(require("fs").readFileSync(process.argv[1],"utf8"));process.stdout.write(String(v.device||""))' "$PROOF_TARGET")"
  [[ -z "$requested_device" ]] || PROOF_DEVICE="$requested_device"
  PROOF_APP_PATH="$(node -e 'const v=JSON.parse(require("fs").readFileSync(process.argv[1],"utf8"));process.stdout.write(String(v.app_path||""))' "$PROOF_TARGET")"
  PROOF_ENVIRONMENT="$(node -e 'const v=JSON.parse(require("fs").readFileSync(process.argv[1],"utf8"));process.stdout.write(String(v.environment||""))' "$PROOF_TARGET")"
  if [[ -n "$requested_device" ]] && is_booted_simulator "$requested_device"; then
    PROOF_ENVIRONMENT=development
  fi
  PROOF_TAP_EXPECT="$(node -e 'const v=JSON.parse(require("fs").readFileSync(process.argv[1],"utf8"));process.stdout.write(String(v.expectations?.tap_route||""))' "$PROOF_TARGET")"
  PROOF_LOGOUT_EXPECT="$(node -e 'const v=JSON.parse(require("fs").readFileSync(process.argv[1],"utf8"));process.stdout.write(String(v.expectations?.logout_switch||""))' "$PROOF_TARGET")"
  while IFS= read -r value; do
    [[ -z "$value" ]] || PROOF_PROFILE_FIELDS+=("$value")
  done < <(node -e '
    const v=JSON.parse(require("fs").readFileSync(process.argv[1],"utf8"));
    for (const value of v.profile_fields||[]) console.log(String(value));
  ' "$PROOF_TARGET")
  while IFS= read -r value; do
    [[ -z "$value" ]] || PROOF_EVENTS+=("$value")
  done < <(node -e '
    const v=JSON.parse(require("fs").readFileSync(process.argv[1],"utf8"));
    for (const value of v.events||[]) console.log(String(value));
  ' "$PROOF_TARGET")

  if [[ "$PROOF_MODE" == instrumented ]]; then
    local fresh_identities
    fresh_identities="$(node -e '
      const type=process.argv[1];
      const previous=process.argv[2];
      const suffix=`${Date.now()}-${require("crypto").randomBytes(4).toString("hex")}`;
      if (type==="email") {
        const at=previous.lastIndexOf("@");
        const domain=at>0 ? previous.slice(at+1) : "example.com";
        process.stdout.write(
          `iterable-ios-proof-a-${suffix}@${domain}\t` +
          `iterable-ios-proof-b-${suffix}@${domain}`
        );
      } else {
        process.stdout.write(
          `iterable-ios-proof-a-${suffix}\titerable-ios-proof-b-${suffix}`
        );
      }
    ' "$PROOF_IDENTITY_TYPE" \
      "$(node -e 'const v=JSON.parse(require("fs").readFileSync(process.argv[1],"utf8"));process.stdout.write(String(v.identity||""))' "$PROOF_TARGET")")" ||
      die "could not generate fresh proof identities"
    IFS=$'\t' read -r PROOF_IDENTITY PROOF_SWITCH_IDENTITY <<< "$fresh_identities"
  else
    PROOF_IDENTITY="$(node -e '
      const v=JSON.parse(require("fs").readFileSync(process.argv[1],"utf8"));
      process.stdout.write(String(v.identity||""));
    ' "$PROOF_TARGET")"
    PROOF_SWITCH_IDENTITY=""
  fi

  RESTART_PROOF=true
  FROM_ANSWERS=false
  record_proof
}

modern_ruby() {
  local candidate
  for candidate in \
    "${IOS_EXPERIMENTAL_RUBY:-}" \
    /opt/homebrew/opt/ruby/"bin"/ruby \
    /usr/local/opt/ruby/"bin"/ruby \
    "$(command -v ruby 2>/dev/null)"; do
    [[ -n "$candidate" && -x "$candidate" ]] || continue
    "$candidate" -e 'print RUBY_VERSION' >/dev/null 2>&1 || continue
    if "$candidate" -e 'exit Gem::Version.new(RUBY_VERSION) >= Gem::Version.new("3.1") ? 0 : 1' \
        >/dev/null 2>&1; then
      printf '%s' "$candidate"
      return
    fi
  done
  return 1
}

experimental_gem_home() {
  printf '%s/tools/fastlane-%s' "$WORKSPACE" "$FASTLANE_VERSION"
}

experimental_fastlane_ready() {
  local gem_home
  gem_home="$(experimental_gem_home)"
  [[ -f "$gem_home/specifications/fastlane-$FASTLANE_VERSION.gemspec" ]]
}

require_experimental() {
  [[ "$EXPERIMENTAL" == true ]] ||
    die "$COMMAND requires --experimental because it uses unsupported Apple private APIs"
}

experimental_apns_install() {
  require_experimental
  [[ "$CONFIRM" == true ]] ||
    die "experimental-apns-install requires --confirm before downloading pinned dependencies"

  local ruby_bin gem_bin gem_home
  ruby_bin="$(modern_ruby)" ||
    die "experimental APNs automation requires Ruby 3.1 or newer"
  gem_bin="$(dirname "$ruby_bin")/gem"
  [[ -x "$gem_bin" ]] || die "could not find gem next to $ruby_bin"
  gem_home="$(experimental_gem_home)"

  init_workspace
  mkdir -p "$gem_home/bin"
  if ! experimental_fastlane_ready; then
    mkdir -p "$gem_home/spec-cache"
    GEM_HOME="$gem_home" GEM_PATH="$gem_home" \
      GEM_SPEC_CACHE="$gem_home/spec-cache" \
      "$gem_bin" install fastlane \
        --version "$FASTLANE_VERSION" \
        --install-dir "$gem_home" \
        --bindir "$gem_home/bin" \
        --no-document ||
      die "could not install Fastlane $FASTLANE_VERSION into the ignored iOS workspace"
  fi

  GEM_HOME="$gem_home" GEM_PATH="$gem_home" \
    "$ruby_bin" -e '
      gem "fastlane", ARGV.fetch(0)
      require "spaceship"
      abort("unexpected Fastlane version") unless Gem.loaded_specs.fetch("fastlane").version.to_s == ARGV.fetch(0)
    ' "$FASTLANE_VERSION" ||
    die "Fastlane $FASTLANE_VERSION was not loadable after installation"

  printf '{"tool":"iterable-ios-provision","contract":1,"experimental":true,"unsupported_private_api":true,"fastlane_version":%s,"dependencies_ready":true}\n' \
    "$(jstr "$FASTLANE_VERSION")"
}

run_private_apns_actor() {
  local ruby_bin gem_home
  ruby_bin="$(modern_ruby)" ||
    die "experimental APNs automation requires Ruby 3.1 or newer"
  experimental_fastlane_ready ||
    die "run experimental-apns-install --experimental --confirm first"
  [[ -f "$PRIVATE_APNS_ACTOR" ]] || die "missing private APNs actor: $PRIVATE_APNS_ACTOR"
  gem_home="$(experimental_gem_home)"

  GEM_HOME="$gem_home" GEM_PATH="$gem_home" PATH="$gem_home/bin:$PATH" \
    "$ruby_bin" "$PRIVATE_APNS_ACTOR" "$@"
}

experimental_apns_auth() {
  require_experimental
  [[ -t 0 && -t 1 ]] ||
    die "experimental-apns-auth must be run by the developer in an interactive terminal for password and 2FA prompts"
  [[ -n "$APPLE_ID" ]] || die "experimental-apns-auth requires --apple-id"
  if [[ -n "$APPLE_TEAM_ID" ]] && ! valid_apple_id "$APPLE_TEAM_ID"; then
    die "experimental-apns-auth --team-id must be 10 uppercase letters or digits"
  fi

  local -a actor_args
  local result selected_team
  actor_args=(auth --apple-id "$APPLE_ID")
  if [[ -n "$APPLE_TEAM_ID" ]]; then
    actor_args+=(--team-id "$APPLE_TEAM_ID")
  fi
  result="$(run_private_apns_actor "${actor_args[@]}")" || exit $?
  selected_team="$(node -e '
    const result = JSON.parse(process.argv[1]);
    process.stdout.write(String(result.team_id || ""));
  ' "$result")"
  valid_apple_id "$selected_team" ||
    die "Apple authentication did not resolve one valid team ID"

  init_workspace
  (
    umask 077
    {
      printf '{\n'
      printf '  "apple_id": %s,\n' "$(jstr "$APPLE_ID")"
      printf '  "team_id": %s\n' "$(jstr "$selected_team")"
      printf '}\n'
    } > "$APPLE_WEB_META"
  )
  chmod 600 "$APPLE_WEB_META"
  printf '%s\n' "$result"
}

experimental_apns_plan() {
  require_experimental
  [[ "$CONFIRM_READ" == true ]] ||
    die "experimental-apns-plan requires --confirm-read after approval to list the team's key metadata"
  [[ -n "$APPLE_ID" ]] || die "experimental-apns-plan requires --apple-id"
  valid_apple_id "$APPLE_TEAM_ID" ||
    die "experimental-apns-plan requires a 10-character --team-id"
  [[ -n "$APP_NAME" ]] || die "experimental-apns-plan requires --name"
  run_private_apns_actor plan \
    --apple-id "$APPLE_ID" \
    --team-id "$APPLE_TEAM_ID" \
    --name "$APP_NAME"
}

experimental_apns_create() {
  require_experimental
  [[ "$CONFIRM" == true ]] ||
    die "experimental-apns-create requires --confirm after reviewing the experimental plan"
  [[ -n "$APPLE_ID" ]] || die "experimental-apns-create requires --apple-id"
  valid_apple_id "$APPLE_TEAM_ID" ||
    die "experimental-apns-create requires a 10-character --team-id"
  [[ -n "$APP_NAME" ]] || die "experimental-apns-create requires --name"
  [[ -n "$OUTPUT_DIR" ]] || die "experimental-apns-create requires --output-dir"

  local result
  result="$(run_private_apns_actor create \
    --apple-id "$APPLE_ID" \
    --team-id "$APPLE_TEAM_ID" \
    --name "$APP_NAME" \
    --output-dir "$OUTPUT_DIR" \
    --confirm)" || exit $?

  APNS_SOURCE="$(node -e '
    const result = JSON.parse(process.argv[1]);
    process.stdout.write(String(result.key_path || ""));
  ' "$result")"
  APNS_KEY_ID="$(node -e '
    const result = JSON.parse(process.argv[1]);
    process.stdout.write(String(result.key_id || ""));
  ' "$result")"
  CONFIRM=true
  import_apns
}

read_args "$@"

case "$COMMAND" in
  status)
    status_json
    ;;
  question)
    [[ -n "$QUESTION_KIND" ]] || die "question requires --kind"
    case "$QUESTION_KIND" in
      confirm_scope)
        [[ -f "$DISCOVERY_META" ]] ||
          die "confirm_scope requires completed selector answers"
        ios_question confirm_scope \
          "$(node -e '
            const v=JSON.parse(require("fs").readFileSync(process.argv[1],"utf8"));
            const map={
              push:"push-notifications",
              events:"event-tracking",
              profiles:"user-profiles",
              "in-app":"in-app-messages",
              inbox:"mobile-inbox",
              embedded:"embedded-messaging",
              "deep-links":"deep-linking"
            };
            const selected=v.features || Object.entries(v.feature_choices || {})
              .filter(([,enabled])=>enabled===true)
              .map(([key])=>map[key])
              .filter(Boolean);
            process.stdout.write(
              [...new Set(["sdk-initialization",...selected])].sort().join(",")
            );
          ' "$DISCOVERY_META")" \
          "$(node -e 'const v=JSON.parse(require("fs").readFileSync(process.argv[1],"utf8"));process.stdout.write(String(v.identity_mode||""))' "$DISCOVERY_META")" \
          "$(node -e 'const v=JSON.parse(require("fs").readFileSync(process.argv[1],"utf8"));process.stdout.write(String(v.data_region||""))' "$DISCOVERY_META")" \
          "$(node -e 'const v=JSON.parse(require("fs").readFileSync(process.argv[1],"utf8"));process.stdout.write(typeof v.jwt_enabled==="boolean"?String(v.jwt_enabled):"")' "$DISCOVERY_META")"
        printf '\n'
        ;;
      choose_features|choose_more_features|choose_identity|choose_region|choose_jwt|choose_apple_setup)
        ios_question "$QUESTION_KIND"
        printf '\n'
        ;;
      help_identity|help_region|help_jwt|help_bundle|help_apns_key|help_proof_identity_type|help_proof_region|help_proof_bundle|help_proof_identity|help_proof_switch_identity|help_proof_identity_start|help_proof_app)
        ios_question "$QUESTION_KIND"
        printf '\n'
        ;;
      help_mobile_key|help_server_key|help_copy_mobile_key|help_copy_server_key|help_iterable_app)
        [[ -f "$SCOPE_META" ]] || die "$QUESTION_KIND requires a confirmed scope"
        help_region="$(node -e 'const v=JSON.parse(require("fs").readFileSync(process.argv[1],"utf8"));process.stdout.write(String(v.data_region||""))' "$SCOPE_META")"
        help_jwt="$(node -e 'const v=JSON.parse(require("fs").readFileSync(process.argv[1],"utf8"));process.stdout.write(String(v.jwt_enabled===true))' "$SCOPE_META")"
        case "$QUESTION_KIND" in
          help_mobile_key) ios_question help_mobile_key "$help_region" "$help_jwt" "$REPLACE" ;;
          help_server_key) ios_question help_server_key "$help_region" "$REPLACE" ;;
          help_copy_mobile_key) ios_question help_copy_mobile_key "$help_region" "$help_jwt" ;;
          help_copy_server_key) ios_question help_copy_server_key "$help_region" ;;
          help_iterable_app)
            [[ -n "$BUNDLE_ID" ]] || die "help_iterable_app requires --bundle-id"
            ios_question help_iterable_app "$BUNDLE_ID" "$APP_NAME" "$help_region"
            ;;
        esac
        printf '\n'
        ;;
      replace_apns_key)
        [[ -f "$APNS_META" ]] || die "replace_apns_key requires an imported APNs key"
        require_ios_next "question replace_apns_key" replace_apns_key
        apns_status="$(status_json)"
        ios_question replace_apns_key \
          "$(node -e 'process.stdout.write(JSON.parse(process.argv[1]).apns.rejection_reason)' "$apns_status")" \
          "$(node -e 'process.stdout.write(String(JSON.parse(require("fs").readFileSync(process.argv[1],"utf8")).key_id||""))' "$APNS_META")" \
          "$(node -e 'process.stdout.write(String(JSON.parse(require("fs").readFileSync(process.argv[1],"utf8")).team_id||""))' "$APNS_META")" \
          "$(node -e 'process.stdout.write(JSON.parse(process.argv[1]).apns.classification)' "$apns_status")" \
          "$BUNDLE_ID"
        printf '\n'
        ;;
      help_apns_replace)
        load_detected_target
        ios_question help_apns_replace "$(detected_field team_id "$BUNDLE_ID")"
        printf '\n'
        ;;
      asc_key|asc_issuer|asc_rejected|asc_conflict|asc_plan|help_asc_key)
        asc_status="$(status_json)"
        ios_question "$QUESTION_KIND" "$BUNDLE_ID" \
          "$(node -e 'process.stdout.write(String(JSON.parse(process.argv[1]).next.summary||""))' "$asc_status")" \
          "$(node -e 'process.stdout.write(String(JSON.parse(process.argv[1]).apple_setup.asc_actions||""))' "$asc_status")" \
          "$(asc_app_name)"
        printf '\n'
        ;;
      help_app_id|help_push)
        [[ -n "$BUNDLE_ID" ]] || die "$QUESTION_KIND requires --bundle-id"
        ios_question "$QUESTION_KIND" "$BUNDLE_ID"
        printf '\n'
        ;;
      help_apns_import)
        load_detected_target
        ios_question help_apns_import "$(detected_field team_id "$BUNDLE_ID")"
        printf '\n'
        ;;
      help_iterable_push)
        [[ -n "$BUNDLE_ID" && -f "$APNS_META" ]] ||
          die "help_iterable_push requires --bundle-id and the recorded APNs key"
        ios_question help_iterable_push "$BUNDLE_ID" \
          "$(node -e 'const v=JSON.parse(require("fs").readFileSync(process.argv[1],"utf8"));process.stdout.write(v.key_path)' "$APNS_META")" \
          "$(node -e 'const v=JSON.parse(require("fs").readFileSync(process.argv[1],"utf8"));process.stdout.write(v.key_id)' "$APNS_META")" \
          "$(node -e 'const v=JSON.parse(require("fs").readFileSync(process.argv[1],"utf8"));process.stdout.write(v.team_id)' "$APNS_META")"
        printf '\n'
        ;;
      check_jwt)
        ios_question check_jwt "$([[ ! -f "$DISCOVERY_META" ]] || node -e '
          const v=JSON.parse(require("fs").readFileSync(process.argv[1],"utf8"));
          process.stdout.write(String(v.data_region||""));
        ' "$DISCOVERY_META")"
        printf '\n'
        ;;
      confirm_existing_apple|confirm_manual_apple|apple_step_app_id|apple_step_push|apple_step_apns_key)
        [[ -n "$BUNDLE_ID" ]] ||
          die "$QUESTION_KIND requires --bundle-id"
        ios_question "$QUESTION_KIND" "$BUNDLE_ID" "$APP_NAME"
        printf '\n'
        ;;
      configure_iterable)
        [[ -f "$SCOPE_META" ]] || die "configure_iterable requires a confirmed scope"
        require_ios_next "question configure_iterable" configure_iterable
        ios_question configure_iterable \
          "$(node -e 'const v=JSON.parse(require("fs").readFileSync(process.argv[1],"utf8"));process.stdout.write(v.data_region)' "$SCOPE_META")" \
          "$(node -e 'const v=JSON.parse(require("fs").readFileSync(process.argv[1],"utf8"));process.stdout.write(String(v.jwt_enabled))' "$SCOPE_META")"
        printf '\n'
        ;;
      capture_iterable)
        [[ -f "$SCOPE_META" ]] || die "capture_iterable requires a confirmed scope"
        require_ios_next "question capture_iterable" configure_iterable capture_iterable
        ios_question capture_iterable \
          "$(node -e 'const v=JSON.parse(require("fs").readFileSync(process.argv[1],"utf8"));process.stdout.write(v.data_region)' "$SCOPE_META")" \
          "$(node -e 'const v=JSON.parse(require("fs").readFileSync(process.argv[1],"utf8"));process.stdout.write(String(v.jwt_enabled))' "$SCOPE_META")"
        printf '\n'
        ;;
      replace_mobile_key)
        [[ -f "$SCOPE_META" ]] || die "replace_mobile_key requires a confirmed scope"
        require_ios_next "question replace_mobile_key" replace_mobile_key
        ios_question replace_mobile_key \
          "$(node -e 'const v=JSON.parse(require("fs").readFileSync(process.argv[1],"utf8"));process.stdout.write(v.data_region)' "$SCOPE_META")" \
          "$(node -e 'const v=JSON.parse(require("fs").readFileSync(process.argv[1],"utf8"));process.stdout.write(String(v.jwt_enabled))' "$SCOPE_META")" \
          "$(status_json | node -e 'let s="";process.stdin.on("data",d=>s+=d).on("end",()=>process.stdout.write(JSON.parse(s).iterable.mobile_rejection_reason))')"
        printf '\n'
        ;;
      replace_server_key)
        [[ -f "$SCOPE_META" ]] || die "replace_server_key requires a confirmed scope"
        require_ios_next "question replace_server_key" replace_server_key
        ios_question replace_server_key \
          "$(node -e 'const v=JSON.parse(require("fs").readFileSync(process.argv[1],"utf8"));process.stdout.write(v.data_region)' "$SCOPE_META")" \
          "$(status_json | node -e 'let s="";process.stdin.on("data",d=>s+=d).on("end",()=>process.stdout.write(JSON.parse(s).iterable.server_rejection_reason))')"
        printf '\n'
        ;;
      configure_server)
        [[ -f "$SCOPE_META" ]] || die "configure_server requires a confirmed scope"
        require_ios_next "question configure_server" configure_server
        ios_question configure_server \
          "$(node -e 'const v=JSON.parse(require("fs").readFileSync(process.argv[1],"utf8"));process.stdout.write(v.data_region)' "$SCOPE_META")" \
          "$(node -e 'const v=JSON.parse(require("fs").readFileSync(process.argv[1],"utf8"));process.stdout.write(String(v.verification_only===true))' "$SCOPE_META")"
        printf '\n'
        ;;
      install_tools)
        ios_question install_tools "$(missing_tools)"
        printf '\n'
        ;;
      choose_bundle)
        load_detected_target
        detected_bundle="${BUNDLE_ID:-$(detected_field bundle_id)}"
        ios_question choose_bundle "$detected_bundle" \
          "$(detected_field name "$detected_bundle")" "$(detected_field source)"
        printf '\n'
        ;;
      import_apns)
        load_detected_target
        ios_question import_apns "$(detected_field team_id "$BUNDLE_ID")"
        printf '\n'
        ;;
      configure_iterable_app)
        [[ -n "$BUNDLE_ID" ]] || die "configure_iterable_app requires --bundle-id"
        [[ -f "$SCOPE_META" && -f "$TARGET_META" ]] ||
          die "configure_iterable_app requires the recorded scope and target"
        require_ios_next "question configure_iterable_app" configure_iterable_app
        ios_question configure_iterable_app \
          "$BUNDLE_ID" \
          "$(node -e 'const v=JSON.parse(require("fs").readFileSync(process.argv[1],"utf8"));process.stdout.write(v.name)' "$TARGET_META")" \
          "$(node -e 'const v=JSON.parse(require("fs").readFileSync(process.argv[1],"utf8"));process.stdout.write(v.data_region)' "$SCOPE_META")"
        printf '\n'
        ;;
      configure_iterable_push)
        [[ -n "$BUNDLE_ID" ]] || die "configure_iterable_push requires --bundle-id"
        [[ -f "$SCOPE_META" && -f "$APNS_META" ]] ||
          die "configure_iterable_push requires the recorded scope and APNs key"
        require_ios_next "question configure_iterable_push" configure_iterable_push
        ios_question configure_iterable_push \
          "$BUNDLE_ID" \
          "$(node -e 'const v=JSON.parse(require("fs").readFileSync(process.argv[1],"utf8"));process.stdout.write(v.data_region)' "$SCOPE_META")" \
          "$(node -e 'const v=JSON.parse(require("fs").readFileSync(process.argv[1],"utf8"));process.stdout.write(v.key_path)' "$APNS_META")" \
          "$(node -e 'const v=JSON.parse(require("fs").readFileSync(process.argv[1],"utf8"));process.stdout.write(v.key_id)' "$APNS_META")" \
          "$(node -e 'const v=JSON.parse(require("fs").readFileSync(process.argv[1],"utf8"));process.stdout.write(v.team_id)' "$APNS_META")"
        printf '\n'
        ;;
      *)
        die "unknown iOS question kind: $QUESTION_KIND"
        ;;
    esac
    ;;
  answer)
    answer_scope
    ;;
  record-scope)
    record_scope
    ;;
  record-iterable-setup)
    record_iterable_setup
    ;;
  record-target)
    record_target
    ;;
  record-apple-setup)
    record_apple_setup
    ;;
  clear-apple-setup)
    clear_apple_setup
    ;;
  record-apple-readiness)
    record_apple_readiness
    ;;
  record-apple-step)
    record_apple_step
    ;;
  record-iterable-app)
    record_iterable_app
    ;;
  record-iterable-push)
    record_iterable_push
    ;;
  import-apns)
    import_apns
    ;;
  capture-mobile)
    capture_mobile
    ;;
  validate-mobile)
    validate_mobile
    ;;
  capture-server)
    capture_server
    ;;
  validate-server)
    validate_server
    ;;
  record-asc-key)
    record_asc_key
    ;;
  asc-read)
    asc_read
    ;;
  asc-apply)
    asc_apply
    ;;
  validate-apns)
    validate_apns
    ;;
  proof-status)
    proof_status_json
    ;;
  proof-answer)
    proof_answer
    ;;
  record-proof)
    record_proof
    ;;
  restart-proof)
    restart_proof
    ;;
  experimental-apns-install)
    experimental_apns_install
    ;;
  experimental-apns-auth)
    experimental_apns_auth
    ;;
  experimental-apns-plan)
    experimental_apns_plan
    ;;
  experimental-apns-create)
    experimental_apns_create
    ;;
  *)
    usage >&2
    exit 2
    ;;
esac

#!/usr/bin/env bash
# Small device actor for proof-target-owned iOS Simulator lifecycle work.

set -uo pipefail

BIN="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
TOOL_ROOT="$(cd "$BIN/.." && pwd)"

usage() {
  cat <<'EOF'
Usage:
  ios-device boot [--workspace PATH]

Boots the exact Simulator recorded in proof-target.json and waits until it is
ready. It does not select a different target, install the app, or operate UI.
EOF
}

die() {
  printf 'error: %s\n' "$*" >&2
  exit 30
}

COMMAND="${1:-}"
shift || true
WORKSPACE_OVERRIDE=""
while (($#)); do
  case "$1" in
    --workspace)
      (($# >= 2)) || die "--workspace needs a value"
      WORKSPACE_OVERRIDE="$2"
      shift 2
      ;;
    --workspace=*)
      WORKSPACE_OVERRIDE="${1#*=}"
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      die "unknown option: $1"
      ;;
  esac
done
[[ "$COMMAND" == boot ]] || {
  usage >&2
  exit 30
}

if [[ -n "$WORKSPACE_OVERRIDE" ]]; then
  WORKSPACE="$WORKSPACE_OVERRIDE"
elif [[ -n "${IOS_WORKSPACE:-}" ]]; then
  WORKSPACE="$IOS_WORKSPACE"
else
  project_root="$(git rev-parse --show-toplevel 2>/dev/null)" || project_root="$PWD"
  [[ "$project_root" != "$TOOL_ROOT" ]] ||
    die "run this from the iOS app being proved, not from the skill repository"
  WORKSPACE="$project_root/.iterable/ios"
fi

TARGET="$WORKSPACE/proof-target.json"
[[ -f "$TARGET" ]] || die "record the proof target first"
DEVICE_ID="$(node -e '
  const v=JSON.parse(require("fs").readFileSync(process.argv[1],"utf8"));
  process.stdout.write(String(v.device||""));
' "$TARGET")"
DEVICE_KIND="$(node -e '
  const v=JSON.parse(require("fs").readFileSync(process.argv[1],"utf8"));
  process.stdout.write(String(v.device_kind||""));
' "$TARGET")"
[[ -n "$DEVICE_ID" && "$DEVICE_KIND" == simulator ]] ||
  die "the proof target does not name a Simulator"
command -v xcrun >/dev/null 2>&1 || die "xcrun is not installed"

simulators="$(xcrun simctl list devices --json 2>/dev/null)" ||
  die "CoreSimulator could not list devices"
printf '%s' "$simulators" | node -e '
  let input="";
  process.stdin.on("data",c=>input+=c).on("end",()=>{
    let v; try { v=JSON.parse(input) } catch { process.exit(1) }
    const wanted=process.argv[1];
    const devices=Object.values(v.devices||{}).flat();
    process.exit(devices.some(d=>d.udid===wanted && d.isAvailable!==false) ? 0 : 1);
  });
' "$DEVICE_ID" || die "the recorded Simulator no longer exists or is unavailable"

if ! printf '%s' "$simulators" | node -e '
  let input="";
  process.stdin.on("data",c=>input+=c).on("end",()=>{
    const v=JSON.parse(input), wanted=process.argv[1];
    const devices=Object.values(v.devices||{}).flat();
    process.exit(devices.some(d=>d.udid===wanted && d.state==="Booted") ? 0 : 1);
  });
' "$DEVICE_ID"; then
  xcrun simctl boot "$DEVICE_ID" >/dev/null 2>&1 ||
    die "CoreSimulator could not boot the recorded Simulator"
fi
xcrun simctl bootstatus "$DEVICE_ID" -b >/dev/null 2>&1 ||
  die "the recorded Simulator did not become ready"
printf 'Booted the recorded Simulator %s. Re-run ios-verify status.\n' "$DEVICE_ID"

#!/usr/bin/env bash
# Sender actor for native iOS proof.
#
# This actor sends targeted proof messages through Iterable's public API and
# records exactly what it sent. The optional record-direct
# command records a dashboard diagnostic without claiming delivery.
# ios-observe and ios-verify remain separate readers.

set -uo pipefail

BIN="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
TOOL_ROOT="$(cd "$BIN/.." && pwd)"
source "$BIN/ios-project.sh"

usage() {
  cat <<'EOF'
Usage:
  ios-send target --recipient initial|switch --confirm [--workspace PATH]
  ios-send record-direct --confirm [--workspace PATH]

Run from the iOS app being proved. `target` creates or updates one proof
template carrying the tool-generated marker and sends it to the exact identity
recorded in proof-target.json. The `switch` recipient exists only for an
instrumented account-isolation benchmark. `record-direct` is an optional
troubleshooting command used only after a developer sends Iterable's dashboard
Test Push with the exact recorded direct marker. It is not part of normal
verification. A targeted send requires a fresh purpose-scoped SpringBoard
inspection and records a non-repeatable intent before the delivery request.
This actor never decides whether a notification arrived.
EOF
}

die() {
  printf 'error: %s\n' "$*" >&2
  exit 30
}

jstr() {
  node -e 'process.stdout.write(JSON.stringify(process.argv[1]))' -- "$1"
}

file_mode() {
  stat -f '%Lp' "$1" 2>/dev/null || stat -c '%a' "$1" 2>/dev/null
}

COMMAND="${1:-}"
shift || true
RECIPIENT=""
CONFIRM=false
WORKSPACE_OVERRIDE=""
while (($#)); do
  case "$1" in
    --recipient)
      (($# >= 2)) || die "--recipient needs a value"
      RECIPIENT="$2"
      shift 2
      ;;
    --recipient=*)
      RECIPIENT="${1#*=}"
      shift
      ;;
    --confirm)
      CONFIRM=true
      shift
      ;;
    --workspace)
      (($# >= 2)) || die "--workspace needs a value"
      WORKSPACE_OVERRIDE="$2"
      shift 2
      ;;
    --workspace=*)
      WORKSPACE_OVERRIDE="${1#*=}"
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      die "unknown option: $1"
      ;;
  esac
done

if [[ -n "$WORKSPACE_OVERRIDE" ]]; then
  WORKSPACE="$WORKSPACE_OVERRIDE"
elif [[ -n "${IOS_WORKSPACE:-}" ]]; then
  WORKSPACE="$IOS_WORKSPACE"
else
  project_root="$(ios_project_app_root "$PWD")" || project_root="$PWD"
  [[ "$project_root" != "$TOOL_ROOT" ]] ||
    die "run this from the iOS app being proved, not from the skill repository"
  WORKSPACE="$project_root/.iterable/ios"
fi

TARGET="$WORKSPACE/proof-target.json"
ENV_FILE="$WORKSPACE/.env"
SCOPE_FILE="$WORKSPACE/scope.json"
[[ -f "$TARGET" && "$(file_mode "$TARGET")" == 600 ]] ||
  die "record a mode-0600 proof target first"
[[ -f "$ENV_FILE" && "$(file_mode "$ENV_FILE")" == 600 ]] ||
  die "capture the Server-side key securely before sending proof"

read_target() {
  node -e '
    const v=JSON.parse(require("fs").readFileSync(process.argv[1],"utf8"));
    const path=process.argv[2].split(".");
    let value=v;
    for (const key of path) value=value?.[key];
    process.stdout.write(value == null ? "" : String(value));
  ' "$TARGET" "$1"
}

IDENTITY_TYPE="$(read_target identity_type)"
PROOF_MODE="$(read_target proof_mode)"
[[ -n "$PROOF_MODE" ]] || PROOF_MODE=behavioral
INITIAL_IDENTITY="$(read_target identity)"
SWITCH_IDENTITY="$(read_target switch_identity)"
BUNDLE_ID="$(read_target bundle_id)"
DEVICE_ID="$(read_target device)"
DEVICE_KIND="$(read_target device_kind)"
ENVIRONMENT="$(read_target environment)"
RUN_ID="$(read_target run_id)"
DIRECT_MARKER="$(read_target markers.direct)"
TARGETED_MARKER="$(read_target markers.user_targeted)"
SWITCH_MARKER="$(read_target markers.user_targeted_switch)"
STARTED_AT="$(read_target started_at)"
REGION="$(sed -n 's/^ITERABLE_DATA_REGION=//p' "$ENV_FILE" | head -1)"
if [[ -z "$REGION" && -f "$SCOPE_FILE" ]]; then
  REGION="$(node -e '
    const v=JSON.parse(require("fs").readFileSync(process.argv[1],"utf8"));
    process.stdout.write(String(v.data_region||""));
  ' "$SCOPE_FILE" 2>/dev/null)"
fi
SERVER_KEY="$(sed -n 's/^ITERABLE_SERVER_KEY=//p' "$ENV_FILE" | head -1)"

[[ "$IDENTITY_TYPE" == email || "$IDENTITY_TYPE" == user-id ]] ||
  die "the proof target has no supported identity type"
[[ -n "$INITIAL_IDENTITY" && -n "$BUNDLE_ID" &&
    -n "$DEVICE_ID" && -n "$RUN_ID" && -n "$STARTED_AT" ]] ||
  die "the proof target is incomplete"
[[ "$DEVICE_KIND" == simulator || "$DEVICE_KIND" == physical ]] ||
  die "the proof target has no valid device kind"
[[ "$REGION" == US || "$REGION" == EU ]] ||
  die "the credential file has no valid Iterable region"
[[ -n "$SERVER_KEY" ]] || die "no Server-side key was captured"

[[ "$REGION" == EU ]] &&
  BASE="https://api.eu.iterable.com" ||
  BASE="https://api.iterable.com"

secret_request() {
  local method="$1" path="$2" data="${3:-}" escaped_key escaped_data output
  escaped_key="${SERVER_KEY//\\/\\\\}"
  escaped_key="${escaped_key//\"/\\\"}"
  escaped_data="${data//\\/\\\\}"
  escaped_data="${escaped_data//\"/\\\"}"
  output="$(
    {
      printf 'header = "Api-Key: %s"\n' "$escaped_key"
      printf 'url = "%s%s"\n' "$BASE" "$path"
      printf 'request = "%s"\n' "$method"
      if [[ "$method" == POST ]]; then
        printf 'header = "Content-Type: application/json"\n'
        printf 'data = "%s"\n' "$escaped_data"
      fi
    } | curl -K - -sS -w $'\n%{http_code}' 2>&1
  )" || true
  HTTP_CODE="${output##*$'\n'}"
  HTTP_BODY="${output%$'\n'*}"
}

write_manifest() {
  local kind="$1" source="$2" marker="$3" identity="$4" template_id="${5:-}"
  local nonce_hash="${6:-}" payload_hash="${7:-}"
  local directory="$WORKSPACE/sends/$ENVIRONMENT"
  local file="$directory/$kind.json"
  local marker_hash identity_hash
  marker_hash="$(printf '%s' "$marker" | shasum -a 256 | awk '{print $1}')"
  identity_hash="$(printf '%s' "$identity" | shasum -a 256 | awk '{print $1}')"
  mkdir -p "$directory"
  chmod 700 "$WORKSPACE/sends" "$directory"
  [[ ! -e "$file" ]] ||
    die "a $kind send is already recorded for this proof run; start a new run instead of overwriting evidence"
  (
    umask 077
    node -e '
      const fs=require("fs");
      const value={
        contract:2,
        sent:true,
        kind:process.argv[2],
        source:process.argv[3],
        bundle_id:process.argv[4],
        device:process.argv[5],
        device_kind:process.argv[6],
        environment:process.argv[7],
        run_id:process.argv[8],
        marker_sha256:process.argv[9],
        recipient_sha256:process.argv[10],
        sent_at:new Date().toISOString()
      };
      if (process.argv[11]) value.template_id=Number(process.argv[11]);
      if (process.argv[12]) value.delivery_nonce_sha256=process.argv[12];
      if (process.argv[13]) value.payload_sha256=process.argv[13];
      fs.writeFileSync(process.argv[1],JSON.stringify(value,null,2)+"\n",{mode:0o600});
    ' "$file" "$kind" "$source" "$BUNDLE_ID" "$DEVICE_ID" "$DEVICE_KIND" \
      "$ENVIRONMENT" "$RUN_ID" "$marker_hash" "$identity_hash" "$template_id" \
      "$nonce_hash" "$payload_hash"
  )
  chmod 600 "$file"
  printf '%s' "$file"
}

require_delivery_prepared() {
  local purpose="$1"
  local receipt="$WORKSPACE/observations/current-notifications-$purpose.json"
  [[ -f "$receipt" && "$(file_mode "$receipt")" == 600 ]] ||
    die "prepare SpringBoard immediately before this send with ios-observe inspect --kind notifications --purpose $purpose"
  node -e '
    const fs=require("fs");
    const value=JSON.parse(fs.readFileSync(process.argv[1],"utf8"));
    const [purpose,bundle,device,runId,start]=process.argv.slice(2);
    const observed=Date.parse(value.observed_at);
    const valid=value.inspected===true &&
      value.non_interactive===true &&
      value.may_foreground_target===true &&
      value.kind==="notifications" &&
      value.purpose===purpose &&
      value.classification==="springboard_visible" &&
      value.bundle_id===bundle &&
      value.device===device &&
      value.run_id===runId &&
      !Number.isNaN(observed) &&
      observed>=Date.parse(start) &&
      observed>=Date.now()-2*60*1000 &&
      observed<=Date.now()+5*60*1000;
    process.exit(valid ? 0 : 1);
  ' "$receipt" "$purpose" "$BUNDLE_ID" "$DEVICE_ID" "$RUN_ID" "$STARTED_AT" ||
    die "the SpringBoard preparation is stale or does not match this proof run; inspect it again before sending"
}

write_send_intent() {
  local kind="$1" marker="$2" identity="$3" template_id="$4"
  local nonce_hash="$5" payload_hash="$6"
  local directory="$WORKSPACE/sends/$ENVIRONMENT"
  local file="$directory/$kind.json"
  local marker_hash identity_hash
  marker_hash="$(printf '%s' "$marker" | shasum -a 256 | awk '{print $1}')"
  identity_hash="$(printf '%s' "$identity" | shasum -a 256 | awk '{print $1}')"
  mkdir -p "$directory"
  chmod 700 "$WORKSPACE/sends" "$directory"
  [[ ! -e "$file" ]] ||
    die "a $kind send attempt already exists for this proof run; restart proof instead of risking a duplicate send"
  (
    umask 077
    node -e '
      const fs=require("fs");
      const value={
        contract:3,
        state:"prepared",
        sent:false,
        kind:process.argv[2],
        source:"iterable-api-template-proof",
        bundle_id:process.argv[3],
        device:process.argv[4],
        device_kind:process.argv[5],
        environment:process.argv[6],
        run_id:process.argv[7],
        marker_sha256:process.argv[8],
        recipient_sha256:process.argv[9],
        template_id:Number(process.argv[10]),
        delivery_nonce_sha256:process.argv[11],
        payload_sha256:process.argv[12],
        prepared_at:new Date().toISOString()
      };
      fs.writeFileSync(process.argv[1],JSON.stringify(value,null,2)+"\n",{mode:0o600});
    ' "$file" "$kind" "$BUNDLE_ID" "$DEVICE_ID" "$DEVICE_KIND" \
      "$ENVIRONMENT" "$RUN_ID" "$marker_hash" "$identity_hash" "$template_id" \
      "$nonce_hash" "$payload_hash"
  )
  chmod 600 "$file"
  printf '%s' "$file"
}

finalize_send_intent() {
  local file="$1" candidate
  candidate="$(mktemp "$WORKSPACE/sends/$ENVIRONMENT/.send-manifest.XXXXXX")" ||
    die "could not create a secure send-manifest candidate"
  chmod 600 "$candidate"
  node -e '
    const fs=require("fs");
    const value=JSON.parse(fs.readFileSync(process.argv[1],"utf8"));
    if (value.contract!==3 || value.state!=="prepared" || value.sent!==false) {
      process.exit(2);
    }
    value.state="sent";
    value.sent=true;
    value.sent_at=new Date().toISOString();
    fs.writeFileSync(process.argv[2],JSON.stringify(value,null,2)+"\n",{mode:0o600});
  ' "$file" "$candidate" || {
    rm -f "$candidate"
    die "the prepared send intent could not be finalized safely"
  }
  mv -f "$candidate" "$file" ||
    die "the completed send manifest could not be activated"
  chmod 600 "$file"
}

case "$COMMAND" in
  record-direct)
    [[ "$CONFIRM" == true ]] ||
      die "record-direct requires --confirm after the browser operator sends the exact direct marker"
    [[ -n "$DIRECT_MARKER" ]] || die "the proof target has no direct marker"
    manifest="$(write_manifest direct iterable-dashboard-test-push \
      "$DIRECT_MARKER" "$INITIAL_IDENTITY")"
    printf 'Recorded the announced Iterable direct Test Push at %s. Delivery remains unproved.\n' \
      "$manifest"
    ;;
  target)
    [[ "$CONFIRM" == true ]] ||
      die "target requires --confirm after announcing the exact recipient and generated marker"
    case "$RECIPIENT" in
      initial)
        identity="$INITIAL_IDENTITY"
        marker="$TARGETED_MARKER"
        kind="user-targeted"
        preparation_purpose="pre-send"
        ;;
      switch)
        [[ "$PROOF_MODE" == instrumented && -n "$SWITCH_IDENTITY" ]] ||
          die "User B proof sends are available only for an instrumented evaluation run"
        identity="$SWITCH_IDENTITY"
        marker="$SWITCH_MARKER"
        kind="user-targeted-switch"
        preparation_purpose="pre-send-switch"
        ;;
      *)
        die "target requires --recipient initial or switch"
        ;;
    esac
    [[ -n "$marker" ]] || die "the proof target has no marker for $RECIPIENT"
    require_delivery_prepared "$preparation_purpose"
    [[ ! -e "$WORKSPACE/sends/$ENVIRONMENT/$kind.json" ]] ||
      die "a $kind send attempt already exists for this proof run; start a new run instead of risking a duplicate send"
    client_template_id="itbl-ios-proof-$(printf '%s' "$RUN_ID-$RECIPIENT" |
      tr -cd '[:alnum:]-' | cut -c1-80)"
    delivery_nonce="$(node -e '
      process.stdout.write(require("crypto").randomBytes(32).toString("hex"))
    ')"
    nonce_hash="$(printf '%s' "$delivery_nonce" | shasum -a 256 | awk '{print $1}')"
    body="$(node -e '
      const [clientTemplateId,marker,nonce,identityKind,identity]=process.argv.slice(1);
      const recipientField=identityKind==="email"
        ? "recipientEmail"
        : "recipientUserId";
      process.stdout.write(JSON.stringify({
        clientTemplateId,
        name:`Iterable iOS proof ${marker}`,
        title:"Iterable iOS proof",
        message:marker,
        payload:{
          iterableProofMarker:marker,
          iterableProofNonce:nonce,
          [recipientField]:identity
        }
      }));
    ' "$client_template_id" "$marker" "$delivery_nonce" "$IDENTITY_TYPE" "$identity")"
    payload_hash="$(printf '%s' "$body" | shasum -a 256 | awk '{print $1}')"
    secret_request POST /api/templates/push/upsert "$body"
    [[ "$HTTP_CODE" == 200 ]] ||
      die "Iterable push proof template upsert failed (HTTP $HTTP_CODE)"
    template_id="$(printf '%s' "$HTTP_BODY" |
      sed -n 's/.*IDs: *\([0-9][0-9]*\).*/\1/p' | head -1)"
    [[ "$template_id" =~ ^[0-9]+$ ]] ||
      die "Iterable did not return the proof template ID"
    manifest="$(write_send_intent "$kind" "$marker" "$identity" "$template_id" \
      "$nonce_hash" "$payload_hash")"
    if [[ "$IDENTITY_TYPE" == email ]]; then
      recipient_field=recipientEmail
    else
      recipient_field=recipientUserId
    fi
    body="$(node -e '
      const [templateId,field,identity]=process.argv.slice(1);
      process.stdout.write(JSON.stringify({
        templateId:Number(templateId),
        [field]:identity
      }));
    ' "$template_id" "$recipient_field" "$identity")"
    secret_request POST /api/templates/push/proof "$body"
    [[ "$HTTP_CODE" == 200 ]] || {
      unset SERVER_KEY identity delivery_nonce
      die "the Iterable send response was not a confirmed success (HTTP $HTTP_CODE); the prepared intent was retained, so this run will not resend and risk a duplicate"
    }
    finalize_send_intent "$manifest"
    unset SERVER_KEY identity delivery_nonce
    printf 'Sent the exact %s marker through Iterable and recorded the send at %s. Arrival remains the verifier'\''s decision.\n' \
      "$RECIPIENT" "$manifest"
    ;;
  *)
    usage >&2
    exit 30
    ;;
esac
